---
/**
 * Links from a pillar page down to the best posts in its topic, so the
 * pillar-to-post links mirror the post-to-pillar links the posts already carry.
 */
import Icon from './Icon.astro';
import Rule from './page/Rule.astro';

interface Item {
  href: string;
  title: string;
  kicker?: string;
}
interface Props {
  title?: string;
  items: Item[];
}
const { title = 'From the blog', items } = Astro.props;
---
<Rule />
<section class="container-page py-20 md:py-24">
  <div class="flex items-end justify-between gap-4">
    <h2 class="text-[26px] md:text-[34px] font-medium tracking-[-0.035em] leading-[1.1] text-slate-900">{title}</h2>
    <a href="/blog/" class="hidden sm:inline-flex shrink-0 items-center gap-1.5 text-[14px] font-medium text-slate-600 hover:text-slate-900">
      All posts <Icon name="arrowRight" size={12} />
    </a>
  </div>
  <div class="mt-8 grid gap-3 sm:grid-cols-3">
    {items.map((it) => (
      <a href={it.href} class="group flex min-h-[148px] flex-col rounded-[6px] bg-white p-6 ring-1 ring-slate-200 transition-colors hover:ring-slate-300">
        {it.kicker && <div class="text-[13px] text-slate-400">{it.kicker}</div>}
        <div class="mt-1.5 text-[16px] font-medium leading-snug text-slate-900">{it.title}</div>
        <div class="mt-auto inline-flex items-center gap-1 pt-5 text-[13px] text-slate-500 transition-colors group-hover:text-slate-900">
          Read the post <Icon name="arrowRight" size={11} class="transition-transform group-hover:translate-x-0.5" />
        </div>
      </a>
    ))}
  </div>
</section>
