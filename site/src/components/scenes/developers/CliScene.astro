---
import ScaledStage from '../../ScaledStage.astro';
import Glyph from '../Glyph.astro';
import { WINDOW, FLOAT, EYEBROW } from '../../../lib/scene';

/**
 * The warmbly CLI (docs/content/docs/api/cli.mdx): a browser sign-in, the
 * campaign list as the table it prints on a terminal (cmd/cli/specs.go
 * columns), and the confirmation every real send asks for. The approval
 * page (web/src/app/cli/page.tsx) sits over the terminal.
 */
type Line = { t: string; c?: string; k?: 'cmd' | 'ok' | 'wait' | 'head' | 'warn' };
const lines: Line[] = [
  { t: 'warmbly auth login', k: 'cmd' },
  { t: '  Your code: K4TM-9RQD', c: 'text-slate-700' },
  { t: '  Approve at: https://app.warmbly.com/cli?code=K4TM-9RQD', c: 'text-slate-500' },
  { t: 'Waiting for approval (the code expires in 10 minutes)', k: 'wait' },
  { t: 'Signed in to warmbly.com as jane@example.com', k: 'ok' },
  { t: '  Workspace Acme', c: 'text-slate-500' },
  { t: '' },
  { t: 'warmbly campaign list', k: 'cmd' },
  { t: 'ID                                    NAME           STATUS  DAILY  CREATED', k: 'head' },
  { t: '4c1d7a90-2f3b-4e8a-9d61-0b5e7f2c3a18  Q3 outbound    active  40     3d ago', c: 'text-slate-800' },
  { t: 'b9e2f6c1-7a43-4d0e-8c25-1f6a9b3d7e02  Agencies, EU   active  50     12d ago', c: 'text-slate-800' },
  { t: '0d5a3e8f-96b1-4c7a-a2e4-7b8c1d9f6a35  Founders list  paused  30     21d ago', c: 'text-slate-800' },
  { t: '' },
  { t: 'warmbly campaign start 0d5a3e8f…', k: 'cmd' },
  { t: '`warmbly campaign start` sends real mail. Continue? [y/N]', k: 'warn' },
];
const scopes = ['Read campaigns', 'Write campaigns', 'Read contacts', 'Read unibox', 'Send campaigns'];
---
<ScaledStage w={680} h={510} photo="frost-blue">
  <div class={`${WINDOW} left-[30px] top-[44px] w-[680px] h-[480px]`}>
    <div class="h-10 px-4 border-b border-slate-200 flex items-center gap-2 text-[12px] text-slate-500">
      <Glyph name="terminal" size={13} class="text-slate-400" />
      zsh · ~/acme
    </div>
    <div class="px-5 py-3 font-mono text-[10.5px] leading-[20px] [&_span]:whitespace-pre">
      {lines.map((l, i) => (
        <div class="enter-fade" style={`--d:${200 + i * 260}ms`}>
          {l.k === 'cmd' ? <><span class="text-slate-400">$ </span><span class="text-slate-900">{l.t}</span></>
            : l.k === 'ok' ? <><span class="text-emerald-500">✓ </span><span class="text-slate-900">{l.t}</span></>
            : l.k === 'wait' ? <><span class="text-sky-500">… </span><span class="text-slate-500">{l.t}</span></>
            : l.k === 'warn' ? <><span class="text-amber-500">! </span><span class="text-slate-800">{l.t} </span><span class="cli-caret inline-block h-[13px] w-[7px] translate-y-[2px] bg-slate-800"></span></>
            : l.k === 'head' ? <span class="text-slate-400">{l.t}</span>
            : <span class={l.c}>{l.t || ' '}</span>}
        </div>
      ))}
    </div>
  </div>

  <!-- The browser half of auth login: the code matches, and the scopes are shown. -->
  <div class="enter-fade absolute left-[436px] top-[18px] w-[226px]" style="--d:900ms">
    <div class="float-layer overflow-hidden rounded-[10px] bg-white ring-1 ring-slate-900/[0.07] shadow-[0_24px_60px_-26px_rgba(15,23,42,0.5)]">
      <div class="px-3.5 pt-3.5">
        <div class="text-[14px] font-semibold tracking-[-0.02em] text-slate-900">Authorize this terminal</div>
        <div class="mt-2.5 flex items-center gap-2.5 rounded-lg border border-slate-200 bg-gradient-to-b from-sky-50/60 to-white px-2.5 py-2">
          <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-md bg-slate-900 text-white"><Glyph name="terminal" size={13} /></span>
          <div class="min-w-0 flex-1">
            <div class="truncate text-[11.5px] font-semibold text-slate-900">Warmbly CLI</div>
            <div class="truncate text-[10px] text-slate-500">jane-macbook</div>
          </div>
          <span class="font-mono text-[9.5px] tracking-[0.14em] text-slate-400">K4TM-9RQD</span>
        </div>
        <div class={`mt-3 ${EYEBROW}`}>This terminal will be able to</div>
        <div class="mt-1.5 flex flex-wrap gap-1">
          {scopes.map((s) => <span class="inline-flex h-5 items-center rounded-md bg-slate-100 px-1.5 text-[10px] text-slate-700">{s}</span>)}
        </div>
      </div>
      <div class="mt-3 flex items-center gap-1.5 border-t border-slate-100 px-3.5 py-2.5">
        <span class="h-7 px-2 rounded-md border border-slate-200 inline-flex items-center gap-1 text-[11px] text-slate-700"><Glyph name="x" size={11} />Decline</span>
        <span class="h-7 flex-1 rounded-md bg-sky-600 inline-flex items-center justify-center gap-1 text-[11px] font-medium text-white"><Glyph name="check" size={11} />Authorize terminal</span>
      </div>
    </div>
  </div>
</ScaledStage>

<style>
  .cli-caret { animation: cli-blink 1s step-end infinite; }
  @keyframes cli-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
</style>
