---
import ScaledStage from '../../../ScaledStage.astro';
import Glyph from '../../Glyph.astro';
import { WINDOW, FLOAT, EYEBROW } from '../../../../lib/scene';
import { AVATAR } from '../ui';

/**
 * A partner's reply in the inbox, labelled Interested, with the deck going
 * back in the same thread. The card is the contact panel beside the thread
 * (unibox/ContactContextPanel.tsx): replied, and the sequence has ended.
 */
---
<ScaledStage w={760} h={570} photo="paint-teal">
  <div class={`${WINDOW} left-[40px] top-[40px] w-[760px] h-[560px]`}>
    <div class="min-h-12 px-5 py-2 border-b border-slate-200 flex items-center gap-3">
      <div class="min-w-0 flex-1">
        <div class="truncate text-[13.5px] font-semibold leading-5 text-slate-900">Re: Hafen Capital &lt;&gt; Atlas</div>
        <div class="flex items-center gap-1.5 text-[11px] leading-4 text-slate-400">
          <span>3 messages</span><span class="text-slate-300">·</span><span>jamie@go.atlas.dev</span>
          <span class="ml-1 inline-flex h-4 items-center gap-1 rounded px-1 text-[10px] font-medium text-emerald-600" style="background-color:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.25);"><span class="size-1.5 rounded-full bg-emerald-500"></span>Interested</span>
        </div>
      </div>
      <span class="inline-flex size-7 items-center justify-center rounded-md text-slate-500"><Glyph name="tag" size={15} /></span>
      <span class="mr-8 inline-flex size-7 items-center justify-center rounded-md text-slate-500"><Glyph name="archive" size={15} /></span>
    </div>
    <div class="w-[470px]">
      <article class="px-5 py-2.5 flex items-start gap-3 border-b border-slate-100">
        <span class={`${AVATAR} size-7 text-[10.5px]`}>JR</span>
        <div class="min-w-0 flex-1">
          <div class="text-[12.5px] font-semibold text-slate-900">Jamie Rivera</div>
          <div class="truncate text-[12px] text-slate-500">Hi Anna, saw Hafen leads a lot of seed developer-tools rounds…</div>
        </div>
        <span class="text-[11px] text-slate-400">Tue</span>
      </article>
      <article class="px-5 py-4 border-b border-slate-100">
        <div class="flex items-start gap-3">
          <span class={`${AVATAR} size-7 text-[10.5px]`}>AK</span>
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline gap-2"><span class="text-[12.5px] font-semibold text-slate-900">Anna Keller</span><span class="text-[11px] text-slate-400">anna@hafen.de</span></div>
            <div class="mt-0.5 text-[11px] text-slate-400">to jamie@go.atlas.dev</div>
          </div>
          <span class="text-[11px] text-slate-400">2h</span>
        </div>
        <div class="mt-3 pl-10 text-[13px] leading-[1.6] text-slate-800">Interesting numbers for 14 weeks. Can you send the deck and a few lines on the team? Happy to find 30 minutes next week.</div>
      </article>
      <div class="mx-5 mt-3 rounded-lg ring-1 ring-sky-300">
        <div class="px-3.5 pt-3 h-[84px] text-[13px] leading-[1.6] text-slate-800">Thanks Anna, here is the deck: atlas.dev/deck. Tuesday or Thursday afternoon your time both work.<span class="pr-caret ml-px inline-block h-4 w-px translate-y-[3px] bg-sky-500"></span></div>
        <div class="flex items-center justify-between border-t border-slate-100 px-3 py-2">
          <span class="inline-flex items-center gap-1.5 text-[11px] text-slate-400"><Glyph name="reply" size={12} />Reply as jamie@go.atlas.dev</span>
          <span class="h-7 px-3 rounded-md bg-sky-600 text-white text-[12px] font-medium inline-flex items-center gap-1.5"><Glyph name="send" size={12} />Send</span>
        </div>
      </div>
    </div>
  </div>

  <!-- The contact panel: where Anna stands in the campaign. -->
  <div class={`${FLOAT} left-[500px] top-[110px] w-[236px] overflow-hidden`}>
    <div class="px-4 py-3.5 border-b border-slate-200 flex items-center gap-2.5">
      <span class={`${AVATAR} size-9 text-[11px]`}>AK</span>
      <div class="min-w-0">
        <div class="text-[13px] font-semibold text-slate-900">Anna Keller</div>
        <div class="truncate text-[11px] text-slate-400">Partner · Hafen Capital</div>
      </div>
    </div>
    <div class="px-4 py-3">
      <div class={EYEBROW}>Campaigns</div>
      <div class="mt-2 rounded-md border border-slate-200 px-3 py-2.5">
        <div class="flex items-center gap-2">
          <span class="truncate text-[12px] font-medium text-slate-900">Seed · dev-tools investors</span>
        </div>
        <div class="mt-1.5 flex items-center gap-2">
          <span class="inline-flex h-4 items-center px-1.5 rounded text-[10.5px] font-medium bg-emerald-50 text-emerald-700">Replied</span>
          <span class="text-[11px] text-slate-500">Flow ended on a reply</span>
        </div>
        <div class="mt-2 flex items-center gap-1.5 text-[11px] text-slate-400"><Glyph name="x" size={11} />Email 2 cancelled</div>
      </div>
    </div>
    <div class="px-4 pb-3.5">
      <div class={EYEBROW}>Timezone</div>
      <div class="mt-1.5 flex items-center gap-1.5 text-[12px] text-slate-700"><Glyph name="globe" size={12} class="text-slate-400" />Europe/Berlin</div>
    </div>
  </div>
</ScaledStage>

<style>
  .pr-caret { animation: pr-caret 1.1s steps(1) infinite; }
  @keyframes pr-caret { 50% { opacity: 0; } }
</style>
