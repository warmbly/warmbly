---
import ScaledStage from '../../../ScaledStage.astro';
import Glyph from '../../Glyph.astro';
import { WINDOW, FLOAT, EYEBROW } from '../../../../lib/scene';
import { TH, MENU, MENU_LABEL, MENU_ITEM } from '../ui';

/**
 * Settings > Members in a client workspace (settings/members/page.tsx):
 * the client's address in the invite box with the role picker open, and the
 * card beside it is the workspace switcher as the client will see it.
 */
const roles = [
  { name: 'Admin', color: '#8b5cf6' },
  { name: 'Manager', color: '#10b981' },
  { name: 'Viewer', color: '#f59e0b', on: true },
  { name: 'Client reviewer', color: '#0ea5e9' },
];
const members = [
  { email: 'alex@acmeoutbound.com', id: '7c1f04ab', role: 'Owner', joined: 'Mar 2, 2026' },
  { email: 'sam@acmeoutbound.com', id: 'e93b22d0', role: 'Manager', color: '#10b981', joined: 'Mar 9, 2026' },
  { email: 'mia@acmeoutbound.com', id: '41d8aa6e', role: 'Manager', color: '#10b981', joined: 'Apr 14, 2026' },
];
---
<ScaledStage w={760} h={570} photo="sheer-peach">
  <div class={`${WINDOW} left-[40px] top-[40px] w-[760px] h-[560px]`}>
    <div class="px-8 pt-6 pb-4 border-b border-slate-200/70">
      <div class="text-[16px] font-semibold tracking-tight text-slate-900">Members</div>
      <div class="mt-0.5 text-[12.5px] text-slate-500">Everyone with access to Northwind.</div>
    </div>

    <section class="px-8 py-5 border-b border-slate-200/70">
      <div class="text-[12.5px] font-semibold tracking-tight text-slate-900">Invite teammates</div>
      <div class="mt-0.5 text-[11.5px] text-slate-500">Paste any number of emails and they are split for you. Pick a role; you can change it later.</div>
      <div class="mt-3 grid grid-cols-[1fr_200px] gap-4 pr-6">
        <div>
          <div class="text-[11.5px] font-medium text-slate-700">Emails</div>
          <div class="mt-1.5 min-h-[36px] px-2 py-1.5 rounded-md border border-sky-300 ring-2 ring-sky-100 bg-white flex flex-wrap items-center gap-1.5">
            <span class="h-5 px-1.5 rounded inline-flex items-center gap-1 text-[11px] font-medium bg-slate-100 text-slate-700">jordan@northwind.io<span class="text-slate-400">×</span></span>
            <span class="h-5 px-1.5 rounded inline-flex items-center gap-1 text-[11px] font-medium bg-slate-100 text-slate-700">priya@northwind.io<span class="text-slate-400">×</span></span>
            <span class="iv-caret h-4 w-px bg-sky-500"></span>
          </div>
          <div class="mt-3 flex items-center gap-2">
            <span class="text-[11.5px] font-medium text-slate-700">Roles</span>
            <span class="h-6 px-1.5 rounded text-[10px] uppercase tracking-[0.08em] font-semibold border border-slate-200 bg-white text-slate-700 inline-flex items-center gap-1.5"><span class="size-1.5 rounded-full bg-amber-500"></span>Viewer<Glyph name="chevronDown" size={10} class="text-slate-400" /></span>
          </div>
          <div class="mt-4 flex items-center">
            <span class="text-[11.5px] text-slate-500">2 emails ready</span>
            <span class="ml-auto h-7 px-2.5 rounded-md bg-slate-900 text-white text-[12px] font-medium inline-flex items-center">Send invitations</span>
          </div>
        </div>
        <div class="rounded-md border border-slate-200 bg-slate-50/40 p-3">
          <div class={EYEBROW}>Viewer</div>
          <div class="mt-1.5 text-[12px] leading-snug text-slate-700">Read-only access to campaigns, contacts, and reports.</div>
        </div>
      </div>
    </section>

    <section class="px-8 py-4">
      <div class="text-[12.5px] font-semibold tracking-tight text-slate-900">Members</div>
      <div class="mt-0.5 text-[11.5px] text-slate-500">3 members in this workspace.</div>
      <table class="mt-2 w-[470px] table-fixed">
        <thead><tr class="border-b border-slate-200"><th class={`${TH} pl-0`}>Member</th><th class={`${TH} w-[96px]`}>Role</th><th class={`${TH} w-[104px]`}>Joined</th></tr></thead>
        <tbody>
          {members.map((m) => (
            <tr class="h-12 border-b border-slate-200/60">
              <td class="pr-3">
                <div class="flex items-center gap-2.5">
                  <span class="size-7 rounded-full bg-slate-100 flex items-center justify-center text-[10px] font-semibold text-slate-600">{m.email.slice(0, 2).toUpperCase()}</span>
                  <div><div class="text-[12.5px] text-slate-900">{m.email}</div><div class="font-mono text-[10.5px] text-slate-400">{m.id}</div></div>
                </div>
              </td>
              <td class="px-3">
                {m.role === 'Owner'
                  ? <span class="inline-flex items-center gap-1 text-[10px] uppercase tracking-[0.08em] font-semibold rounded-sm px-1.5 py-0.5 border bg-sky-50 text-sky-700 border-sky-100"><Glyph name="shieldCheck" size={11} />Owner</span>
                  : <span class="inline-flex items-center gap-1 h-5 px-1.5 rounded text-[10px] font-medium border" style={`background-color:${m.color}14;border-color:${m.color}55;color:${m.color}`}><span class="size-1.5 rounded-full" style={`background-color:${m.color}`}></span>{m.role}</span>}
              </td>
              <td class="px-3 font-mono text-[11px] tabular-nums text-slate-500">{m.joined}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <!-- The role picker, open. -->
    <div class={`${MENU} enter-fade absolute left-[72px] top-[240px] w-[200px]`} style="--d:300ms">
      <div class={MENU_LABEL}>Roles</div>
      {roles.map((r) => (
        <div class={`${MENU_ITEM} ${r.on ? 'font-medium text-slate-900' : ''}`}>
          <span class={`size-3.5 rounded border flex items-center justify-center ${r.on ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-300'}`}>{r.on && <Glyph name="check" size={9} />}</span>
          <span class="size-1.5 rounded-full" style={`background-color:${r.color}`}></span>
          <span class="flex-1">{r.name}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- What the client sees once they accept. -->
  <div class={`${FLOAT} left-[540px] top-[352px] w-[200px] overflow-hidden`}>
    <div class="flex items-center gap-2.5 border-b border-slate-200 px-3 py-2.5">
      <span class="size-7 shrink-0 rounded-full bg-amber-50 border border-amber-200 flex items-center justify-center text-[10px] font-semibold text-amber-700">JO</span>
      <div class="min-w-0">
        <div class="truncate text-[12px] font-medium text-slate-900">jordan@northwind.io</div>
        <div class="text-[10.5px] text-slate-400">Viewer · the client</div>
      </div>
    </div>
    <div class="py-1">
      <div class={MENU_LABEL}>Workspaces</div>
      <div class={`${MENU_ITEM} font-medium text-slate-900`}>
        <span class="size-5 rounded-md ring-1 ring-slate-200 bg-slate-900 flex items-center justify-center"><span class="text-[9px] font-bold text-white">N</span></span>
        <span class="flex-1">Northwind</span><span class="text-[10px] text-sky-600">●</span>
      </div>
    </div>
    <div class="my-1 h-px bg-slate-200"></div>
    <div class={MENU_ITEM}><span class="text-slate-400"><Glyph name="settings" size={12} /></span>Manage workspaces</div>
    <div class="h-1"></div>
  </div>
</ScaledStage>

<style>
  .iv-caret { animation: iv-caret 1.1s steps(1) infinite; }
  @keyframes iv-caret { 50% { opacity: 0; } }
</style>
