---
import ScaledStage from '../../../ScaledStage.astro';
import Glyph from '../../Glyph.astro';
import ShareCardMock from '../../../ShareCardMock.astro';
import { WINDOW, EYEBROW } from '../../../../lib/scene';

/**
 * One client's numbers, ready to send them: the Share image preview
 * (web/src/components/app/analytics/AnalyticsShareButton.tsx) over the
 * campaign it was taken from.
 */
const aspects = ['1:1', '3:2', '16:9'];
---
<ScaledStage w={680} h={510} photo="sheer-sky">
  <div class={`${WINDOW} left-[36px] top-[36px] w-[680px] h-[480px]`}>
    <div class="h-11 px-4 border-b border-slate-200 flex items-center gap-2">
      <span class="size-5 rounded-md bg-slate-900 flex items-center justify-center"><span class="text-[9px] font-bold text-white">N</span></span>
      <span class="text-[12.5px] font-medium text-slate-900">Northwind</span>
      <span class="text-slate-300">›</span>
      <span class="text-[12.5px] text-slate-600">Ops leaders · EU</span>
    </div>
    <div class="grid grid-cols-4 border-b border-slate-200 opacity-60">
      {[['Sent', '1,640'], ['Open rate', '43.1%'], ['Reply rate', '7.1%'], ['Positive rate', '2.6%']].map(([k, v], i) => (
        <div class={`px-4 py-3 ${i < 3 ? 'border-r border-slate-200' : ''}`}>
          <div class={EYEBROW}>{k}</div>
          <div class="mt-1.5 text-[22px] font-light leading-none tabular-nums text-slate-900">{v}</div>
        </div>
      ))}
    </div>
    <div class="absolute inset-0 top-11 bg-slate-900/25 backdrop-blur-[1px]"></div>

    <!-- The preview modal. -->
    <div class="absolute left-[64px] top-[64px] w-[480px] rounded-lg border border-slate-200 bg-white shadow-[0_30px_60px_-30px_rgba(15,23,42,0.5)] overflow-hidden">
      <div class="h-11 px-4 border-b border-slate-200 flex items-center gap-2">
        <span class="text-[12.5px] font-medium text-slate-900">Share image</span>
        <span class="ml-auto inline-flex rounded-md bg-slate-100 p-0.5 text-[11px] font-medium">
          {aspects.map((a, i) => <span class={`h-6 px-2 inline-flex items-center rounded ${i === 0 ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500'}`}>{a}</span>)}
        </span>
        <span class="inline-flex size-7 items-center justify-center text-slate-400"><Glyph name="x" size={15} /></span>
      </div>
      <div class="flex justify-center bg-slate-50 px-4 py-4">
        <div class="w-[280px] overflow-hidden rounded-md ring-1 ring-slate-200 shadow-sm">
          <ShareCardMock
            title="Northwind · Ops leaders EU"
            subtitle="Last 30 days"
            date="Oct 9, 2026"
            metrics={[
              { label: 'Sent', value: '1,640', sub: 'emails' },
              { label: 'Open rate', value: '43.1%' },
              { label: 'Reply rate', value: '7.1%' },
              { label: 'Positive', value: '2.6%' },
            ]}
          />
        </div>
      </div>
      <div class="flex items-center justify-end gap-1.5 border-t border-slate-200 px-4 py-2.5">
        <span class="h-7 px-2.5 rounded-md border border-slate-200 text-[12px] font-medium text-slate-700 inline-flex items-center">Copy</span>
        <span class="h-7 px-3 rounded-md bg-sky-600 text-[12px] font-medium text-white inline-flex items-center">Download</span>
      </div>
    </div>
  </div>
</ScaledStage>
