---
import ScaledStage from '../../../ScaledStage.astro';
import Glyph from '../../Glyph.astro';
import { WINDOW, FLOAT, EYEBROW, TAB } from '../../../../lib/scene';

/**
 * Agency > Billing (web/src/app/app/agency/billing): one plan for every
 * client, the shared send pool and the shared AI balance. The card over it is
 * the client list, each workspace drawing on the same pool.
 */
const tabs = ['Clients', 'Staff', 'Usage', 'Billing', 'Branding'];
const active = 'Billing';
const meters = [
  { k: 'Sends this period', v: '96,400', of: '150,000', pct: 64 },
  { k: 'Shared AI', v: '$3.80', of: '$10.00', pct: 38 },
  { k: 'Clients', v: '5', of: 'unlimited', pct: 0 },
  { k: 'Per-client fee', v: '$0', of: 'none', pct: 0, hint: 'Add clients at no extra cost' },
];
const workspaces = [
  { n: 'Northwind', plan: '31,200 sent', age: '7mo', on: true },
  { n: 'Lumen Robotics', plan: '22,800 sent', age: '5mo' },
  { n: 'Stratech', plan: '24,100 sent', age: '1y' },
  { n: 'Penna Health', plan: '12,900 sent', age: '3mo' },
  { n: 'Vela Logistics', plan: '5,400 sent', age: '9d' },
];
const ini = (s: string) => s.split(' ').map((p) => p[0]).join('').slice(0, 2);
---
<ScaledStage w={760} h={570} photo="reeded-glass">
  <div class={`${WINDOW} left-[236px] top-[40px] w-[540px] h-[560px]`}>
    <div class="px-6 pt-5 pb-3 flex items-start">
      <div>
        <div class="text-[16px] font-semibold tracking-tight text-slate-900">Agency</div>
        <div class="mt-0.5 text-[12.5px] text-slate-500">One plan, one send pool and one AI balance for every client.</div>
      </div>
    </div>
    <div class="px-4 flex items-center gap-1 border-b border-slate-200">
      {tabs.map((t) => (
        <span class={`${TAB} ${t === active ? 'font-medium text-slate-900' : 'text-slate-500'}`}>{t}{t === active && <span class="absolute bottom-0 left-1.5 right-1.5 h-0.5 rounded-full bg-sky-600"></span>}</span>
      ))}
    </div>

    <div class="px-6 py-4">
      <div class="text-[12.5px] font-semibold text-slate-900">Current plan</div>
      <div class="mt-2.5 rounded-lg border border-slate-200 overflow-hidden mr-6">
        <div class="px-4 py-4 bg-gradient-to-b from-slate-50/60 to-white flex items-center gap-3">
          <span class="size-10 rounded-lg border border-amber-100 bg-amber-50 text-amber-700 flex items-center justify-center"><Glyph name="trendingUp" size={16} /></span>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <span class="text-[17px] font-semibold text-slate-900">Agency</span>
              <span class="inline-flex items-center gap-1 text-[10px] rounded px-1.5 h-4 uppercase tracking-[0.1em] font-medium border bg-emerald-50 text-emerald-700 border-emerald-100"><Glyph name="check" size={9} />Active</span>
            </div>
            <div class="text-[12px] text-slate-500">Unlimited clients, one shared monthly pool.</div>
          </div>
        </div>
        <div class="grid grid-cols-3 border-t border-slate-100">
          {[['Price', '$249', 'per month'], ['Renews', 'Nov 3, 2026', 'in 25 days'], ['Shared sends', '150,000', 'a month, every client']].map(([k, v, s], i) => (
            <div class={`px-4 py-3 ${i < 2 ? 'border-r border-slate-100' : ''}`}>
              <div class="text-[10px] uppercase tracking-[0.12em] text-slate-400">{k}</div>
              <div class="mt-1 text-[14px] font-semibold text-slate-900">{v}</div>
              <div class="text-[10.5px] text-slate-400">{s}</div>
            </div>
          ))}
        </div>
        <div class="px-3 py-2.5 border-t border-slate-200 flex items-center gap-1.5">
          <span class="h-7 px-2.5 rounded-md bg-slate-900 text-white text-[12px] font-medium inline-flex items-center">Buy a pack</span>
          <span class="h-7 px-2.5 rounded-md border border-slate-200 text-slate-700 text-[12px] font-medium inline-flex items-center">Invoices and payment</span>
        </div>
      </div>

      <div class="mt-5 text-[12.5px] font-semibold text-slate-900">This period</div>
      <div class="mt-3 grid grid-cols-2 gap-x-6 gap-y-4 mr-6">
        {meters.map((m) => (
          <div>
            <div class="flex items-baseline text-[12px]">
              <span class="text-slate-700">{m.k}</span>
              <span class="ml-auto font-mono text-[11.5px] tabular-nums text-slate-900">{m.v}<span class="text-slate-400"> / {m.of}</span></span>
            </div>
            <div class="mt-1.5 h-1 rounded-full bg-slate-100"><div class="enter-grow-x h-full rounded-full bg-sky-500" style={`width:${Math.max(m.pct, 1)}%`}></div></div>
            {m.hint && <div class="mt-1 text-[10.5px] text-slate-400">{m.hint}</div>}
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Every client workspace, drawing on the same pool. -->
  <div class={`${FLOAT} left-[24px] top-[120px] w-[250px] overflow-hidden`}>
    <div class="h-10 px-4 border-b border-slate-200 flex items-center">
      <span class={EYEBROW}>Clients</span>
    </div>
    <div class="p-2">
      <div class="border border-slate-200 rounded-md overflow-hidden divide-y divide-slate-200/60">
        {workspaces.map((w) => (
          <div class={`px-3 py-2 flex items-center gap-2.5 ${w.on ? 'bg-sky-50/50' : ''}`}>
            <span class="size-7 rounded bg-slate-900 text-white flex items-center justify-center text-[10px] font-semibold shrink-0">{ini(w.n)}</span>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5"><span class="truncate text-[12.5px] font-medium text-slate-900">{w.n}</span>{w.on && <span class="text-[9.5px] uppercase tracking-[0.1em] text-sky-700 bg-sky-100 px-1 rounded-sm font-semibold">Current</span>}</div>
              <div class="text-[11px] text-slate-500"><span class="uppercase tracking-[0.08em]">Client</span><span class="text-slate-300"> · </span>{w.plan}</div>
            </div>
            <span class="text-[11px] text-slate-400">{w.age}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</ScaledStage>
