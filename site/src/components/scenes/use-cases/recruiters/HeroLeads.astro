---
import ScaledStage from '../../../ScaledStage.astro';
import Glyph from '../../Glyph.astro';
import { WINDOW, FLOAT, TAB, SECTIONBAR, EYEBROW } from '../../../../lib/scene';
import { TH, CHECK, AVATAR, initials } from '../ui';

/**
 * A role's campaign on its Leads tab (contacts/ContactsTable.tsx in a
 * campaign): candidates, their progress and the recruiter each one hears
 * from. Over it, the plain-text email as the candidate reads it; one
 * candidate replies on a loop and their sequence stops.
 */
const tabs = [
  { label: 'Overview', icon: 'barChart' },
  { label: 'Leads', icon: 'user', active: true },
  { label: 'Steps', icon: 'layers' },
  { label: 'Schedule', icon: 'calendar' },
  { label: 'Settings', icon: 'settings' },
] as const;
const chips = [
  { k: 'Processing', dot: 'bg-sky-500', n: 38 },
  { k: 'Done', dot: 'bg-indigo-500', n: 12 },
  { k: 'Replied', dot: 'bg-emerald-500', n: 9 },
  { k: 'Queued', dot: 'bg-slate-300', n: 21 },
  { k: 'Unsub', dot: 'bg-slate-300', n: 2 },
];
type Lead = { name: string; email: string; company: string; status: 'processing' | 'replied' | 'done' | 'queued' | 'unsub'; step: string; sender: string; live?: boolean };
const leads: Lead[] = [
  { name: 'Maya Chen', email: 'maya@helio.dev', company: 'Helio', status: 'processing', step: 'Email 2', sender: 'dana@northwind.so', live: true },
  { name: 'Tomás Ruiz', email: 'tomas@quarry.co', company: 'Quarry', status: 'replied', step: 'Email 1', sender: 'li@northwind.so' },
  { name: 'Aisha Bello', email: 'aisha@orbitlabs.io', company: 'Orbit Labs', status: 'processing', step: 'Email 3', sender: 'dana@northwind.so' },
  { name: 'Jonas Weber', email: 'jonas@kestrel.de', company: 'Kestrel', status: 'done', step: 'Email 3', sender: 'li@northwind.so' },
  { name: 'Priya Das', email: 'priya@brightline.co', company: 'Brightline', status: 'processing', step: 'Email 1', sender: 'sam@northwind.so' },
  { name: 'Ethan Moore', email: 'ethan@stratech.io', company: 'Stratech', status: 'unsub', step: 'Email 2', sender: 'sam@northwind.so' },
  { name: 'Lucía Gómez', email: 'lucia@harbour.co', company: 'Harbour', status: 'queued', step: '', sender: '' },
  { name: 'Ken Ito', email: 'ken@sprucebio.com', company: 'Spruce Bio', status: 'queued', step: '', sender: '' },
];
const pill = {
  processing: { cls: 'text-sky-700', label: 'Processing' },
  replied: { cls: 'text-emerald-700', label: 'Replied' },
  done: { cls: 'text-indigo-700', label: 'Done' },
  queued: { cls: 'text-slate-500', label: 'Queued' },
  unsub: { cls: 'text-slate-400', label: 'Unsubscribed' },
};
---
<ScaledStage w={760} h={720} photo="sheer-peach">
  <div class={`${WINDOW} left-[40px] top-[40px] w-[760px] h-[700px]`}>
    <div class="px-5 pt-4 pb-3">
      <div class="inline-flex items-center gap-1 text-[11.5px] text-slate-400"><span>←</span> Campaigns</div>
      <div class="mt-1 flex items-center gap-2">
        <span class="text-[17px] font-semibold text-slate-900">Staff platform engineer</span>
        <span class="inline-flex h-5 items-center gap-1.5 rounded-md border border-sky-200 bg-sky-50 px-2 text-[10px] font-medium uppercase tracking-[0.12em] text-sky-700"><span class="campaign-grid"></span>Sending</span>
      </div>
    </div>
    <div class="px-3 flex items-center gap-1 border-b border-slate-200">
      {tabs.map((t) => (
        <span class={`${TAB} ${'active' in t ? 'font-medium text-slate-900' : 'text-slate-500'}`}>
          <Glyph name={t.icon} size={14} />{t.label}
          {'active' in t && <span class="absolute bottom-0 left-1.5 right-1.5 h-0.5 rounded-full bg-sky-600"></span>}
        </span>
      ))}
    </div>
    <div class={SECTIONBAR}>
      <span class={EYEBROW}>Leads</span>
      <span class="font-mono text-[10.5px] text-slate-400">82</span>
      <div class="ml-auto mr-10 h-7 w-44 pl-2 rounded-md border border-slate-200 flex items-center gap-1.5 text-[12.5px] text-slate-400"><Glyph name="search" size={13} />Search leads…</div>
    </div>
    <div class="px-5 py-2.5 border-b border-slate-200/60 flex items-center gap-x-4 pr-12">
      <div class="flex h-1.5 w-28 overflow-hidden rounded-full bg-slate-100">
        <span class="bg-sky-500" style="width:46%"></span><span class="bg-indigo-500" style="width:15%"></span><span class="bg-emerald-500" style="width:11%"></span>
      </div>
      {chips.map((c) => (
        <span class="inline-flex items-center gap-1.5 text-[11px] text-slate-500"><span class={`size-1.5 rounded-full ${c.dot}`}></span>{c.k}<span class="font-mono tabular-nums text-slate-900">{c.n}</span></span>
      ))}
      <span class="ml-auto inline-flex items-center gap-1.5 text-[10.5px] text-slate-400"><span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>Live</span>
    </div>
    <table class="w-[720px] table-fixed">
      <thead>
        <tr class="border-b border-slate-200">
          <th class="pl-5 pr-2 py-2 w-11"><span class={CHECK}></span></th>
          <th class={TH}>Name</th>
          <th class={`${TH} w-[120px]`}>Progress</th>
          <th class={`${TH} w-[96px]`}>Current step</th>
          <th class={`${TH} w-[150px]`}>Sender</th>
        </tr>
      </thead>
      <tbody>
        {leads.map((l) => {
          const done = l.status === 'replied' || l.status === 'unsub' || l.status === 'done';
          return (
            <tr class={`h-11 border-b border-slate-200/60 ${l.status === 'processing' ? 'bg-sky-50/40' : done ? 'bg-slate-50/40' : ''} ${l.live ? 'hl-live' : ''}`}>
              <td class="pl-5 pr-2"><span class={CHECK}></span></td>
              <td class="px-3">
                <div class="flex items-center gap-2 min-w-0">
                  <span class={`${AVATAR} size-6 text-[9px]`}>{initials(l.name)}</span>
                  <div class="min-w-0">
                    <div class={`truncate text-[12.5px] font-medium leading-tight ${done ? 'text-slate-400' : 'text-slate-900'}`}>{l.name}</div>
                    <div class="truncate font-mono text-[10.5px] leading-tight text-slate-400">{l.email}</div>
                  </div>
                </div>
              </td>
              <td class="px-3">
                {l.live ? (
                  <span class="relative block h-4">
                    <span class="hl-a absolute inset-0 inline-flex items-center gap-1.5 text-[10.5px] font-medium uppercase tracking-[0.08em] text-sky-700"><span class="campaign-grid"></span>Processing</span>
                    <span class="hl-b absolute inset-0 inline-flex items-center gap-1.5 text-[10.5px] font-medium uppercase tracking-[0.08em] text-emerald-700"><Glyph name="reply" size={12} />Replied</span>
                  </span>
                ) : (
                  <span class={`inline-flex items-center gap-1.5 text-[10.5px] font-medium uppercase tracking-[0.08em] ${pill[l.status].cls}`}>
                    {l.status === 'processing' && <span class="campaign-grid"></span>}
                    {l.status === 'replied' && <Glyph name="reply" size={12} />}
                    {l.status === 'done' && <Glyph name="check" size={12} />}
                    {l.status === 'queued' && <Glyph name="clock" size={12} />}
                    {l.status === 'unsub' && <Glyph name="x" size={12} />}
                    {pill[l.status].label}
                  </span>
                )}
              </td>
              <td class="px-3">
                {l.step ? <span class={`inline-flex h-5 items-center rounded px-1.5 text-[11px] font-medium ${done ? 'bg-slate-100 text-slate-400' : 'bg-sky-100 text-sky-700'}`}>{l.step}</span> : <span class="text-[11px] text-slate-300">Not started</span>}
              </td>
              <td class="px-3">{l.sender ? <span class="block truncate text-[11.5px] text-slate-600">{l.sender}</span> : <span class="text-[11px] text-slate-300">Not assigned</span>}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <!-- The email as Maya reads it: plain text, from a person. -->
  <div class={`${FLOAT} left-[300px] top-[462px] w-[436px] overflow-hidden`}>
    <div class="flex items-center gap-3 px-4 pt-3.5">
      <span class={`${AVATAR} size-8 text-[11px]`}>DR</span>
      <div class="min-w-0 flex-1">
        <div class="text-[13px] font-medium text-slate-900">Dana Reyes</div>
        <div class="text-[11.5px] text-slate-400">dana@northwind.so · to Maya</div>
      </div>
      <span class="rounded bg-emerald-50 px-1.5 text-[11px] text-emerald-700">Inbox</span>
    </div>
    <div class="px-4 pb-4">
      <div class="mt-3 text-[13px] font-medium text-slate-900">Quick question about your platform work</div>
      <div class="mt-2 space-y-2 text-[13px] leading-[1.55] text-slate-600">
        <p>Hi Maya,</p>
        <p>I read your write-up on moving Helio’s billing to event sourcing. We’re hiring a staff engineer to lead exactly that kind of work.</p>
        <p>Open to a 20-minute call next week?</p>
        <p>Dana</p>
      </div>
    </div>
  </div>
</ScaledStage>

<style>
  /* A 10s loop: Maya replies, her row turns Replied and her sequence stops.
     Base styles are the final state, which is what reduced motion shows. */
  .hl-a { opacity: 0; animation: hl-a 10s linear infinite; }
  .hl-b { animation: hl-b 10s linear infinite; }
  @keyframes hl-a { 0%, 55% { opacity: 1; } 58%, 96% { opacity: 0; } 100% { opacity: 1; } }
  @keyframes hl-b { 0%, 55% { opacity: 0; transform: scale(0.9); } 59%, 96% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  .hl-live { animation: hl-live 10s ease-out infinite; }
  @keyframes hl-live { 0%, 56% { background: rgb(240 249 255 / 0.4); } 60%, 80% { background: rgb(236 253 245); } 100% { background: rgb(240 249 255 / 0.4); } }
</style>
