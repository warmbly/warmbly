---
import ScaledStage from '../../ScaledStage.astro';
import Glyph from '../Glyph.astro';
import Ico from '../campaigns/Ico.astro';
import { WINDOW, FLOAT, EYEBROW } from '../../../lib/scene';

/**
 * How a campaign email leaves: a worker signs in to each mailbox at its own
 * provider (the Gmail API, Microsoft Graph, or SMTP for anything else, as
 * internal/app/worker/wmail/send.go does), the provider delivers from its own
 * servers, and the recipient sees mail from your mailbox and your domain.
 */
const calls = [
  { t: '09:41:07', from: 'alex@northwind.dev', to: 'gmail.googleapis.com', op: 'messages.send', code: '200' },
  { t: '09:43:52', from: 'sam@northwind.io', to: 'graph.microsoft.com', op: 'sendMail', code: '202' },
  { t: '09:46:15', from: 'ops@northwind.co', to: 'smtp.northwind.co:587', op: 'AUTH · DATA', code: '250' },
  { t: '09:49:30', from: 'mia@northwind.dev', to: 'gmail.googleapis.com', op: 'messages.send', code: '200' },
];
const providers = [
  { mark: 'google', name: 'Google Workspace', via: 'Gmail API', on: true },
  { mark: 'microsoft', name: 'Microsoft 365', via: 'Microsoft Graph' },
  { mark: 'imap', name: 'Your SMTP host', via: 'SMTP' },
] as const;
// Stage coordinates for the connectors and the mail moving along them.
const ys = [195, 287, 379];
const signIn = ys.map((y) => `M404,190 C448,190 446,${y} 492,${y}`);
const deliver = "M776,195 C820,195 812,214 862,214";
const route = "M404,190 C448,190 446,195 492,195 L776,195 C820,195 812,214 862,214";
---
<ScaledStage w={1240} h={472} photo="paint-teal">
  <!-- The connectors, under everything. -->
  <svg class="absolute inset-0" width="1240" height="472" fill="none">
    {signIn.map((d, i) => <path d={d} stroke={i === 0 ? '#0ea5e9' : '#94a3b8'} stroke-width="1.5" stroke-dasharray="4 4" />)}
    <path d={deliver} stroke="#0ea5e9" stroke-width="1.5" stroke-dasharray="4 4" />
  </svg>
  <span class="pa-dot" style={`offset-path: path('${route}');`}></span>
  <span class="pa-dot" style={`offset-path: path('${route}'); animation-delay: -2.75s;`}></span>
  <span class="absolute left-[402px] top-[150px] rounded-full bg-white/90 px-2 text-[10.5px] font-medium leading-[18px] text-slate-600 ring-1 ring-slate-200">1 · signs in</span>
  <span class="absolute left-[778px] top-[158px] rounded-full bg-white/90 px-2 text-[10.5px] font-medium leading-[18px] text-slate-600 ring-1 ring-slate-200">2 · delivers</span>

  <!-- The worker: one sign-in address per mailbox, kept for as long as it can be. -->
  <div class={`${FLOAT} left-[40px] top-[64px] w-[364px] overflow-hidden`}>
    <div class="px-4 py-3 border-b border-slate-200/70 flex items-center gap-2.5">
      <span class="size-8 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center"><Glyph name="server" size={16} /></span>
      <div class="min-w-0 flex-1">
        <div class="text-[12.5px] font-medium text-slate-900">Warmbly worker</div>
        <div class="font-mono text-[10.5px] text-slate-400">worker-fra-2 · eu-central</div>
      </div>
      <span class="inline-flex h-5 items-center gap-1.5 rounded-full border border-emerald-100 bg-emerald-50 px-2 text-[10px] font-semibold uppercase tracking-wide text-emerald-700"><span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>healthy</span>
    </div>
    <dl class="px-4 py-2.5 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-[12px]">
      <dt class="text-slate-400">Signs in from</dt><dd class="text-right font-mono text-slate-800">203.0.113.24</dd>
      <dt class="text-slate-400">Mailboxes</dt><dd class="text-right font-mono text-slate-800">38</dd>
      <dt class="text-slate-400">alex@northwind.dev</dt><dd class="text-right text-slate-800">on this worker for 214 days</dd>
    </dl>
    <div class="mx-3 mb-3 rounded-md bg-slate-900 px-3 py-2.5 font-mono text-[10.5px] leading-[1.75]">
      {calls.map((c, i) => (
        <div class="enter-fade flex gap-2 whitespace-nowrap" style={`--d:${i * 180}ms`}>
          <span class="text-slate-500">{c.t}</span>
          <span class="text-sky-300">{c.to}</span>
          <span class="text-slate-400">{c.op}</span>
          <span class="ml-auto text-emerald-400">{c.code}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- The mailbox providers, who deliver. -->
  <div class={`${FLOAT} left-[492px] top-[112px] w-[284px] overflow-hidden`}>
    <div class="px-4 py-2.5 border-b border-slate-200/70"><span class={EYEBROW}>Your mailbox provider</span></div>
    {providers.map((p) => (
      <div class={`px-4 h-[92px] flex items-center gap-3 border-b border-slate-100 last:border-b-0 ${'on' in p ? 'bg-sky-50/50' : ''}`}>
        <span class="size-9 shrink-0 rounded-lg border border-slate-200 bg-white flex items-center justify-center"><Glyph mark={p.mark} size={18} /></span>
        <div class="min-w-0 flex-1">
          <div class="text-[12.5px] font-medium text-slate-900">{p.name}</div>
          <div class="text-[11px] text-slate-400">Reached through {p.via}</div>
          <div class="mt-1 text-[11px] text-slate-600">Delivers from its own servers</div>
        </div>
      </div>
    ))}
  </div>

  <!-- What the recipient sees. -->
  <div class={`${WINDOW} left-[862px] top-[56px] w-[420px] h-[560px]`}>
    <div class="h-11 px-4 flex items-center gap-1 border-b border-slate-200 text-slate-500">
      <span class="size-8 inline-flex items-center justify-center"><Ico name="arrowLeft" size={15} /></span>
      <span class="size-8 inline-flex items-center justify-center"><Glyph name="archive" size={14} /></span>
      <span class="size-8 inline-flex items-center justify-center"><Glyph name="alert" size={14} /></span>
      <span class="size-8 inline-flex items-center justify-center"><Ico name="trash" size={14} /></span>
    </div>
    <div class="px-5 pt-4 pr-12">
      <div class="text-[17px] text-slate-900">Quick question about Orbit</div>
      <div class="mt-3 flex items-start gap-2.5">
        <span class="size-8 shrink-0 rounded-full bg-sky-600 text-white text-[12px] font-medium flex items-center justify-center">A</span>
        <div class="min-w-0">
          <div class="text-[12.5px]"><span class="font-semibold text-slate-900">Alex Kim</span> <span class="text-slate-500">&lt;alex@northwind.dev&gt;</span></div>
          <div class="inline-flex items-center gap-0.5 text-[11.5px] text-slate-500">to me <span class="rotate-180 inline-flex"><Glyph name="chevronDown" size={10} /></span></div>
        </div>
      </div>
      <div class="mt-2 ml-10 rounded-md border border-slate-200 bg-white px-3 py-2.5 shadow-[0_8px_24px_-12px_rgba(15,23,42,0.3)]">
        <dl class="grid grid-cols-[64px_1fr] gap-x-3 gap-y-1 text-[11.5px]">
          <dt class="text-right text-slate-400">from:</dt><dd class="text-slate-800">Alex Kim &lt;alex@northwind.dev&gt;</dd>
          <dt class="text-right text-slate-400">to:</dt><dd class="text-slate-800">dana@orbit.app</dd>
          <dt class="text-right text-slate-400">date:</dt><dd class="text-slate-800">Sep 14, 2026, 9:41 AM</dd>
          <dt class="text-right text-slate-400">mailed-by:</dt><dd class="font-medium text-slate-900">northwind.dev</dd>
          <dt class="text-right text-slate-400">signed-by:</dt><dd class="font-medium text-slate-900">northwind.dev</dd>
          <dt class="text-right text-slate-400">security:</dt><dd class="inline-flex items-center gap-1 text-slate-800"><Ico name="lock" size={11} class="text-slate-400" />Standard encryption (TLS)</dd>
        </dl>
      </div>
      <div class="mt-4 ml-10 space-y-2 text-[12.5px] leading-[1.6] text-slate-700">
        <p>Hi Dana,</p>
        <p>Saw Orbit just opened a second office in Austin. Teams growing that fast usually find outbound is the first thing to strain.</p>
      </div>
    </div>
  </div>
</ScaledStage>

<style>
  .pa-dot {
    position: absolute; left: 0; top: 0; width: 9px; height: 9px; border-radius: 9999px;
    background: #0ea5e9; box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.2); offset-rotate: 0deg; opacity: 0;
    animation: pa-move 5.5s cubic-bezier(0.45, 0, 0.35, 1) infinite;
  }
  @keyframes pa-move {
    0% { offset-distance: 0%; opacity: 0; }
    8%, 88% { opacity: 1; }
    100% { offset-distance: 100%; opacity: 0; }
  }</style>
