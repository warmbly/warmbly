---
import ScaledStage from '../../ScaledStage.astro';
import Glyph from '../Glyph.astro';
import Ico from './Ico.astro';
import { WINDOW, FLOAT, EYEBROW } from '../../../lib/scene';

/**
 * An email step's editor with an A/B test running (sequences/StepEmailArms,
 * StepSplitAllocator, the VariantEditor's stats row, EmailContentEditor and
 * ContentScore): the traffic-split bar, Variant B selected with its numbers
 * and the winner mark, its subject and body with merge fields.
 */
const arms = [
  { name: 'Original', pct: 34, color: 'bg-sky-500' },
  { name: 'Variant B', pct: 33, color: 'bg-violet-500', selected: true },
  { name: 'Variant C', pct: 33, color: 'bg-emerald-500' },
];
const tools = ['bold', 'italic', 'underline', '|', 'list', 'link', 'image', '|'] as const;
---
<ScaledStage w={760} h={570} photo="sheer-lavender">
  <div class={`${WINDOW} left-[40px] top-[40px] w-[760px] h-[560px]`}>
    <div class="flex items-center justify-between border-b border-slate-200 px-4 py-2">
      <span class="text-[12.5px] font-medium text-slate-700">Edit “Quick question”</span>
      <span class="flex items-center gap-1 pr-10 text-slate-400">
        <span class="inline-flex h-7 items-center gap-1.5 rounded-md px-2 text-[12px] text-slate-500"><Ico name="trash" size={14} />Delete</span>
        <span class="inline-flex size-7 items-center justify-center rounded-md"><Glyph name="x" size={16} /></span>
      </span>
    </div>

    <div class="p-4 pr-14">
      <div class="rounded-md border border-slate-200 bg-white">
        <!-- StepSplitAllocator -->
        <div class="border-b border-slate-200 flex items-center gap-2 px-2 py-2">
          <div class="relative h-8 flex-1 min-w-0 rounded-md overflow-hidden ring-1 ring-inset ring-slate-200 flex">
            {arms.map((a) => (
              <span class={`${a.color} h-full flex items-center justify-center text-white ${a.selected ? 'ring-2 ring-inset ring-white/70' : ''}`} style={`width:${a.pct}%`}>
                <span class="px-1 truncate text-[11px] font-medium tabular-nums">{a.name} <span class="opacity-80">{a.pct}%</span></span>
              </span>
            ))}
            <span class="absolute top-0 bottom-0 left-[34%] -ml-1.5 flex w-3 items-center justify-center"><span class="h-4 w-[3px] rounded-full bg-white/80 shadow ring-1 ring-slate-300"></span></span>
            <span class="absolute top-0 bottom-0 left-[67%] -ml-1.5 flex w-3 items-center justify-center"><span class="h-4 w-[3px] rounded-full bg-white/80 shadow ring-1 ring-slate-300"></span></span>
          </div>
          <span class="h-8 px-2 inline-flex items-center rounded-md text-[12px] font-medium text-slate-500">Even</span>
          <span class="h-8 px-2 inline-flex items-center gap-1 rounded-md bg-sky-600 text-[12px] font-medium text-white"><Glyph name="plus" size={13} />Variant</span>
        </div>

        <!-- VariantEditor for B, which is winning -->
        <div class="space-y-3 p-3 bg-amber-50/30">
          <div class="flex items-end gap-2">
            <div class="min-w-0 flex-1">
              <div class={`${EYEBROW} mb-1.5`}>Variant name</div>
              <div class="h-7 px-2.5 rounded-md border border-slate-200 bg-white text-[12.5px] text-slate-900 flex items-center">Variant B</div>
            </div>
            <span class="h-7 inline-flex items-center rounded-md px-2 text-[11px] font-medium tabular-nums bg-sky-50 text-sky-700">33% of contacts</span>
            <span class="size-7 inline-flex items-center justify-center rounded-md text-slate-400"><Glyph name="pause" size={13} /></span>
            <span class="size-7 inline-flex items-center justify-center rounded-md text-slate-400"><Ico name="trash" size={14} /></span>
            <span class="h-7 px-3 rounded-md bg-sky-600 text-[12px] font-medium text-white inline-flex items-center opacity-40">Save</span>
          </div>

          <div class="flex items-center gap-x-4 rounded-md bg-slate-50 px-2.5 py-1.5 text-[11px] tabular-nums">
            <span class="se-win inline-flex items-center gap-1 font-medium text-amber-700"><Ico name="trophy" size={12} /> Winner</span>
            <span><span class="text-slate-400">Sent </span><span class="font-medium text-slate-700" data-tick="412,431,2800">412</span></span>
            <span><span class="text-slate-400">Open </span><span class="font-medium text-emerald-600">61.2%</span></span>
            <span><span class="text-slate-400">Reply </span><span class="font-medium text-sky-600">8.4%</span></span>
            <span><span class="text-slate-400">Bounce </span><span class="font-medium text-rose-600">0.7%</span></span>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class={EYEBROW}>Subject</span>
              <span class="inline-flex items-center gap-0.5 text-slate-500"><Glyph name="braces" size={13} /><Glyph name="chevronDown" size={11} /></span>
            </div>
            <div class="h-7 px-2.5 rounded-md border border-slate-200 bg-white text-[12.5px] text-slate-900 flex items-center gap-1">Saw <span class="se-var"><Glyph name="braces" size={10} class="opacity-70" />Company</span> is hiring in Berlin</div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class={EYEBROW}>Body</span>
              <span class="inline-flex items-center gap-0.5 rounded-md bg-slate-100 p-0.5 text-[11.5px] font-medium">
                <span class="h-6 px-2 inline-flex items-center gap-1 rounded bg-white text-slate-900 shadow-sm"><Ico name="pencilLine" size={12} />Edit</span>
                <span class="h-6 px-2 inline-flex items-center gap-1 rounded text-slate-500"><Ico name="eye" size={12} />Preview</span>
              </span>
            </div>
            <div class="rounded-md border border-slate-200 bg-white">
              <div class="flex items-center gap-0.5 border-b border-slate-200/70 px-1.5 py-1 text-slate-500">
                {tools.map((t) => t === '|'
                  ? <span class="mx-0.5 h-4 w-px bg-slate-200"></span>
                  : <span class="size-7 inline-flex items-center justify-center rounded"><Ico name={t} size={14} /></span>
                )}
                <span class="h-7 px-1.5 inline-flex items-center gap-1 rounded"><Glyph name="braces" size={14} /><Glyph name="chevronDown" size={11} /></span>
                <span class="h-7 px-1.5 inline-flex items-center gap-1 rounded text-sky-600"><Glyph name="sparkles" size={14} /><span class="text-[11.5px] font-medium">AI</span></span>
                <span class="size-7 inline-flex items-center justify-center rounded"><Glyph name="split" size={14} /></span>
                <span class="size-7 inline-flex items-center justify-center rounded"><Ico name="shuffle" size={14} /></span>
              </div>
              <div class="se-body max-w-[408px] px-3 py-2.5 text-[13px] leading-relaxed text-slate-800">
                <p>Hi <span class="se-var"><Glyph name="braces" size={10} class="opacity-70" />First name</span>,</p>
                <p>Noticed <span class="se-var"><Glyph name="braces" size={10} class="opacity-70" />Company</span> posted six sales roles in Berlin this month. Teams that grow outbound that fast usually find their sender reputation is the first thing to crack.</p>
                <p>We keep it healthy while you scale. Worth 15 minutes next week to compare notes?</p>
                <p class="text-slate-500"><span class="se-var"><Glyph name="braces" size={10} class="opacity-70" />Sender name</span></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ContentScore, beside the body. -->
  <div class={`${FLOAT} left-[476px] top-[392px] w-[262px] overflow-hidden`}>
    <div class="px-3.5 py-2.5 border-b border-slate-200/60">
      <div class={EYEBROW}>Content check</div>
      <p class="mt-0.5 text-[11px] leading-relaxed text-slate-400">Advisory deliverability score. It never blocks sending.</p>
    </div>
    <div class="px-3.5 py-3">
      <div class="flex items-end gap-2">
        <span class="text-[22px] font-light leading-none tabular-nums text-emerald-600">84</span>
        <span class="text-[11px] text-slate-400">/ 100</span>
        <span class="ml-auto text-[11px] font-medium text-emerald-600">Looks good</span>
      </div>
      <div class="mt-2 h-1.5 rounded-full bg-slate-200 overflow-hidden"><div class="enter-grow-x h-full rounded-full bg-emerald-500" style="width:84%"></div></div>
      <p class="mt-2 inline-flex items-center gap-1.5 text-[11.5px] text-emerald-600"><Glyph name="shieldCheck" size={13} />No content issues found.</p>
    </div>
  </div>
</ScaledStage>

<style>
  .se-var {
    display: inline-flex; align-items: center; gap: 0.2rem; height: 1.25rem; padding: 0 0.375rem;
    border-radius: 0.25rem; border: 1px solid #e2e8f0; background: #f8fafc; color: #475569;
    font-size: 11px; line-height: 1; font-weight: 500; white-space: nowrap; vertical-align: baseline;
  }
  .se-body p { margin: 0 0 0.55em; }
  .se-body p:last-child { margin-bottom: 0; }
  .se-win { animation: se-win 4s ease-in-out infinite; }
  @keyframes se-win { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
</style>
