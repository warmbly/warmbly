type Name = keyof typeof EXTRA | keyof typeof LUCIDE;
interface Props {
  name: Name;
  size?: number;
  class?: string;
  /** Stroke width, 2 by default as lucide draws it. */
  stroke?: number;
}
const { name, size = 14, class: className = '', stroke = 2 } = Astro.props;
const body = (EXTRA as Record<string, string>)[name] ?? (LUCIDE as Record<string, string>)[name] ?? '';
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" class={`shrink-0 ${className}`} set:html={body} />
