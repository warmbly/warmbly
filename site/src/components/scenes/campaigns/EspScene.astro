---
import ScaledStage from '../../ScaledStage.astro';
import Glyph from '../Glyph.astro';
import { WINDOW, EYEBROW } from '../../../lib/scene';

/**
 * Settings > ESP matching (preferences/EspCoveragePanel.tsx): how many of the
 * campaign's leads are on Google, Microsoft and other providers, and which
 * mailboxes serve each, with Prefer same on.
 */
const rows = [
  { mark: 'google', label: 'Google recipients', leads: '742', via: [{ mark: 'google', n: 2 }] },
  { mark: 'microsoft', label: 'Microsoft recipients', leads: '402', via: [{ mark: 'microsoft', n: 1 }] },
] as const;
---
<ScaledStage w={460} h={345} photo="sheer-peach">
  <div class={`${WINDOW} left-[24px] top-[24px] w-[460px] h-[340px]`}>
    <div class="px-4 pt-3.5 pb-3 pr-10 flex items-start gap-3 border-b border-slate-200/60">
      <div class="min-w-0 flex-1">
        <p class="text-[12.5px] font-medium text-slate-900">ESP matching</p>
        <p class="mt-0.5 text-[11px] leading-relaxed text-slate-500">Send Google recipients from Google mailboxes and Microsoft from Microsoft.</p>
      </div>
      <span class="inline-flex items-center h-5 px-2 rounded text-[10px] uppercase tracking-[0.08em] font-medium bg-sky-50 text-sky-700">Prefer same</span>
    </div>
    <div class="px-4 pt-3 pr-10 space-y-2">
      <div class={EYEBROW}>Coverage</div>
      {rows.map((r) => (
        <div class="flex items-center gap-3 rounded-lg border border-slate-200 bg-white px-3 py-2.5">
          <span class="size-8 shrink-0 rounded-md border border-slate-200 bg-white flex items-center justify-center"><Glyph mark={r.mark} size={16} /></span>
          <div class="min-w-0 flex-1">
            <div class="text-[12.5px] font-medium leading-tight text-slate-800">{r.label} <span class="font-normal text-slate-400">· {r.leads} leads</span></div>
            <div class="mt-1.5 flex items-center gap-1.5">
              <span class="text-[10px] uppercase tracking-[0.1em] text-slate-400">via</span>
              {r.via.map((v) => (
                <span class="inline-flex h-6 items-center gap-1 rounded-md border border-sky-200 bg-sky-50/60 pl-1 pr-1.5"><Glyph mark={v.mark} size={13} /><span class="text-[11px] tabular-nums text-slate-700">×{v.n}</span></span>
              ))}
              <span class="inline-flex h-6 items-center gap-1 rounded-md border border-slate-200 bg-slate-50 pl-1 pr-1.5"><Glyph mark="imap" size={12} /><span class="text-[11px] tabular-nums text-slate-500">×1</span><span class="ml-0.5 text-[9px] uppercase tracking-[0.1em] text-slate-400">any</span></span>
            </div>
          </div>
          <span class="inline-flex h-5 items-center gap-1.5 rounded px-2 text-[10px] font-medium uppercase tracking-[0.08em] bg-emerald-50 text-emerald-700"><span class="size-1.5 rounded-full bg-emerald-500"></span>Covered</span>
        </div>
      ))}
      <div class="flex items-center gap-3 rounded-lg border border-slate-200 bg-white px-3 py-2.5">
        <span class="size-8 shrink-0 rounded-md border border-slate-200 bg-slate-50 flex items-center justify-center text-slate-400"><Glyph name="globe" size={15} /></span>
        <div class="min-w-0 flex-1">
          <div class="text-[12.5px] font-medium leading-tight text-slate-800">Other providers <span class="font-normal text-slate-400">· 140 leads</span></div>
          <div class="mt-1.5 flex items-center gap-1.5"><span class="text-[10px] uppercase tracking-[0.1em] text-slate-400">via</span><span class="text-[11px] text-slate-400">Any mailbox in the pool</span></div>
        </div>
        <span class="inline-flex h-5 items-center gap-1.5 rounded px-2 text-[10px] font-medium uppercase tracking-[0.08em] bg-slate-100 text-slate-500"><span class="size-1.5 rounded-full bg-slate-400"></span>Any</span>
      </div>
    </div>
  </div>
</ScaledStage>
