---
import Glyph from '../Glyph.astro';
import Ico from '../about/Ico.astro';

/**
 * A small card beside each FAQ topic with the numbers its answers rest on:
 * the warmup ramp and send defaults (internal/config/constants.go), the
 * reply labels, the key chain, and the plan prices (web/src/lib/plans.ts).
 */
interface Props { topic: string }
const { topic } = Astro.props;
const label = 'text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium';
const ramp = Array.from({ length: 34 }, (_, i) => Math.min(40, 10 + i));
const labels = [
  { t: 'Interested', c: '#10b981' },
  { t: 'Out of office', c: '#f59e0b' },
  { t: 'Question', c: '#0ea5e9' },
  { t: 'Unsubscribe', c: '#64748b' },
];
const plans = [
  { n: 'Starter', p: 29, s: '150 a day', tone: 'border-emerald-100 bg-emerald-50 text-emerald-700' },
  { n: 'Grow', p: 89, s: '3,000 a day', tone: 'border-amber-100 bg-amber-50 text-amber-700' },
  { n: 'Business', p: 329, s: '15,000 a day', tone: 'border-sky-100 bg-sky-50 text-sky-700' },
];
---
<div class="rounded-[8px] bg-white p-4 ring-1 ring-slate-200 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
  {topic === 'warmup' && (
    <>
      <div class="flex items-center justify-between"><span class={label}>The ramp</span><Glyph name="flame" size={13} class="text-orange-500" /></div>
      <div class="mt-3 flex h-[64px] items-end gap-[2px]">
        {ramp.map((v) => <span class="flex-1 rounded-t-[1px] bg-gradient-to-b from-orange-400 to-orange-300/40" style={`height:${(v / 40) * 100}%`}></span>)}
      </div>
      <div class="mt-1.5 flex justify-between font-mono text-[10px] text-slate-400"><span>10 a day</span><span>+1 a day</span><span>40</span></div>
    </>
  )}
  {topic === 'sending' && (
    <>
      <div class="flex items-center justify-between"><span class={label}>One mailbox, one day</span><Glyph name="send" size={13} class="text-sky-600" /></div>
      <div class="mt-3 flex items-baseline gap-1"><span class="text-[26px] font-light leading-none tabular-nums text-slate-900">50</span><span class="text-[12px] text-slate-500">cold emails by default</span></div>
      <div class="mt-3 flex items-center gap-1">
        {Array.from({ length: 12 }, (_, i) => <span class={`h-2 flex-1 rounded-sm ${i < 5 ? 'bg-sky-500' : 'bg-slate-100'}`}></span>)}
      </div>
      <div class="mt-1.5 flex justify-between font-mono text-[10px] text-slate-400"><span>90 to 420 s apart</span><span>up to 5,000</span></div>
    </>
  )}
  {topic === 'inbox' && (
    <>
      <div class="flex items-center justify-between"><span class={label}>Labelled on arrival</span><Glyph name="inbox" size={13} class="text-slate-400" /></div>
      <div class="mt-3 flex flex-wrap gap-1.5">
        {labels.map((l) => (
          <span class="inline-flex h-5 items-center gap-1 rounded-sm px-1.5 text-[10.5px] font-medium" style={`color:${l.c};background-color:${l.c}14`}><span class="size-1.5 rounded-full" style={`background-color:${l.c}`}></span>{l.t}</span>
        ))}
      </div>
      <div class="mt-3 text-[11.5px] leading-[1.5] text-slate-500">Autoresponders are recognised from their headers and never count as replies.</div>
    </>
  )}
  {topic === 'security' && (
    <>
      <div class="flex items-center justify-between"><span class={label}>Your keys</span><Ico name="lock" size={13} class="text-slate-400" /></div>
      <div class="mt-3 space-y-2">
        {[['key', 'Root key', 'key management service'], ['lock', 'Workspace data key', 'one per workspace'], ['database', 'Credentials', 'AES-256-GCM']].map(([i, t, s]) => (
          <div class="flex items-center gap-2.5">
            <span class="inline-flex size-6 items-center justify-center rounded-md bg-sky-50 text-sky-600"><Ico name={i as 'key'} size={12} /></span>
            <span class="text-[12px] text-slate-800">{t}</span><span class="ml-auto text-[10.5px] text-slate-400">{s}</span>
          </div>
        ))}
      </div>
    </>
  )}
  {topic === 'billing' && (
    <>
      <div class="flex items-center justify-between"><span class={label}>Monthly plans</span><Ico name="creditCard" size={13} class="text-slate-400" /></div>
      <div class="mt-3 space-y-2">
        {plans.map((p) => (
          <div class="flex items-center gap-2">
            <span class={`inline-flex h-5 items-center rounded border px-1.5 text-[10px] font-semibold uppercase tracking-[0.08em] ${p.tone}`}>{p.n}</span>
            <span class="text-[10.5px] text-slate-400">{p.s}</span>
            <span class="ml-auto font-mono text-[12px] text-slate-900">${p.p}</span>
          </div>
        ))}
      </div>
    </>
  )}
</div>
