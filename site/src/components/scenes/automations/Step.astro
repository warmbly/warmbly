---
import Ico from '../analytics/Ico.astro';
import BrandMark from '../../page/BrandMark.astro';

/**
 * One canvas step (web/src/components/app/flow/StepCard.tsx): icon tile or
 * brand tile, the title, the kicker and the setup summary, 264x56 unless a
 * width is given.
 */
interface Props {
  x: number;
  y: number;
  w?: number;
  icon?: string;
  brand?: string;
  tone?: 'sky' | 'amber' | 'purple' | 'violet' | 'emerald' | 'rose' | 'indigo' | 'slate';
  kicker: string;
  title: string;
  summary?: string;
  selected?: boolean;
  badge?: { text: string; tone: 'ok' | 'error' | 'muted' | 'warn' };
  class?: string;
}
const { x, y, w = 264, icon, brand, tone = 'sky', kicker, title, summary, selected, badge, class: className = '' } = Astro.props;
const TILE = {
  sky: 'bg-sky-50 text-sky-600 ring-sky-100',
  amber: 'bg-amber-50 text-amber-600 ring-amber-100',
  purple: 'bg-purple-50 text-purple-600 ring-purple-100',
  violet: 'bg-violet-50 text-violet-600 ring-violet-100',
  emerald: 'bg-emerald-50 text-emerald-600 ring-emerald-100',
  rose: 'bg-rose-50 text-rose-600 ring-rose-100',
  indigo: 'bg-indigo-50 text-indigo-600 ring-indigo-100',
  slate: 'bg-slate-100 text-slate-500 ring-slate-200',
};
const BADGE = {
  ok: 'bg-emerald-50 text-emerald-700 ring-emerald-200',
  error: 'bg-rose-50 text-rose-700 ring-rose-200',
  muted: 'bg-slate-50 text-slate-500 ring-slate-200',
  warn: 'bg-amber-50 text-amber-700 ring-amber-200',
};
---
<div class={`absolute flex h-14 items-center gap-2.5 rounded-xl border bg-white pl-2.5 pr-4 ${selected ? 'border-sky-400 ring-[3px] ring-sky-100' : 'border-slate-200/90 shadow-[0_1px_2px_rgba(15,23,42,0.04)]'} ${className}`} style={`left:${x}px;top:${y}px;width:${w}px`}>
  {brand ? (
    <BrandMark name={brand} size={28} class="rounded-md" />
  ) : (
    <span class={`inline-flex size-8 shrink-0 items-center justify-center rounded-lg ring-1 ring-inset ${TILE[tone]}`}><Ico name={icon ?? 'zap'} size={16} /></span>
  )}
  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-1.5">
      <span class="truncate text-[13px] font-medium leading-5 text-slate-900">{title}</span>
      {badge && <span class={`inline-flex h-4 shrink-0 items-center rounded px-1.5 text-[10px] font-medium ring-1 ring-inset ${BADGE[badge.tone]}`}>{badge.text}</span>}
    </div>
    <div class="truncate text-[11.5px] leading-4 text-slate-400">{kicker}{summary && <span class="text-slate-500"> · {summary}</span>}</div>
  </div>
</div>
