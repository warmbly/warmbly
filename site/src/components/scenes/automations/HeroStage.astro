---
import Photo from '../../Photo.astro';
import AutomationsDemo from '../../AutomationsDemo.astro';
import Ico from '../analytics/Ico.astro';
import SlackNotify from './SlackNotify.astro';

/**
 * The builder demo across the full width, with what the same flow did on its
 * last real run hanging under it: the History entry and the card it posted
 * to Slack. The two cards only show where there is room for them.
 */
const results: [string, [string, string][]][] = [
  ['Send a Slack message', [['channel', '#sales']]],
  ['Create a deal', [['name', 'Brightline (maya@brightline.io)']]],
  ['Create / update HubSpot contact', [['email', 'maya@brightline.io']]],
];
const float = 'float-layer absolute rounded-[10px] bg-white ring-1 ring-slate-900/[0.07] shadow-[0_24px_60px_-26px_rgba(15,23,42,0.5)] overflow-hidden';
---
<div class="relative overflow-hidden rounded-[6px] bg-slate-100">
  <Photo name="paint-teal" priority sizes="(min-width: 1440px) 1360px, 100vw" class="absolute inset-0 h-full w-full object-cover select-none pointer-events-none" />
  <div class="relative p-3 sm:p-6 md:p-8 lg:px-10 lg:pt-10 lg:pb-[160px]">
    <AutomationsDemo />
  </div>

  <div class={`${float} hidden lg:block left-10 bottom-8 w-[340px]`}>
    <div class="h-10 px-3 flex items-center border-b border-slate-200">
      <Ico name="history" size={14} class="text-slate-500" />
      <span class="ml-1.5 text-[12.5px] font-medium text-slate-900">Run history</span>
      <span class="ml-auto text-[10.5px] text-slate-400">Reply to revenue</span>
    </div>
    <div class="p-3">
      <div class="rounded-md border border-slate-200 p-2 space-y-1">
        <div class="flex items-center gap-1.5">
          <Ico name="checkCircle2" size={14} class="text-emerald-500" />
          <span class="text-[11.5px] font-medium text-slate-700">Success</span>
          <span class="ml-auto text-[10.5px] tabular-nums text-slate-400">10/9/2026, 2:41:07 PM</span>
        </div>
        {results.map(([label, preview]) => (
          <div class="pl-1">
            <div class="flex items-center gap-1.5"><Ico name="checkCircle2" size={12} class="text-emerald-400" /><span class="text-[11px] text-slate-500">{label}</span></div>
            {preview.map(([k, v]) => <div class="pl-4 text-[10px] text-slate-400"><span class="text-slate-300">{k}:</span> <span class="font-mono">{v}</span></div>)}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class={`${float} hidden lg:block right-10 bottom-8 w-[380px]`}>
    <div class="h-10 px-4 flex items-center gap-1.5 border-b border-slate-200 text-[12.5px] font-bold text-slate-900"><Ico name="hash" size={13} class="text-slate-500" />sales</div>
    <SlackNotify title="📨 New reply (positive)" text="New reply from maya@brightline.io: Can you share pricing for 20 seats?" contact="maya@brightline.io" subject="Re: Quick question about Brightline" />
  </div>
</div>
