---
import ScaledStage from '../../ScaledStage.astro';
import Glyph from '../Glyph.astro';
import { WINDOW, FLOAT, EYEBROW } from '../../../lib/scene';

/** Step two: the invitee's checkout on Grow ($89, web/src/lib/plans.ts) with 10% off for three months. */
const row = 'flex items-center justify-between text-[12.5px]';
---
<ScaledStage w={460} h={345} photo="paint-aqua">
  <div class={`${WINDOW} left-[24px] top-[24px] w-[460px] h-[340px]`}>
    <div class="h-10 px-4 flex items-center border-b border-slate-200"><span class={EYEBROW}>Checkout</span></div>
    <div class="px-5 py-4">
      <div class="flex items-center gap-2">
        <span class="inline-flex h-6 items-center gap-1.5 rounded border border-amber-100 bg-amber-50 px-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-amber-700"><span class="size-1.5 rounded-full bg-amber-500"></span>Grow</span>
        <span class="text-[12px] text-slate-500">Billed monthly</span>
      </div>
      <div class="mt-4 space-y-2.5">
        <div class={row}><span class="text-slate-600">Grow plan</span><span class="font-mono tabular-nums text-slate-900">$89.00</span></div>
        <div class={row}><span class="inline-flex items-center gap-1.5 text-emerald-700"><Glyph name="tag" size={12} />Referral, 10% off for 3 months</span><span class="font-mono tabular-nums text-emerald-700">−$8.90</span></div>
      </div>
      <div class="mt-4 border-t border-slate-200 pt-3 flex items-baseline justify-between">
        <span class="text-[12.5px] font-medium text-slate-900">Due today</span>
        <span class="text-[26px] font-light tabular-nums text-slate-900">$80.10</span>
      </div>
      <div class="mt-1 text-[11px] text-slate-400">Then $89.00 a month from the fourth month.</div>
    </div>
  </div>

  <div class={`${FLOAT} left-[214px] top-[258px] w-[226px] px-3.5 py-2.5 flex items-center gap-2.5`}>
    <span class="inline-flex size-7 items-center justify-center rounded-md bg-emerald-50 text-emerald-600"><Glyph name="checkCircle" size={14} /></span>
    <div>
      <div class="text-[12px] font-medium text-slate-900">Discount applied</div>
      <div class="text-[10.5px] text-slate-400">From the link, no code to type</div>
    </div>
  </div>
</ScaledStage>
