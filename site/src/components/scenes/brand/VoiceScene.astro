---
import ScaledStage from '../../ScaledStage.astro';
import Glyph from '../Glyph.astro';
import { WINDOW, FLOAT, EYEBROW, TOPBAR } from '../../../lib/scene';

/**
 * The voice in the product: two health reasons exactly as the warmup service
 * words them (evaluatePlacement in internal/app/warmup/service.go), marked
 * up with what each part of the sentence does.
 */
const mark = 'rounded-[3px] px-0.5 -mx-0.5';
const n = 'inline-flex size-4 -translate-y-px items-center justify-center rounded-full text-[9px] font-semibold text-white align-middle mr-1';
const notes = [
  { c: 'bg-sky-600', t: 'Say what it saw, with the number.' },
  { c: 'bg-violet-600', t: 'Say what Warmbly does about it.' },
  { c: 'bg-emerald-600', t: 'Say when it ends.' },
];
---
<ScaledStage w={760} h={570} photo="lake-motion">
  <div class={`${WINDOW} left-[44px] top-[44px] w-[740px] h-[540px]`}>
    <div class={TOPBAR}>
      <span class={EYEBROW}>Accounts</span>
      <span class="h-4 w-px bg-slate-200"></span>
      <span class="text-[12.5px] text-slate-600">Needs attention</span>
    </div>

    <div class="divide-y divide-slate-200/70">
      <div class="px-5 py-4">
        <div class="flex items-center gap-2.5">
          <span class="inline-flex size-6 items-center justify-center rounded-full border border-slate-200 bg-white"><Glyph mark="microsoft" size={13} /></span>
          <span class="text-[12.5px] font-medium text-slate-900">sam@northwind.io</span>
          <span class="inline-flex h-5 items-center gap-1 rounded border border-amber-200 bg-amber-50 px-1.5 text-[10px] font-medium text-amber-700"><span class="size-1.5 rounded-full bg-amber-500"></span>Watch</span>
        </div>
        <p class="mt-3 pl-[34px] text-[13.5px] leading-[1.75] text-slate-700">
          <span class={`${mark} bg-sky-100/80`}><span class={`${n} bg-sky-600`}>1</span>12% of warmup mail delivered at Google, Microsoft and Yahoo landed in spam over 7 days (34 delivered).</span>
          <span class={`${mark} bg-violet-100/80`}><span class={`${n} bg-violet-600`}>2</span>Sending is slowed slightly</span>
          <span class={`${mark} bg-emerald-100/80`}><span class={`${n} bg-emerald-600`}>3</span>until it is below 7.5%.</span>
        </p>
      </div>
      <div class="px-5 py-4">
        <div class="flex items-center gap-2.5">
          <span class="inline-flex size-6 items-center justify-center rounded-full border border-slate-200 bg-white"><Glyph mark="imap" size={12} /></span>
          <span class="text-[12.5px] font-medium text-slate-900">ops@northwind.co</span>
          <span class="inline-flex h-5 items-center gap-1 rounded border border-amber-200 bg-amber-50 px-1.5 text-[10px] font-medium text-amber-700"><span class="size-1.5 rounded-full bg-amber-500"></span>Throttled</span>
        </div>
        <p class="mt-3 pl-[34px] text-[13.5px] leading-[1.75] text-slate-700">
          <span class={`${mark} bg-sky-100/80`}><span class={`${n} bg-sky-600`}>1</span>22% of warmup mail delivered at Google, Microsoft and Yahoo landed in spam over 7 days (41 delivered).</span>
          <span class={`${mark} bg-violet-100/80`}><span class={`${n} bg-violet-600`}>2</span>Warmup and cold sending run at half volume with wider spacing</span>
          <span class={`${mark} bg-emerald-100/80`}><span class={`${n} bg-emerald-600`}>3</span>until it is below 15%, then return to normal on their own.</span>
        </p>
      </div>
      <div class="px-5 py-4 flex items-center gap-2.5 text-[12.5px] text-slate-400">
        <Glyph name="checkCircle" size={14} class="text-emerald-500" />Every other mailbox is healthy.
      </div>
    </div>
  </div>

  <div class={`${FLOAT} left-[396px] top-[384px] w-[316px] px-4 py-3.5`}>
    <div class={EYEBROW}>How a reason is written</div>
    <div class="mt-2.5 space-y-2">
      {notes.map((x, i) => (
        <div class="enter-fade flex items-center gap-2.5 text-[12.5px] text-slate-700" style={`--d:${400 + i * 200}ms`}>
          <span class={`inline-flex size-5 shrink-0 items-center justify-center rounded-full text-[10px] font-semibold text-white ${x.c}`}>{i + 1}</span>{x.t}
        </div>
      ))}
    </div>
  </div>
</ScaledStage>
