---
import ScaledStage from '../../ScaledStage.astro';
import Glyph from '../Glyph.astro';
import Ic from '../inbox/Ic.astro';
import { WINDOW, FLOAT, EYEBROW, TOPBAR, SECTIONBAR, ACTION_PRIMARY, STAT, STAT_VALUE, STAT_SUB } from '../../../lib/scene';

/**
 * CRM > Tasks grouped by due date (crm/tasks/page.tsx BucketGroup), with the
 * follow-ups replies open on their own (replyTaskTitle in
 * internal/app/advanced/service.go: high priority, due in 24 hours) and the
 * setting that decides which replies get one.
 */
type T = { title: string; type?: { n: string; c: string }; who: string; pri: 'urgent' | 'high' | 'medium' | 'low'; due: string; overdue?: boolean; done?: boolean; cls?: string };
const PRI = {
  urgent: { l: 'Urgent', dot: 'bg-red-500', t: 'text-red-700' },
  high: { l: 'High', dot: 'bg-amber-500', t: 'text-amber-700' },
  medium: { l: 'Medium', dot: 'bg-sky-500', t: 'text-sky-700' },
  low: { l: 'Low', dot: 'bg-slate-400', t: 'text-slate-600' },
};
const call = { n: 'Call', c: '#8b5cf6' };
const email = { n: 'Email', c: '#0ea5e9' };
const groups: { label: string; dot: string; text: string; tasks: T[] }[] = [
  { label: 'Overdue', dot: 'bg-red-500', text: 'text-red-600', tasks: [
    { title: 'Follow up: question reply from ravi@stratech.io', who: 'SO', pri: 'high', due: 'Oct 8', overdue: true },
  ] },
  { label: 'Today', dot: 'bg-sky-500', text: 'text-sky-600', tasks: [
    { title: 'Follow up: positive reply from jenna@acme.io', who: 'AK', pri: 'high', due: 'Oct 10', cls: 'tk-new' },
    { title: 'Prep the intro call with Acme', type: call, who: 'AK', pri: 'medium', due: 'Oct 10' },
    { title: 'Follow up: reply from lena@helio.gen', who: 'AK', pri: 'high', due: 'Oct 10', done: true },
  ] },
  { label: 'Tomorrow', dot: 'bg-slate-400', text: 'text-slate-700', tasks: [
    { title: 'Send the case study to Tidewater', type: email, who: 'MC', pri: 'low', due: 'Oct 11' },
    { title: 'Follow up: negative reply from tom@quarry.co', who: 'SO', pri: 'high', due: 'Oct 11' },
  ] },
];
const stats = [
  { label: 'Overdue', value: '2', sub: 'needs attention', accent: true },
  { label: 'High priority', value: '7', sub: 'urgent + high' },
  { label: 'Pending', value: '12', sub: 'not started' },
  { label: 'Active', value: '3', sub: 'in progress' },
  { label: 'Completed', value: '48', sub: 'done', last: true },
];
const intents = [
  { l: 'Positive', on: true }, { l: 'Question', on: true }, { l: 'Neutral', on: true }, { l: 'Negative', on: true }, { l: 'Automated', on: false },
];
---
<ScaledStage w={680} h={510} photo="lake-motion">
  <div class={`${WINDOW} left-[34px] top-[34px] w-[660px] h-[476px]`}>
    <div class={TOPBAR}>
      <span class={EYEBROW}>Tasks</span>
      <span class="h-4 w-px bg-slate-200"></span>
      <span class="min-w-0 truncate text-[12.5px] text-slate-600">Follow-ups + reminders across the org</span>
      <div class="ml-auto flex items-center gap-1.5">
        <div class="inline-flex rounded-md border border-slate-200 bg-white p-0.5">
          <span class="inline-flex h-6 items-center gap-1.5 rounded px-2 text-[11px] font-medium text-slate-900 shadow-sm"><Ic name="listTree" size={12} />Grouped</span>
          <span class="inline-flex h-6 items-center gap-1.5 rounded px-2 text-[11px] font-medium text-slate-500"><Ic name="layoutList" size={12} />Table</span>
        </div>
        <span class={ACTION_PRIMARY}><Glyph name="plus" size={12} />New task</span>
      </div>
    </div>
    <div class="grid grid-cols-5 border-b border-slate-200">
      {stats.map((s) => (
        <div class={s.last ? 'px-5 py-4' : STAT}>
          <div class="flex items-center gap-2"><span class={EYEBROW}>{s.label}</span>{s.accent && <span class="size-1.5 rounded-full bg-red-500"></span>}</div>
          <div class={STAT_VALUE}>{s.value}</div>
          <div class={STAT_SUB}>{s.sub}</div>
        </div>
      ))}
    </div>
    <div class={SECTIONBAR}>
      <span class={EYEBROW}>18 tasks</span>
      <span class="ml-auto flex h-7 w-[150px] items-center gap-1.5 rounded-md border border-slate-200 px-2 text-[12px] text-slate-400"><Glyph name="search" size={12} />Search tasks…</span>
      <div class="inline-flex gap-0.5 rounded-md bg-slate-100 p-0.5">
        {['All', 'Pending', 'Active', 'Done'].map((t, i) => <span class={`h-6 rounded px-2 text-[11px] font-medium leading-6 ${i === 0 ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500'}`}>{t}</span>)}
      </div>
    </div>
    <div class="space-y-3 px-5 py-5">
      {groups.map((g) => (
        <div class="overflow-hidden rounded-md border border-slate-200 bg-white">
          <div class="flex h-8 items-center gap-2 border-b border-slate-200 px-3">
            <span class="size-3.5 rounded-[4px] border border-slate-300"></span>
            <span class={`size-1.5 rounded-full ${g.dot}`}></span>
            <span class={`text-[11px] font-semibold uppercase tracking-[0.1em] ${g.text}`}>{g.label}</span>
            <span class="ml-auto font-mono text-[10.5px] tabular-nums text-slate-400">{g.tasks.length}</span>
          </div>
          <div class="divide-y divide-slate-200/60">
            {g.tasks.map((t) => (
              <div class={`flex h-10 items-center gap-2.5 px-3 ${t.cls ?? ''}`}>
                <span class="size-3.5 shrink-0 rounded-[4px] border border-slate-300"></span>
                {t.done ? <Ic name="squareCheck" size={14} class="text-emerald-600" /> : <Ic name="square" size={14} class="text-slate-400" />}
                {t.type && (
                  <span class="inline-flex h-[18px] shrink-0 items-center gap-1 rounded px-1.5 text-[10.5px] font-medium" style={`background-color:${t.done ? '#94a3b8' : t.type.c}1f;color:${t.done ? '#94a3b8' : t.type.c}`}>
                    <span class="size-1.5 rounded-full" style={`background-color:${t.done ? '#94a3b8' : t.type.c}`}></span>{t.type.n}
                  </span>
                )}
                <span class={`flex-1 truncate text-[12px] ${t.done ? 'text-slate-400 line-through' : 'text-slate-900'}`}>{t.title}</span>
                <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full border border-sky-200 bg-sky-50 text-[9px] font-semibold uppercase text-sky-700">{t.who}</span>
                <span class={`inline-flex w-[64px] shrink-0 items-center gap-1 text-[10.5px] font-semibold uppercase tracking-[0.08em] ${PRI[t.pri].t}`}><span class={`size-1.5 rounded-full ${PRI[t.pri].dot}`}></span>{PRI[t.pri].l}</span>
                <span class={`inline-flex w-[64px] shrink-0 items-center justify-end gap-1 font-mono text-[10.5px] tabular-nums ${t.overdue ? 'text-red-600' : 'text-slate-400'}`}>
                  {t.overdue ? <Ic name="triangleAlert" size={10} /> : <Ic name="calendarClock" size={10} />}{t.due}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Settings > Sending > Reply follow-ups: which replies open a task. -->
  <div class={`${FLOAT} left-[352px] top-[318px] w-[310px] p-4`}>
    <div class={EYEBROW}>Reply follow-ups</div>
    <p class="mt-1 text-[11.5px] leading-[1.5] text-slate-500">Open a CRM task when a reply lands. It is assigned to the mailbox owner and due in 24 hours.</p>
    <div class="mt-3 flex flex-wrap gap-1">
      {intents.map((i) => (
        <span class={`inline-flex h-7 items-center rounded-md border px-2.5 text-[11.5px] ${i.on ? 'border-sky-200 bg-sky-50 text-sky-700' : 'border-slate-200 bg-white text-slate-500'}`}>{i.l}</span>
      ))}
    </div>
    <p class="mt-2 text-[11px] leading-[1.45] text-slate-500">A reply classified positive, question, neutral, negative opens a task.</p>
  </div>
</ScaledStage>

<style>
  /* A reply lands and its follow-up appears under Today, on a 9s loop. */
  .tk-new { animation: tk-new 9s ease-out infinite; }
  @keyframes tk-new {
    0%, 8% { opacity: 0; background: rgb(240 249 255 / 0); }
    14% { opacity: 1; background: rgb(240 249 255); }
    60% { background: rgb(240 249 255); }
    80%, 94% { opacity: 1; background: rgb(240 249 255 / 0); }
    100% { opacity: 0; }
  }
</style>
