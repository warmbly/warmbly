---
import ScaledStage from '../../ScaledStage.astro';
import Glyph from '../Glyph.astro';
import Ic from './Ic.astro';
import Row, { type Conv } from './Row.astro';
import { L } from './labels';
import { WINDOW, FLOAT } from '../../../lib/scene';

/**
 * The Hot leads view with the label menu open on a thread (ThreadLabelMenu.tsx),
 * and the hover explanation every automatic label carries (tagMeanings.ts).
 */
const convs: Conv[] = [
  { who: 'Jenna Carter', count: 3, time: '4m', subject: 'Re: Quick question about Acme', preview: 'Thursday 10am ET works for me.', labels: [L.meeting, L.interested], open: true },
  { who: 'Maya Lopez', time: '9m', subject: 'Re: Quick question about Brightline', preview: 'Could you send pricing for 20 seats?', labels: [L.pricing], unread: true },
  { who: 'Ravi Shah', count: 2, time: '18m', subject: 'Re: Following up', preview: 'What would this cost for a team of 20?', labels: [L.pricing, L.question] },
  { who: 'Lena Fischer', time: '1h', subject: 'Re: Quick question about Helio', preview: 'Good timing actually, tell me more.', labels: [L.interested], unread: true },
  { who: 'Chen Wei', time: '2h', subject: 'Re: A thought on Tidewater', preview: 'Can we do Tuesday afternoon instead?', labels: [L.meeting] },
  { who: 'Priya Nair', time: 'Mon', subject: 'Re: Quick question about Spruce', preview: 'Yes, happy to see a demo next week.', labels: [L.interested] },
];
const menu = [L.interested, L.meeting, L.pricing, L.question, L.update, L.notNow, L.notInterested, L.wrongPerson, L.unsubscribe];
const assigned = new Set([L.interested.t, L.meeting.t]);
const icon = 'size-7 rounded-md inline-flex items-center justify-center text-slate-500';
---
<ScaledStage w={760} h={570} photo="paint-aqua">
  <div class={`${WINDOW} left-[44px] top-[44px] w-[730px] h-[526px] flex`}>
    <div class="flex w-[340px] shrink-0 flex-col border-r border-slate-200">
      <div class="flex h-11 shrink-0 items-center gap-1.5 pl-3 pr-2">
        <span class="text-[13.5px] font-semibold text-slate-900">Hot leads</span>
        <span class="text-[11.5px] tabular-nums text-slate-400">6</span>
        <span class="flex-1"></span>
        <span class={icon}><Glyph name="listFilter" size={16} /></span>
      </div>
      <div class="shrink-0 border-b border-slate-200 px-3 pb-2">
        <div class="flex h-8 items-center gap-2 rounded-md bg-slate-100/80 px-2.5 text-[12.5px] text-slate-400"><Glyph name="search" size={14} />Search Hot leads</div>
      </div>
      <div class="flex h-7 items-center px-4 text-[10.5px] font-medium uppercase tracking-[0.12em] text-slate-400">Today</div>
      <div class="divide-y divide-slate-100">
        {convs.map((c) => <Row c={c} />)}
      </div>
    </div>

    <div class="flex min-w-0 flex-1 flex-col">
      <div class="flex min-h-12 items-center gap-3 border-b border-slate-200 px-5 py-2">
        <div class="min-w-0 flex-1">
          <div class="truncate text-[13.5px] font-semibold leading-5 text-slate-900">Re: Quick question about Acme</div>
          <div class="truncate text-[11px] leading-4 text-slate-400">3 messages · alex@northwind.dev</div>
        </div>
        <span class="inline-flex size-7 items-center justify-center rounded-md bg-slate-100 text-slate-900"><Glyph name="tag" size={15} /></span>
        <span class={icon}><Glyph name="moon" size={15} /></span>
        <span class={icon}><Glyph name="archive" size={15} /></span>
      </div>
      <article class="px-5 py-4">
        <div class="flex items-start gap-3">
          <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-slate-100 text-[10.5px] font-semibold text-slate-600">JC</span>
          <div class="min-w-0 flex-1">
            <div class="text-[12.5px] font-semibold text-slate-900">Jenna Carter</div>
            <div class="mt-0.5 text-[11px] text-slate-400">to alex@northwind.dev</div>
          </div>
        </div>
        <div class="mt-3 space-y-2 pl-10 text-[13px] leading-[1.6] text-slate-800">
          <p>Thanks for the nudge. The Berlin team is exactly where this would help.</p>
          <p>Thursday 10am ET works for me. Can you send over an invite?</p>
        </div>
      </article>
    </div>
  </div>

  <!-- The label menu, opened from the tag button or the c key. -->
  <div class={`${FLOAT} left-[452px] top-[100px] w-[260px] overflow-hidden`}>
    <div class="flex items-center gap-1.5 border-b border-slate-200 px-2.5 py-2">
      <Glyph name="tag" size={14} class="text-slate-400" />
      <span class="text-[12.5px] text-slate-400">Label conversation…</span>
    </div>
    <div class="flex flex-wrap gap-1 border-b border-slate-100 px-2.5 py-2">
      {menu.filter((l) => assigned.has(l.t)).map((l) => (
        <span class="inline-flex h-5 items-center gap-1 rounded px-1.5 text-[11px] font-medium" style={`color:${l.c};background-color:${l.c}1a;`}>
          <span class="size-1.5 rounded-full" style={`background-color:${l.c}`}></span>{l.t}<Glyph name="x" size={10} class="opacity-60" />
        </span>
      ))}
    </div>
    <div class="py-1">
      {menu.map((l) => {
        const on = assigned.has(l.t);
        return (
          <div class={`flex h-7 w-full items-center gap-2 px-2.5 text-[12px] text-slate-700 ${l.t === 'Meeting' ? 'bg-slate-50' : ''}`}>
            <span class={`flex size-3.5 shrink-0 items-center justify-center rounded border ${on ? 'border-slate-900 bg-slate-900' : 'border-slate-300 bg-white'}`}>
              {on && <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>}
            </span>
            <span class="size-2.5 shrink-0 rounded-full" style={`background-color:${l.c}`}></span>
            <span class="truncate">{l.t}</span>
            {on && <span class="ml-auto text-[10px] text-slate-300">assigned</span>}
          </div>
        );
      })}
    </div>
    <div class="flex h-7 items-center justify-between border-t border-slate-100 px-2.5 text-[10px] text-slate-400">
      <span>Labels are shared with contacts</span>
      <kbd class="inline-flex h-4 items-center rounded border border-slate-200 bg-slate-50 px-1 font-mono">c</kbd>
    </div>
  </div>

  <!-- The hover explanation (TagMeaningTooltip) on the Meeting row. -->
  <div class="lb-tip float-layer absolute left-[180px] top-[196px] w-[262px] rounded-md bg-slate-900 px-3 py-2 text-[12px] leading-[1.45] text-white shadow-[0_18px_40px_-18px_rgba(15,23,42,0.6)]">
    <span class="font-medium">Meeting.</span> {L.meeting.m}
    <span class="absolute -right-1 top-[18px] size-2.5 rotate-45 rounded-[2px] bg-slate-900"></span>
  </div>
</ScaledStage>

<style>
  /* The tooltip comes and goes as a pointer would rest on the row. */
  .lb-tip { animation: lb-tip 7s ease-in-out infinite; }
  @keyframes lb-tip {
    0%, 8% { opacity: 0; transform: translateX(6px) scale(0.97); }
    14%, 86% { opacity: 1; transform: none; }
    94%, 100% { opacity: 0; transform: translateX(6px) scale(0.97); }
  }
</style>
