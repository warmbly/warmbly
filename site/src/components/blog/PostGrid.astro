---
/**
 * Newsroom-style post grid: cover image, date + tag, title. Client-side
 * search and batched "Load more" only toggle visibility; every card is
 * server-rendered for crawlers and no-JS readers.
 *
 * Topic tabs come through the `filters` slot so the index and tag pages
 * can mark their own active tab.
 */
import BlogCover from './BlogCover.astro';
import { isoDate, readingTimeOf, type BlogPost } from '../../lib/blog';

interface Props {
  posts: BlogPost[];
  /** Cards shown initially and added per "Load more" click. */
  batch?: number;
}
const { posts, batch = 12 } = Astro.props;
---
<div data-archive data-batch={batch}>
  <!-- TOOLBAR: topic tabs + search -->
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4 pb-6 border-b border-slate-200">
    <slot name="filters" />
    <div class="flex items-center gap-4 ml-auto">
      <label class="relative block">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
        </svg>
        <input
          type="search"
          placeholder="Search posts"
          data-archive-search
          class="h-10 w-48 md:w-64 pr-4 rounded-full bg-white ring-1 ring-slate-200 text-[14px] text-slate-900 placeholder:text-slate-400 outline-none focus:ring-2 focus:ring-slate-900 transition-shadow"
          style="padding-left: 2.375rem;"
        />
      </label>
      <span class="text-[13px] text-slate-400 whitespace-nowrap">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
    </div>
  </div>

  <!-- GRID -->
  <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-12">
    {posts.map((post, i) => (
      <a
        href={`/blog/${post.id}/`}
        data-post-card
        data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}
        class="group flex flex-col"
      >
        <div class="relative aspect-[16/10] rounded-[6px] overflow-hidden ring-1 ring-slate-200 transition-all duration-300 group-hover:ring-slate-300">
          <BlogCover post={post} eager={i < 3} />
        </div>
        <div class="mt-5 flex items-center gap-3 text-[13px] text-slate-400">
          <time datetime={post.data.pubDate.toISOString()}>{isoDate(post.data.pubDate)}</time>
          {post.data.tags.slice(0, 2).map((tag) => (
            <span class="text-slate-500">{tag}</span>
          ))}
          <span class="ml-auto">{readingTimeOf(post)}</span>
        </div>
        <h3 class="mt-2 text-[19px] md:text-[21px] tracking-[-0.02em] leading-[1.3] text-slate-900 transition-colors group-hover:text-slate-600">
          {post.data.title}
        </h3>
        <p class="mt-2 text-[15px] text-slate-500 leading-[1.55] line-clamp-2">{post.data.description}</p>
      </a>
    ))}
  </div>

  <!-- EMPTY STATE (search with no hits) -->
  <div class="py-16 text-center" data-archive-empty hidden>
    <p class="text-[16px] text-slate-700">Nothing matches that search.</p>
    <p class="mt-1 text-[14px] text-slate-400">Try a different word, or clear the field.</p>
  </div>

  <!-- LOAD MORE -->
  <div class="mt-12 flex justify-center" data-archive-controls hidden>
    <button
      type="button"
      data-archive-more
      class="inline-flex items-center gap-2.5 h-11 px-5 rounded-full text-[15px] text-slate-900 ring-1 ring-slate-200 hover:bg-slate-50 hover:ring-slate-300 transition-colors"
    >
      Load more
      <span class="text-[13px] text-slate-400" data-archive-remaining></span>
    </button>
  </div>
</div>

<script>
  function init(root: HTMLElement) {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-post-card]'));
    const search = root.querySelector<HTMLInputElement>('[data-archive-search]');
    const controls = root.querySelector<HTMLElement>('[data-archive-controls]');
    const moreBtn = root.querySelector<HTMLElement>('[data-archive-more]');
    const remaining = root.querySelector<HTMLElement>('[data-archive-remaining]');
    const empty = root.querySelector<HTMLElement>('[data-archive-empty]');
    if (!cards.length || !controls || !moreBtn || !remaining || !empty) return;

    const batch = parseInt(root.getAttribute('data-batch') || '12', 10);
    let visible = Math.min(batch, cards.length);
    let query = '';

    const apply = () => {
      let shown = 0;
      let hiddenByBatch = 0;
      cards.forEach((card) => {
        if (query) {
          const hit = (card.getAttribute('data-search') || '').includes(query);
          card.hidden = !hit;
          if (hit) shown++;
        } else if (shown < visible) {
          card.hidden = false;
          shown++;
        } else {
          card.hidden = true;
          hiddenByBatch++;
        }
      });
      empty.hidden = shown > 0;
      controls.hidden = !!query || hiddenByBatch === 0;
      remaining.textContent = `${hiddenByBatch} more`;
    };

    moreBtn.addEventListener('click', () => {
      visible = Math.min(visible + batch, cards.length);
      apply();
    });

    if (search) {
      search.addEventListener('input', () => {
        query = search.value.trim().toLowerCase();
        apply();
      });
    }

    if (query || cards.length > visible) apply();
  }

  document.querySelectorAll<HTMLElement>('[data-archive]').forEach(init);
</script>
