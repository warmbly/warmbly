<script>
  import { playCursor } from '../lib/cursor';
  document.querySelectorAll<HTMLElement>('[data-demo="ub"]').forEach((root) => {
    playCursor(root, {
      loop: 11000,
      steps: [
        { at: 0, x: 30, y: 34 },
        { at: 2400, el: '.ub-reply-btn', ox: 0.5, oy: 0.55, hover: '.ub-reply-btn' },
        { at: 2540, press: true, target: '.ub-reply-btn', add: ['is-open'] },
        { at: 6200, el: '[data-ub="close"]', ox: 0.5, oy: 0.55, hover: '[data-ub="close"]' },
        { at: 6340, press: true, remove: ['is-open'] },
        { at: 9000, x: 30, y: 34 },
      ],
    });
  });
</script>
