---
import DemoCursor from './DemoCursor.astro';
/**
 * Pixel-faithful mock of the Warmbly /app/unibox screen (unified inbox).
 *
 * Maps 1:1 to the real components:
 *   - web/src/app/app/unibox/page.tsx                    - three columns, nothing above them
 *   - web/src/components/app/unibox/ScopeRail.tsx        - left scope rail (w-220, white)
 *   - web/src/components/app/unibox/ConversationList.tsx - middle list (w-360): title row, search, grouped rows
 *   - web/src/components/app/unibox/ConversationItem.tsx - list rows (no avatar, unread dot in the gutter)
 *   - web/src/components/app/unibox/ThreadView.tsx       - right thread pane: subject over a meta line, icon actions
 *   - web/src/components/app/unibox/MessageBubble.tsx    - per-message article
 *
 * Renders only the in-app screen content. The marketing page wraps this
 * in its own browser frame, so there is no sidebar / app header / window
 * chrome here. The content overflows the frame on purpose; the parent
 * crops with overflow-hidden, so the load-bearing content sits top-left.
 */

// ── Lucide paths (24x24 viewBox, stroke 2) ─────────────────────────
const icons = {
  penLine:    '<path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/>',
  layers:     '<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/>',
  inbox:      '<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>',
  mail:       '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  reply:      '<polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/>',
  sparkles:   '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/>',
  moon:       '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  fileText:   '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  send:       '<path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/>',
  clock:      '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  archive:    '<rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/>',
  octagon:    '<path d="M12 16h.01"/><path d="M12 8v4"/><path d="M15.312 2a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586l-4.688-4.688A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2z"/>',
  trash2:     '<path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
  mailOpen:   '<path d="M21.2 8.4c.5.38.8.97.8 1.6v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V10a2 2 0 0 1 .8-1.6l8-6a2 2 0 0 1 2.4 0l8 6Z"/><path d="m22 10-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 10"/>',
  chevron:    '<polyline points="6 9 12 15 18 9"/>',
  listFilter: '<path d="M3 6h18"/><path d="M7 12h10"/><path d="M10 18h4"/>',
  search:     '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  tag:        '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/>',
  mailCheck:  '<path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m16 19 2 2 4-4"/>',
  trash:      '<path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
  user:       '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  cornerUp:   '<polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/>',
  forward:    '<polyline points="15 17 20 12 15 7"/><path d="M4 18v-2a4 4 0 0 1 4-4h12"/>',
  x:          '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  userPlus:   '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6"/><path d="M22 11h-6"/>',
  info:       '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
};

// ── Scope rail (left) ──────────────────────────────────────────────
// One visual language for every row: icon, label, bare tabular count.
// `accent` is an unread count (sky, semibold); a plain total stays muted.
type RailRow = { icon: keyof typeof icons; label: string; count?: string; accent?: boolean; active?: boolean };

const viewRows: RailRow[] = [
  { icon: 'layers',   label: 'All mail',       count: '342', active: true },
  { icon: 'inbox',    label: 'Inbox',          count: '7',   accent: true },
  { icon: 'mail',     label: 'Unread',         count: '7',   accent: true },
  { icon: 'reply',    label: 'Awaiting reply', count: '3',   accent: true },
  { icon: 'sparkles', label: 'Agent drafts',   count: '2',   accent: true },
  { icon: 'moon',     label: 'Snoozed',        count: '2' },
];

const folderRows: RailRow[] = [
  { icon: 'fileText', label: 'Drafts',    count: '4' },
  { icon: 'send',     label: 'Sent' },
  { icon: 'clock',    label: 'Scheduled', count: '1', accent: true },
  { icon: 'archive',  label: 'Archive' },
  { icon: 'octagon',  label: 'Spam' },
  { icon: 'trash2',   label: 'Trash' },
];

const mailboxScopes = [
  { email: 'hello@company.com',   count: '2' },
  { email: 'support@company.com', count: '5' },
  { email: 'sales@company.com',   count: ''  },
];

const labelScopes = [
  { color: '#ef4444', label: 'Urgent',  count: '1' },
  { color: '#f59e0b', label: 'Clients', count: '3' },
];

const tagScopes = [
  { color: '#3b82f6', label: 'Leads', count: '12' },
];

// ── Conversation list (middle) ─────────────────────────────────────
type Conversation = {
  sender: string; subject: string; preview: string; time: string;
  unread: boolean; selected: boolean; count?: number; mailbox: string;
  labels: { color: string; label: string }[];
};

const groups: { title: string; rows: Conversation[] }[] = [
  {
    title: 'Today',
    rows: [
      {
        sender: 'Sarah Chen',
        subject: 'Follow up on Q1 proposal',
        preview: "Thanks for sending over the docs. I've reviewed them and have a few questions.",
        time: '5m', unread: true, selected: true, count: 3,
        mailbox: 'hello@company.com',
        labels: [{ color: '#ef4444', label: 'Urgent' }, { color: '#f59e0b', label: 'Clients' }],
      },
      {
        sender: 'Jordan Smith',
        subject: 'Re: Dashboard integration',
        preview: 'The API endpoint looks good. When can we expect the staging build?',
        time: '42m', unread: false, selected: false,
        mailbox: 'support@company.com',
        labels: [],
      },
      {
        sender: 'Alex Morgan',
        subject: 'New partnership opportunity',
        preview: "Hi there, I'm reaching out about a potential partnership between our teams.",
        time: '3h', unread: true, selected: false,
        mailbox: 'sales@company.com',
        labels: [{ color: '#3b82f6', label: 'Leads' }],
      },
    ],
  },
  {
    title: 'Earlier',
    rows: [
      {
        sender: 'Casey Reynolds',
        subject: '(no subject)',
        preview: '(no preview)',
        time: 'Jan 15', unread: false, selected: false,
        mailbox: 'hello@company.com',
        labels: [],
      },
    ],
  },
];

// ── Thread (right) ─────────────────────────────────────────────────
const messages = [
  {
    initials: 'SC', name: 'Sarah Chen', addr: 'sarah@acme.io',
    to: 'hello@company.com', time: 'Jan 18, 10:32 AM', collapsed: true,
    body: "Thanks for sending over the docs. I've reviewed them and have a few questions. Can we sync up tomorrow morning?",
  },
  {
    initials: 'CO', name: 'Company', addr: 'hello@company.com',
    to: 'sarah@acme.io', time: 'Jan 18, 02:15 PM', collapsed: true,
    body: 'Absolutely! How does 10am EST work for you?',
  },
  {
    initials: 'SC', name: 'Sarah Chen', addr: 'sarah@acme.io',
    to: 'hello@company.com', time: 'Jan 18, 02:28 PM', collapsed: false,
    body: 'Perfect. See you then!',
  },
];

const threadLabels = [
  { color: '#ef4444', rgb: '239,68,68',  label: 'Urgent' },
  { color: '#f59e0b', rgb: '245,158,11', label: 'Clients' },
];

// ScopeRail: ROW / ROW_ACTIVE / ROW_IDLE and Count.
const railRow = (active?: boolean) =>
  `w-full h-7 pl-2 pr-2 rounded-md flex items-center gap-2.5 text-left ${active ? 'bg-slate-100 text-slate-900' : 'text-slate-600'}`;
const railIcon = (active?: boolean) => `shrink-0 ${active ? 'text-slate-800' : 'text-slate-400'}`;
const railCount = (accent?: boolean, active?: boolean) =>
  `shrink-0 tabular-nums text-[11px] ${accent && !active ? 'text-sky-700 font-semibold' : active ? 'text-slate-600' : 'text-slate-400'}`;
---
<div class="ub relative w-full flex flex-col bg-white text-slate-900" style="min-height:500px;" data-demo="ub">
  <!-- ─────────────────────────────────────────────────────────────
       MAIN ROW - rail · list · divider · thread (page.tsx)
  ────────────────────────────────────────────────────────────── -->
  <div class="flex-1 flex min-h-0">

    <!-- a) LEFT SCOPE RAIL (w-220, ScopeRail.tsx) -->
    <nav class="w-[220px] shrink-0 h-full bg-white border-r border-slate-200 overflow-y-auto py-3">
      <!-- Compose -->
      <div class="px-3 pb-3">
        <span class="w-full h-8 rounded-md bg-sky-600 text-white text-[12.5px] font-medium inline-flex items-center justify-center gap-1.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.penLine}></svg>
          Compose
        </span>
      </div>

      <!-- Views -->
      <div class="px-2 pb-3 space-y-px">
        {viewRows.map((r) => (
          <div class={railRow(r.active)} title={r.label}>
            <span class={railIcon(r.active)}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[r.icon]}></svg></span>
            <span class={`truncate min-w-0 flex-1 text-[12.5px] ${r.active ? 'font-medium' : ''}`}>{r.label}</span>
            {r.count && <span class={railCount(r.accent, r.active)}>{r.count}</span>}
          </div>
        ))}
      </div>

      <!-- Folders -->
      <div class="px-2 pb-3 space-y-px">
        {folderRows.map((r) => (
          <div class={railRow(r.active)} title={r.label}>
            <span class={railIcon(r.active)}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[r.icon]}></svg></span>
            <span class={`truncate min-w-0 flex-1 text-[12.5px] ${r.active ? 'font-medium' : ''}`}>{r.label}</span>
            {r.count && <span class={railCount(r.accent, r.active)}>{r.count}</span>}
          </div>
        ))}
      </div>

      <!-- Mailboxes (CollapsibleSection) -->
      <div class="pb-2">
        <div class="w-full h-7 px-4 flex items-center gap-1.5 text-left">
          <span class="text-[10.5px] uppercase tracking-[0.12em] text-slate-400 font-medium">Mailboxes</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-300" stroke-linecap="round" stroke-linejoin="round" set:html={icons.chevron}></svg>
          <span class="ml-auto text-[10.5px] text-slate-300 tabular-nums">{mailboxScopes.length}</span>
        </div>
        <div class="px-2">
          <div class="space-y-px">
            {mailboxScopes.map((m) => (
              <div class={railRow(false)} title={m.email}>
                <span class={railIcon(false)}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.mailOpen}></svg></span>
                <span class="truncate min-w-0 flex-1 text-[12.5px]">{m.email}</span>
                {m.count && <span class={railCount(true, false)}>{m.count}</span>}
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Labels (CollapsibleSection) -->
      <div class="pb-2">
        <div class="w-full h-7 px-4 flex items-center gap-1.5 text-left">
          <span class="text-[10.5px] uppercase tracking-[0.12em] text-slate-400 font-medium">Labels</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-300" stroke-linecap="round" stroke-linejoin="round" set:html={icons.chevron}></svg>
          <span class="ml-auto text-[10.5px] text-slate-300 tabular-nums">{labelScopes.length}</span>
        </div>
        <div class="px-2">
          <div class="space-y-px">
            {labelScopes.map((l) => (
              <div class={railRow(false)} title={l.label}>
                <span class="shrink-0 inline-flex w-[15px] h-[15px] items-center justify-center">
                  <span class="block size-2 rounded-full" style={`background-color:${l.color};`}></span>
                </span>
                <span class="truncate min-w-0 flex-1 text-[12.5px]">{l.label}</span>
                <span class={railCount(true, false)}>{l.count}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Tags (CollapsibleSection) -->
      <div class="pb-2">
        <div class="w-full h-7 px-4 flex items-center gap-1.5 text-left">
          <span class="text-[10.5px] uppercase tracking-[0.12em] text-slate-400 font-medium">Tags</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-300" stroke-linecap="round" stroke-linejoin="round" set:html={icons.chevron}></svg>
          <span class="ml-auto text-[10.5px] text-slate-300 tabular-nums">{tagScopes.length}</span>
        </div>
        <div class="px-2">
          <div class="space-y-px">
            {tagScopes.map((t) => (
              <div class={railRow(false)} title={t.label}>
                <span class="shrink-0 inline-flex w-[15px] h-[15px] items-center justify-center">
                  <span class="block size-2 rounded-full" style={`background-color:${t.color};`}></span>
                </span>
                <span class="truncate min-w-0 flex-1 text-[12.5px]">{t.label}</span>
                <span class={railCount(true, false)}>{t.count}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </nav>

    <!-- b) MIDDLE LIST (w-360, ConversationList.tsx) -->
    <div class="w-[360px] shrink-0 overflow-hidden flex flex-col bg-white min-h-0">
      <!-- title row -->
      <div class="h-11 pl-3 pr-2 shrink-0 flex items-center gap-1.5">
        <span class="text-[13.5px] font-semibold text-slate-900 truncate min-w-0">All mail</span>
        <span class="tabular-nums text-[11.5px] text-slate-400 shrink-0">4</span>
        <span class="flex-1"></span>
        <span class="size-7 rounded-md inline-flex items-center justify-center text-slate-500 shrink-0">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.listFilter}></svg>
        </span>
      </div>

      <!-- search -->
      <div class="px-3 pb-2 shrink-0 border-b border-slate-200">
        <div class="h-8 px-2.5 rounded-md bg-slate-100/80 flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400 shrink-0" stroke-linecap="round" stroke-linejoin="round" set:html={icons.search}></svg>
          <span class="flex-1 min-w-0 h-full inline-flex items-center text-[12.5px] text-slate-400 truncate">Search all mail</span>
          <kbd class="hidden @md:inline-flex h-4 px-1 items-center rounded border border-slate-200 bg-white text-[10px] text-slate-400 font-mono shrink-0">/</kbd>
        </div>
      </div>

      <!-- grouped rows -->
      <div class="flex-1 overflow-y-auto">
        {groups.map((g) => (
          <section>
            <div class="sticky top-0 z-10 px-4 h-7 bg-white/95 backdrop-blur-sm flex items-center">
              <span class="text-[10.5px] uppercase tracking-[0.12em] text-slate-400 font-medium">{g.title}</span>
            </div>
            <div class="divide-y divide-slate-100">
              {g.rows.map((c) => (
                <div class={`group w-full text-left pl-3 pr-4 py-2.5 flex items-start gap-2 ${c.selected ? 'bg-sky-50' : ''}`}>
                  <!-- gutter: the unread dot, or the same space when read -->
                  <span class="w-2 shrink-0 flex items-center justify-center h-[18px]">
                    {c.unread && <span class="block size-2 rounded-full bg-sky-500"></span>}
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2 min-w-0 h-[18px]">
                      <span class={`text-[12.5px] truncate min-w-0 ${c.unread ? 'text-slate-900 font-semibold' : 'text-slate-700'}`}>{c.sender}</span>
                      {c.count && <span class="shrink-0 tabular-nums text-[11px] text-slate-400">{c.count}</span>}
                      <span class={`text-[11px] tabular-nums shrink-0 ml-auto ${c.unread ? 'text-sky-700 font-medium' : 'text-slate-400'}`}>{c.time}</span>
                    </div>
                    <div class="flex items-center gap-1.5 min-w-0 mt-0.5">
                      <span class={`text-[12.5px] truncate min-w-0 ${c.unread ? 'text-slate-900 font-medium' : 'text-slate-600'}`}>{c.subject}</span>
                      {c.labels.length > 0 && (
                        <span class="ml-auto shrink-0 inline-flex items-center gap-1">
                          {c.labels.map((l) => (
                            <span
                              class="inline-flex items-center gap-1 h-4 px-1.5 rounded-sm text-[10px] font-medium overflow-hidden max-w-[110px]"
                              style={`color:${l.color};background-color:${l.color}14;`}
                            >
                              <span class="block size-1.5 rounded-full shrink-0" style={`background-color:${l.color};`}></span>
                              <span class="truncate">{l.label}</span>
                            </span>
                          ))}
                        </span>
                      )}
                    </div>
                    <div class="flex items-center gap-2 min-w-0 mt-0.5">
                      <span class="text-[11.5px] text-slate-400 truncate min-w-0">{c.preview}</span>
                      <span class="ml-auto shrink-0 max-w-[40%] truncate text-[10.5px] text-slate-300">{c.mailbox}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>

    <!-- divider: the drag handle, a 6px column with the hairline centred -->
    <div class="w-1.5 shrink-0 flex items-stretch justify-center">
      <span class="w-px bg-slate-200"></span>
    </div>

    <!-- c) RIGHT THREAD PANE (ThreadView.tsx) -->
    <div class="flex-1 min-w-0 flex flex-col bg-white min-h-0">
      <!-- header: subject over a meta line, icon-only actions on the right -->
      <div class="min-h-12 px-4 @sm:px-5 py-2 border-b border-slate-200 flex items-center gap-3 shrink-0 bg-white">
        <div class="min-w-0 flex-1">
          <div class="text-[13.5px] text-slate-900 font-semibold truncate leading-5">Follow up on Q1 proposal</div>
          <div class="flex items-center gap-1.5 min-w-0 text-[11px] text-slate-400 leading-4">
            <span class="shrink-0">3 messages</span>
            <span class="text-slate-300">&middot;</span>
            <span class="truncate min-w-0">hello@company.com</span>
            <span class="hidden @md:inline-flex items-center gap-1 shrink-0 ml-1">
              {threadLabels.map((l) => (
                <span class="inline-flex items-center gap-1 min-w-0 h-4 pl-1 pr-1 text-[10px] rounded font-medium" style={`background-color:rgba(${l.rgb},0.12);color:${l.color};border:1px solid rgba(${l.rgb},0.25);`}>
