---
/**
 * Live demo of the lead finder (/app/leads), mirrored from
 * web/src/app/app/leads/page.tsx and web/src/components/app/leads:
 *
 *   - the header with the search it is scoped to and the Map / Split / List
 *     switch, the 316px SearchPanel with the past searches under it
 *   - the filter bar, then the map with its draw tools on the left, layers and
 *     zoom on the right, the "Search this area" pill and the legend
 *   - LeadsTable under the map, with EnrichmentProgress as its banner, the
 *     floating LeadSelectionBar, and LeadDrawer open on its People tab
 *
 * Drawn inside the full app shell, 1536px wide like the automations demo.
 *
 * Demo: the cursor draws a rectangle on the map, searches it, pins drop in and
 * the list fills, it selects the page and runs Find people and emails, each row
 * reads its website and turns into an address, then the first lead opens on
 * the people found there.
 */
import AppShellMock from './AppShellMock.astro';
import DemoCursor from './DemoCursor.astro';

const svg = (d: string, size = 14, cls = '') =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 ${cls}">${d}</svg>`;

const I = {
