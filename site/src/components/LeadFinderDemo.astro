// ── The map, 964x420, drawn like the light map style ─────────────────
const MW = 964;
const MH = 420;
// The downtown grid runs a little off north, so it is drawn rotated.
const grid: string[] = [];
for (let y = -140; y <= 560; y += 44) grid.push(`M-260 ${y}H1220`);
for (let x = -260; x <= 1220; x += 62) grid.push(`M${x} -140V560`);
const minor = grid.join('');
const major = 'M-260 166H1220M-260 298H1220M482 -140V560M172 -140V560';
const river = 'M-30 352 C 140 322, 300 372, 470 346 S 780 300, 1000 342';
const highway = 'M792 -20 C 770 120, 760 210, 722 300 S 680 400, 676 450';

// The rectangle the cursor draws, in map px.
const AREA = { x: 296, y: 78, w: 404, h: 226 };

// Pins inside the area, coloured by reachability. `to` is what a website
// read turns it into, `d` when (seconds after Find people and emails).
type Reach = 'email' | 'web' | 'phone' | 'none';
const pins: { x: number; y: number; r: Reach; to?: Reach; d?: number }[] = [
  { x: 618, y: 276, r: 'web', to: 'email', d: 1.2 },
  { x: 472, y: 150, r: 'web', to: 'email', d: 2.0 },
  { x: 664, y: 232, r: 'web', to: 'email', d: 2.6 },
  { x: 560, y: 210, r: 'phone', to: 'email', d: 3.3 },
  { x: 410, y: 108, r: 'email' },
  { x: 528, y: 272, r: 'web', d: 4.1 },
  { x: 342, y: 182, r: 'web', to: 'email', d: 1.6 },
  { x: 596, y: 128, r: 'web', to: 'email', d: 2.3 },
  { x: 380, y: 250, r: 'phone' },
  { x: 446, y: 214, r: 'web', to: 'email', d: 3.0 },
  { x: 650, y: 104, r: 'none' },
  { x: 508, y: 96, r: 'web', to: 'email', d: 3.6 },
  { x: 322, y: 120, r: 'email' },
  { x: 684, y: 168, r: 'web', to: 'email', d: 4.0 },
  { x: 412, y: 284, r: 'web', to: 'email', d: 2.8 },
  { x: 548, y: 160, r: 'phone' },
  { x: 630, y: 190, r: 'web', to: 'email', d: 1.9 },
  { x: 360, y: 220, r: 'web', to: 'email', d: 3.9 },
];
const clusters = [
  { x: 388, y: 154, n: 8 },
  { x: 500, y: 236, n: 7 },
  { x: 584, y: 248, n: 5 },
];
const REACH: Record<Reach, string> = { email: '#10b981', web: '#0ea5e9', phone: '#f59e0b', none: '#94a3b8' };
const TOTAL = pins.length + clusters.reduce((n, c) => n + c.n, 0);

// ── The list: the first rows of the search, best leads first ─────────
type Cell =
  | { k: 'email'; email: string; v: 'valid' | 'risky' }
  | { k: 'note'; text: string };
type Row = {
  name: string; street: string; domain?: string; found?: boolean; phone?: string;
  rating: string; reviews: string; s0: number; s1: number; people?: number;
  before: Cell | { k: 'phone' } | { k: 'email'; email: string; v: 'unchecked' };
  after: Cell; d: number; working: string;
};
const rows: Row[] = [
  { name: 'Lakeshore Family Dental', street: 'E Cesar Chavez St', domain: 'lakeshorefamilydental.com', phone: '(512) 555-0142', rating: '4.8', reviews: '212', s0: 48, s1: 92, people: 3,
    before: { k: 'phone' }, after: { k: 'email', email: '[EMAIL]', v: 'valid' }, d: 1.2, working: 'Reading the website' },
  { name: 'Congress Avenue Smiles', street: 'Congress Ave', domain: 'congressavesmiles.com', phone: '(512) 555-0198', rating: '4.6', reviews: '148', s0: 46, s1: 86, people: 2,
    before: { k: 'phone' }, after: { k: 'email', email: '[EMAIL]', v: 'valid' }, d: 2.0, working: 'Reading the website' },
  { name: 'Rainey Street Dental Studio', street: 'Rainey St', domain: 'raineydentalstudio.com', phone: '(512) 555-0117', rating: '4.9', reviews: '96', s0: 47, s1: 88, people: 4,
    before: { k: 'phone' }, after: { k: 'email', email: '[EMAIL]', v: 'valid' }, d: 2.6, working: 'Reading the website' },
  { name: 'Eastside Kids Dentistry', street: 'E 7th St', domain: 'eastsidekidsdentistry.com', found: true, phone: '(512) 555-0163', rating: '4.7', reviews: '64', s0: 30, s1: 71, people: 1,
    before: { k: 'phone' }, after: { k: 'email', email: '[EMAIL]', v: 'risky' }, d: 3.3, working: 'Looking for a website' },
  { name: 'Capitol Orthodontics', street: 'W 11th St', domain: 'capitolortho.com', phone: '(512) 555-0105', rating: '4.5', reviews: '181', s0: 69, s1: 84, people: 2,
    before: { k: 'email', email: '[EMAIL]', v: 'unchecked' }, after: { k: 'email', email: '[EMAIL]', v: 'valid' }, d: 3.8, working: 'Reading the website' },
  { name: 'Waller Creek Dental', street: 'Red River St', domain: 'wallercreekdental.com', phone: '(512) 555-0186', rating: '4.3', reviews: '57', s0: 44, s1: 47,
    before: { k: 'phone' }, after: { k: 'note', text: 'No email on the site' }, d: 4.3, working: 'Reading the website' },
];

// LeadDrawer > PeopleTab for the first row.
const people = [
  { initials: 'MA', name: 'Dr. Maria Alvarez', seniority: 'Owner', tone: 'bg-violet-50 text-violet-700', avatar: 'bg-violet-100 text-violet-700', title: 'Founder and lead dentist', email: '[EMAIL]', verdict: 'Confirmed', vTone: 'text-emerald-700', vIcon: I.circleCheck, source: 'From the website' },
  { initials: 'JC', name: 'James Chen', seniority: 'Manager', tone: 'bg-teal-50 text-teal-700', avatar: 'bg-teal-100 text-teal-700', title: 'Practice manager', email: '[EMAIL]', verdict: 'Confirmed', vTone: 'text-emerald-700', vIcon: I.circleCheck, source: 'Listed on the website' },
  { initials: 'PN', name: 'Priya Nair', seniority: '', tone: '', avatar: 'bg-slate-100 text-slate-600', title: 'Dental hygienist', email: '[EMAIL]', verdict: 'Likely · 72%', vTone: 'text-sky-700', vIcon: I.sparkles, source: 'From the website' },
];

const pastSearches = [
  { name: 'Roofers · Denver', meta: '112 leads · 2 days ago', saved: true },
  { name: 'Vegan bakeries · Berlin', meta: '24 leads · last week' },
  { name: 'Physiotherapists · Manchester', meta: '57 leads · 3 weeks ago' },
];
const quick = ['Restaurants', 'Dentists', 'Hair salons', 'Gyms', 'Real estate'];

const checkbox = 'lf-check relative inline-flex size-4 shrink-0 items-center justify-center rounded-[4px] border border-slate-300 bg-white text-white transition-colors duration-150';
const mapBtn = 'size-7 rounded-md inline-flex items-center justify-center text-slate-600';
const mapPanel = 'flex flex-col gap-0.5 rounded-lg border border-slate-200 bg-white/95 p-0.5 shadow-[0_6px_18px_-8px_rgba(15,23,42,0.3)]';
---
<div class="lf-root round-clip bg-white ring-1 ring-slate-900/[0.07]" style="box-shadow: 0 50px 110px -32px rgba(2,132,199,0.42), 0 14px 36px -16px rgba(15,23,42,0.18);">
  <!-- browser chrome -->
  <div class="flex items-center gap-2.5 px-3 h-11 border-b border-slate-200/80 bg-gradient-to-b from-[#f7f8fa] to-[#eceef1]">
    <div class="flex items-center gap-2 shrink-0">
      <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
      <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
      <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
    </div>
    <div class="flex-1 min-w-0 flex items-center gap-2 h-7 px-3 rounded-lg bg-white ring-1 ring-slate-200/90 text-[12px] shadow-[inset_0_1px_2px_rgba(15,23,42,0.04)]">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-emerald-500 shrink-0"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      <span class="truncate font-medium text-slate-700">app.warmbly.com<span class="text-slate-400 font-normal">/app/leads</span></span>
    </div>
  </div>

  <div class="lf-fit relative w-full overflow-hidden bg-white">
    <div class="lf-screen absolute top-0 left-0 origin-top-left" style="width:1536px;">
    <AppShellMock crumb="Lead finder">
    <div class="lf relative flex h-[844px] max-h-[844px] flex-col overflow-hidden bg-white" data-demo="lf">

      <!-- ── Header ─────────────────────────────────────────────────── -->
      <header class="shrink-0 h-12 px-4 flex items-center gap-2 border-b border-slate-200">
        <Fragment set:html={svg(I.mapPinned, 16, 'text-sky-600')} />
        <h1 class="text-[13.5px] font-semibold text-slate-900">Lead finder</h1>
        <div class="h-4 w-px bg-slate-200"></div>
        <span class="lf-scope-all text-[12px] text-slate-500">All leads</span>
        <span class="lf-scope inline-flex h-6 items-center gap-1 rounded-md bg-sky-50 pl-2 pr-1 text-[12px] text-sky-800">
          Dentists · Downtown Austin
          <span class="size-4 rounded inline-flex items-center justify-center"><Fragment set:html={svg(I.x, 12)} /></span>
        </span>
        <div class="ml-auto inline-flex rounded-md border border-slate-200 p-0.5">
          <span class="h-6 px-2 rounded inline-flex items-center gap-1 text-[11.5px] text-slate-500"><Fragment set:html={svg(I.map, 14)} />Map</span>
          <span class="h-6 px-2 rounded inline-flex items-center gap-1 text-[11.5px] bg-slate-100 text-slate-900 font-medium"><Fragment set:html={svg(I.split, 14)} />Split</span>
          <span class="h-6 px-2 rounded inline-flex items-center gap-1 text-[11.5px] text-slate-500"><Fragment set:html={svg(I.list, 14)} />List</span>
        </div>
      </header>

      <div class="relative flex flex-1 min-h-0">
        <!-- ── Search panel ─────────────────────────────────────────── -->
        <aside class="flex w-[316px] shrink-0 flex-col border-r border-slate-200 bg-white">
          <div class="px-3 pt-3 pb-4 space-y-3.5">
            <div>
              <div class="mb-1.5 text-[10px] font-medium uppercase tracking-[0.14em] text-slate-400">What</div>
              <div class="relative h-8 w-full rounded-md border border-slate-200 bg-white pl-7 pr-2 flex items-center text-[12.5px] text-slate-400">
                <Fragment set:html={svg(I.search, 14, 'absolute left-2 top-1/2 -translate-y-1/2 text-slate-400')} />
                Dentists, optionally named…
              </div>
              <div class="mt-2 flex flex-wrap gap-1">
                {quick.map((q) => (
                  <span class={`inline-flex h-6 items-center rounded-full px-2.5 text-[11.5px] ${q === 'Dentists' ? 'bg-sky-50 text-sky-700 ring-1 ring-inset ring-sky-200 font-medium' : 'border border-slate-200 text-slate-600'}`}>{q}</span>
                ))}
                <span class="inline-flex h-6 items-center gap-0.5 rounded-full border border-dashed border-slate-300 px-2.5 text-[11.5px] text-slate-500">More<Fragment set:html={svg(I.chevronDown, 12)} /></span>
              </div>
            </div>

            <div>
              <div class="mb-1.5 text-[10px] font-medium uppercase tracking-[0.14em] text-slate-400">Where</div>
              <div class="relative h-8 w-full rounded-md border border-slate-200 bg-white pl-7 pr-2 flex items-center text-[12.5px] text-slate-900">
                <Fragment set:html={svg(I.mapPin, 14, 'absolute left-2 top-1/2 -translate-y-1/2 text-slate-400')} />
                Downtown, Austin, Texas
              </div>
              <div class="mt-2 flex items-center gap-1.5">
                <span class="relative min-w-0 flex-1 h-4 overflow-hidden text-[11.5px]">
                  <span class="lf-where-view absolute inset-0 truncate text-slate-500">The visible map, or draw an area</span>
                  <span class="lf-where-area absolute inset-0 truncate font-medium text-sky-700">Rectangle · 3.4 × 1.9 km</span>
                </span>
                {[I.square, I.circle, I.pentagon].map((d) => (
                  <span class="size-6 rounded-md border border-slate-200 text-slate-500 inline-flex items-center justify-center"><Fragment set:html={svg(d, 14)} /></span>
                ))}
              </div>
            </div>

            <div>
              <div class="mb-1.5 text-[10px] font-medium uppercase tracking-[0.14em] text-slate-400">Source</div>
              <div class="h-8 w-full rounded-md border border-slate-200 bg-white px-2 inline-flex items-center gap-2 text-[12.5px] text-slate-800">
                <span class="size-4 rounded bg-emerald-50 text-emerald-600 ring-1 ring-inset ring-emerald-200 inline-flex items-center justify-center"><Fragment set:html={svg(I.map, 10)} /></span>
                <span class="truncate">OpenStreetMap</span>
                <Fragment set:html={svg(I.chevronDown, 14, 'ml-auto text-slate-400')} />
              </div>
