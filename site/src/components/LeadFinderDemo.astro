                  <li class="lf-person rounded-md border border-slate-200 px-2.5 py-2" style={`--i:${i}`}>
                    <div class="flex items-start gap-2.5">
                      <div class={`mt-0.5 size-7 shrink-0 rounded-full text-[11px] font-semibold flex items-center justify-center ${p.avatar}`}>{p.initials}</div>
                      <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-1.5">
                          <span class="truncate text-[12.5px] font-medium text-slate-900">{p.name}</span>
                          {p.seniority && <span class={`shrink-0 rounded px-1 text-[10px] ${p.tone}`}>{p.seniority}</span>}
                        </div>
                        <p class="truncate text-[11.5px] text-slate-500">{p.title}</p>
                        <div class="mt-1 flex items-center gap-1.5">
                          <span class="truncate text-[12px] text-slate-800">{p.email}</span>
                          <Fragment set:html={svg(I.copy, 12, 'text-slate-300')} />
                        </div>
                        <div class="mt-0.5 flex items-center gap-x-1.5 text-[10.5px] text-slate-400">
                          <span class={`inline-flex items-center gap-0.5 ${p.vTone}`}><Fragment set:html={svg(p.vIcon, 12)} />{p.verdict}</span>
                          <span>·</span>
                          <span>{p.source}</span>
                        </div>
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
              <div class="lf-person mt-3 rounded-md border border-dashed border-slate-200 px-2.5 py-2.5" style="--i:3">
                <div class="text-[12px] font-medium text-slate-700">Find someone's email</div>
                <div class="mt-1.5 flex items-center gap-1.5">
                  <span class="h-7 flex-1 rounded-md border border-slate-200 px-2 inline-flex items-center text-[12px] text-slate-400">First name</span>
                  <span class="h-7 flex-1 rounded-md border border-slate-200 px-2 inline-flex items-center text-[12px] text-slate-400">Last name</span>
                  <span class="h-7 px-2.5 rounded-md border border-slate-200 text-[12px] text-slate-500 inline-flex items-center"><Fragment set:html={svg(I.search, 14)} /></span>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>

      <!-- ── LeadSelectionBar ───────────────────────────────────────── -->
      <div class="lf-selbar absolute bottom-4 left-1/2 z-30 flex items-center gap-1.5 rounded-md border border-slate-200 bg-white p-1 shadow-[0_16px_40px_-16px_rgba(15,23,42,0.45)]">
        <div class="inline-flex items-center gap-1.5 px-2 h-7 rounded bg-sky-50 text-sky-700 text-[12px] font-medium"><Fragment set:html={svg(I.check, 12)} /><span class="tabular-nums">{TOTAL} selected</span></div>
        <span class="lf-enrich h-7 px-2.5 rounded-md text-[12px] font-medium text-slate-700 inline-flex items-center gap-1.5 transition-colors [&.is-hover]:bg-slate-100 [&.is-hover]:text-slate-900"><Fragment set:html={svg(I.sparkles, 14)} />Find people and emails</span>
        <span class="h-7 px-2.5 rounded-md text-[12px] font-medium text-slate-700 inline-flex items-center gap-1.5"><Fragment set:html={svg(I.userPlus, 14)} />Add to contacts</span>
        <span class="h-7 px-2.5 rounded-md text-[12px] font-medium text-slate-700 inline-flex items-center gap-1.5"><Fragment set:html={svg(I.download, 14)} />Export</span>
        <span class="h-7 px-2 rounded-md text-slate-600 inline-flex items-center"><Fragment set:html={svg(I.more, 14)} /></span>
        <span class="mx-0.5 h-4 w-px bg-slate-200"></span>
        <span class="lf-clear h-7 w-7 rounded-md text-slate-500 inline-flex items-center justify-center transition-colors [&.is-hover]:bg-slate-100 [&.is-hover]:text-slate-900"><Fragment set:html={svg(I.x, 14)} /></span>
      </div>

      <!-- Toast -->
      <div class="lf-toast absolute bottom-4 right-4 z-30 flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-[12.5px] text-slate-800 shadow-[0_16px_40px_-16px_rgba(15,23,42,0.45)]">
        <Fragment set:html={svg(I.circleCheck, 16, 'text-emerald-600')} />
        Reading {TOTAL} websites for people and contact details
      </div>

      <DemoCursor />
    </div>
    </AppShellMock>
    </div>
  </div>

  <style is:global>
    @property --lf-done { syntax: '<integer>'; inherits: false; initial-value: 0; }
    @property --lf-mail { syntax: '<integer>'; inherits: false; initial-value: 0; }
    @property --lf-pct { syntax: '<integer>'; inherits: false; initial-value: 0; }

    .lf-progress { animation: lf-sweep 1.1s ease-in-out infinite; }
    @keyframes lf-sweep { from { transform: translateX(-100%); } to { transform: translateX(250%); } }

    /* Drawing the area: the rect tool lights up, the hint shows, the rectangle
       grows with the drag (the cursor's own duration and easing), then sets. */
    .lf.is-tool .lf-tool-rect { background: #0284c7; color: #fff; }
    .lf:not(.is-tool) .lf-tool-pan { background: #0284c7; color: #fff; }
    .lf-hint { display: none; }
    .lf.is-tool .lf-hint { display: inline-flex; }
    .lf-area { width: 0; height: 0; opacity: 0; border: 1.5px dashed #0284c7; background: rgba(14, 165, 233, 0.06); border-radius: 2px; }
    .lf.is-drawing .lf-area { opacity: 1; width: var(--w); height: var(--h); transition: width 1460ms cubic-bezier(0.65, 0, 0.35, 1), height 1460ms cubic-bezier(0.65, 0, 0.35, 1); }
    .lf.is-drawn .lf-area { border: 2px solid #0369a1; background: rgba(14, 165, 233, 0.12); }

    /* The sidebar follows: the area is described, the button names it. */
    .lf-where-area, .lf-sb-area, .lf-sb-busy, .lf-sweep { display: none; }
    .lf.is-drawn .lf-where-view, .lf.is-drawn .lf-sb-view { display: none; }
    .lf.is-drawn .lf-where-area { display: block; animation: lf-up 0.18s ease-out; }
    .lf.is-drawn .lf-sb-area { display: inline-flex; }
    .lf.is-searching .lf-sb-area { display: none; }
    .lf.is-searching .lf-sb-busy, .lf.is-searching .lf-sweep { display: inline-flex; }

    /* Search this area, then Searching…, then gone once the pins are in. */
    .lf-pill-wrap, .lf-pill-busy { display: none; }
    .lf.is-drawn .lf-pill-wrap { display: block; animation: lf-up 0.2s ease-out; }
    .lf.is-searching .lf-pill-idle { display: none; }
    .lf.is-searching .lf-pill-busy { display: inline-flex; }
    .lf.is-found .lf-pill-wrap { display: none; }

    /* Results: pins drop in, the list fills, the search joins the list. */
    .lf-pin, .lf-n1, .lf-scope, .lf-newsearch, .lf-rows, .lf-colhead, .lf-strips > div { display: none; }
    .lf.is-found .lf-pin { display: block; animation: lf-drop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both; animation-delay: calc(var(--i) * 35ms); }
    .lf.is-found .lf-n0, .lf.is-found .lf-scope-all, .lf.is-found .lf-empty { display: none; }
    .lf.is-found .lf-n1 { display: inline; }
    .lf.is-found .lf-scope { display: inline-flex; animation: lf-up 0.2s ease-out; }
    .lf.is-found .lf-newsearch { display: block; animation: lf-up 0.3s ease-out; }
    .lf.is-found .lf-rows { display: block; }
    .lf.is-found .lf-colhead { display: flex; }
    .lf.is-found .lf-row { animation: lf-up 0.35s ease-out both; animation-delay: calc(120ms + var(--i) * 55ms); }
    .lf.is-searching .lf-strip-search { display: flex; }

    /* Selection: every checkbox on the page, and the floating bar. */
    .lf-tick { opacity: 0; }
    .lf.is-selected .lf-check { background: #0284c7; border-color: #0284c7; }
    .lf.is-selected .lf-tick { opacity: 1; }
    .lf-selbar { display: none; transform: translateX(-50%); }
    .lf.is-selected .lf-selbar { display: flex; animation: lf-bar 0.16s ease-out; }

    /* The run: each row reads its site, then turns into what it found. */
    .lf-work, .lf-done, .lf-working, .lf-flash, .lf-people, .lf-active, .lf-toast { opacity: 0; }
    .lf.is-toast .lf-toast { opacity: 1; animation: lf-toast 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
    .lf.is-enriching:not(.is-enriched) .lf-strip-run { display: flex; }
    .lf.is-enriched .lf-strip-done { display: flex; animation: lf-up 0.25s ease-out; }
    .lf.is-enriching .lf-pre { animation: lf-out 0.2s both; }
    .lf.is-enriching .lf-work, .lf.is-enriching .lf-working { animation: lf-in-out 1s both; animation-duration: var(--d); }
    .lf.is-enriching .lf-done, .lf.is-enriching .lf-people { animation: lf-in 0.35s both; animation-delay: var(--d); }
    .lf.is-enriching .lf-flash { animation: lf-flash 1.6s both; animation-delay: var(--d); }
    .lf-score { width: var(--s0); background: #0ea5e9; }
    .lf.is-enriching .lf-score { width: var(--s1); background: #0369a1; transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.7s; transition-delay: var(--d); }
    .lf.is-enriching .lf-dot-to { animation: lf-recolor 0.5s both; animation-delay: var(--d); }

    .lf-count::after { counter-reset: n var(--n); content: counter(n); }
    .lf-c-done { --n: var(--lf-done); }
    .lf-c-mail { --n: var(--lf-mail); }
    .lf-c-pct { --n: var(--lf-pct); }
    .lf.is-enriching .lf-c-done { animation: lf-c-done 4.6s linear both; }
    .lf.is-enriching .lf-c-mail { animation: lf-c-mail 4.6s linear both; }
    .lf.is-enriching .lf-c-pct { animation: lf-c-pct 4.6s linear both; }
    .lf-run-bar { width: 3%; }
    .lf.is-enriching .lf-run-bar { width: 100%; transition: width 4.6s linear; }
    @keyframes lf-c-done { to { --lf-done: 38; } }
    @keyframes lf-c-mail { to { --lf-mail: 27; } }
    @keyframes lf-c-pct { to { --lf-pct: 100; } }

    /* The drawer: the first lead, on the people found there. */
    .lf-drawer { transform: translateX(100%); visibility: hidden; transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 0.22s; }
    .lf.is-drawer .lf-drawer { transform: none; visibility: visible; transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1); }
    .lf.is-drawer .lf-person { animation: lf-up 0.3s ease-out both; animation-delay: calc(160ms + var(--i) * 70ms); }
    .lf.is-drawer .lf-row-0 .lf-active { opacity: 1; }
    .lf.is-drawer .lf-pin-0 { z-index: 5; }
    .lf.is-drawer .lf-pin-0 .lf-dot { scale: 1.6; box-shadow: 0 0 0 6px rgba(16, 185, 129, 0.25); transition: scale 0.25s, box-shadow 0.25s; }

    @keyframes lf-drop { from { opacity: 0; transform: translateY(-14px) scale(0.6); } to { opacity: 1; transform: none; } }
    @keyframes lf-up { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    @keyframes lf-bar { from { opacity: 0; transform: translate(-50%, 16px); } to { opacity: 1; transform: translate(-50%, 0); } }
    @keyframes lf-toast { from { opacity: 0; transform: translateY(10px) scale(0.97); } to { opacity: 1; transform: none; } }
    @keyframes lf-in { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }
    @keyframes lf-out { to { opacity: 0; } }
    @keyframes lf-in-out { 0%, 99% { opacity: 1; } 100% { opacity: 0; } }
    @keyframes lf-flash { 0% { opacity: 0; } 15% { opacity: 1; } 100% { opacity: 0; } }
    @keyframes lf-recolor { from { background: var(--from); scale: 1; } 50% { scale: 1.5; } to { background: var(--to); scale: 1; } }

    /* Reduced motion: hold the finished run with the drawer open. */
    .lf.is-static .lf-area { opacity: 1; width: var(--w); height: var(--h); border: 2px solid #0369a1; background: rgba(14, 165, 233, 0.12); }
    .lf.is-static .lf-pin { display: block; }
    .lf.is-static .lf-dot-to { background: var(--to) !important; }
    .lf.is-static .lf-n0, .lf.is-static .lf-scope-all, .lf.is-static .lf-empty, .lf.is-static .lf-pre, .lf.is-static .lf-where-view, .lf.is-static .lf-sb-view { display: none; }
    .lf.is-static .lf-n1 { display: inline; }
    .lf.is-static .lf-scope, .lf.is-static .lf-colhead, .lf.is-static .lf-strip-done, .lf.is-static .lf-sb-area { display: flex; }
    .lf.is-static .lf-where-area, .lf.is-static .lf-newsearch, .lf.is-static .lf-rows { display: block; }
    .lf.is-static .lf-done, .lf.is-static .lf-people, .lf.is-static .lf-row-0 .lf-active { opacity: 1; }
    .lf.is-static .lf-score { width: var(--s1); background: #0369a1; }
    .lf.is-static .lf-drawer { transform: none; visibility: visible; }
  </style>

  <script>
    import { playCursor } from '../lib/cursor';
    // The whole 1536px window from md up; on a phone the shell and search
    // panel slide off the left so the map and list fill the frame.
    const DESIGN = 1536;
    const CROP = 572;
    function fit(screen: HTMLElement) {
      const box = screen.parentElement as HTMLElement | null;
      if (!box) return;
      const crop = window.innerWidth >= 768 ? 0 : CROP;
      const s = box.clientWidth / (DESIGN - crop);
      screen.style.transform = `translateX(${-crop * s}px) scale(${s})`;
      box.style.height = `${screen.offsetHeight * s}px`;
    }
    document.querySelectorAll<HTMLElement>('.lf-screen').forEach((screen) => {
      const run = () => fit(screen);
      run();
      requestAnimationFrame(run);
      if (screen.parentElement) new ResizeObserver(() => requestAnimationFrame(run)).observe(screen.parentElement);
      window.addEventListener('load', run);
    });
    document.querySelectorAll<HTMLElement>('[data-demo="lf"]').forEach((root) => {
      playCursor(root, {
        loop: 24500,
        steps: [
          { at: 0, x: 62, y: 30 },
          { at: 1300, el: '.lf-tool-rect', hover: '.lf-tool-rect' },
          { at: 1440, press: true, target: '.lf-tool-rect', add: ['is-tool'] },
          { at: 2700, el: '.lf-a0', down: true, add: ['is-drawing'] },
          { at: 4300, el: '.lf-a1', straight: true, slow: true, up: true, add: ['is-drawn'], remove: ['is-tool'] },
          { at: 5500, el: '.lf-pill', oy: 0.55, hover: '.lf-pill' },
          { at: 5640, press: true, target: '.lf-pill', add: ['is-searching'] },
          { at: 6900, add: ['is-found'], remove: ['is-searching'] },
          { at: 8300, el: '.lf-all', hover: '.lf-all' },
          { at: 8440, press: true, target: '.lf-all', add: ['is-selected'] },
          { at: 9700, el: '.lf-enrich', hover: '.lf-enrich' },
          { at: 9840, press: true, target: '.lf-enrich', add: ['is-enriching', 'is-toast'] },
          { at: 11200, el: '.lf-clear', hover: '.lf-clear' },
          { at: 11340, press: true, target: '.lf-clear', remove: ['is-selected'] },
          { at: 12800, remove: ['is-toast'] },
          { at: 13200, x: 46, y: 80 },
          { at: 14500, add: ['is-enriched'] },
          { at: 15600, el: '.lf-row-0', ox: 0.22, hover: '.lf-row-0' },
          { at: 15740, press: true, target: '.lf-row-0', add: ['is-drawer'] },
          { at: 17600, el: '.lf-person', ox: 0.6, oy: 0.7 },
          { at: 21600, el: '.lf-close', hover: '.lf-close' },
          { at: 21740, press: true, target: '.lf-close', remove: ['is-drawer'] },
          { at: 23400, x: 62, y: 30 },
        ],
      });
    });
  </script>
</div>
