---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import Photo from '../components/Photo.astro';
import Rule from '../components/page/Rule.astro';
import Faq from '../components/page/Faq.astro';
import SettingsScene from '../components/scenes/referral/SettingsScene.astro';
import ShareStep from '../components/scenes/referral/ShareStep.astro';
import CheckoutStep from '../components/scenes/referral/CheckoutStep.astro';
import CreditStep from '../components/scenes/referral/CreditStep.astro';
import SettleScene from '../components/scenes/referral/SettleScene.astro';

// Terms from docs/content/docs/guides/referral-program.mdx; plan prices from
// web/src/lib/plans.ts. The reward is one month of the invitee's plan.
const referralHref = 'https://app.warmbly.com/app/settings/referral';
const plans = [
  { id: 'starter', name: 'Starter', price: 29 },
  { id: 'grow', name: 'Grow', price: 89 },
  { id: 'business', name: 'Business', price: 329 },
];
const save = (p: number) => Math.round(p * 0.1 * 3);

const steps = [
  { t: 'Share your link', d: 'Find it under Settings, Refer & earn, and send it to anyone who runs cold outreach.' },
  { t: 'They save 10%', d: 'Their first three months are 10% off, applied at checkout with no code to type.' },
  { t: 'You earn a month', d: 'When they move to a paid plan, one month of that plan lands on your account as credit.' },
];

const terms = [
  { t: 'One reward per team you refer', d: 'And they stack. Refer five teams that upgrade and you earn five rewards.' },
  { t: 'Paid as account credit', d: 'It comes off your next Warmbly invoices automatically. It is never a cash payout.' },
  { t: 'Settled after 30 days', d: 'If a referred subscription is refunded or cancelled within 30 days, that credit is reversed.' },
  { t: 'Fair use', d: 'Self-referrals and duplicate accounts don’t qualify, and rewards are reviewed before they apply.' },
];

const faq: [string, string][] = [
  ['Where do I find my referral link?', 'In the dashboard under Settings, Refer & earn. Only the workspace owner sees it, because the credit lands on the workspace’s own invoices. The same page shows how many people signed up, how many upgraded and how much you have earned.'],
  ['What does the person I refer get?', '10% off their first three months on whichever paid plan they choose, applied automatically.'],
  ['How much do I earn for an annual plan?', 'One month of that plan’s price, the same as for a monthly plan, not a share of the whole year.'],
  ['Can I get paid in cash?', 'No. Rewards are account credit that comes off your own Warmbly invoices.'],
  ['What if someone I referred cancels?', 'If they refund or cancel within 30 days of your reward, it is reversed. After that it is yours.'],
];
---
<Layout
  title="Referral Program: Give 10%, Earn a Month | Warmbly"
  description="Share your Warmbly link: the teams you refer get 10% off their first three months, and you earn account credit worth one month of their plan, applied automatically."
>
  <!-- HERO: the offer beside a calculator for it. -->
  <section class="container-page pt-14 md:pt-24 pb-20 md:pb-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div>
        <div class="text-[14px] text-slate-500">Referral program</div>
        <h1 class="mt-4 text-[40px] sm:text-[52px] md:text-[64px] font-medium tracking-[-0.05em] leading-[1.02] text-slate-900">Give 10% off. Earn a month free.</h1>
        <p class="mt-6 max-w-xl text-[17px] md:text-[19px] leading-[1.55] text-slate-500">Send your link to a team that does cold outreach. They save 10% on their first three months, and when they upgrade you get a month of their plan as credit.</p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href={referralHref} class="inline-flex h-11 items-center gap-2 rounded-full bg-slate-900 px-5 text-[15px] font-medium text-white transition-colors hover:bg-slate-800">Get your link <Icon name="arrowRight" size={14} /></a>
          <a href="https://docs.warmbly.com/guides/referral-program/" class="inline-flex h-11 items-center rounded-full border border-slate-200 px-5 text-[15px] text-slate-800 transition-colors hover:border-slate-300 hover:bg-slate-50">Read the terms</a>
        </div>
      </div>

      <div class="relative overflow-hidden rounded-[6px] bg-slate-100">
        <Photo name="sheer-peach" priority sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
        <div class="relative p-5 sm:p-10">
          <div class="rounded-[10px] bg-white p-6 shadow-[0_30px_70px_-30px_rgba(15,23,42,0.5)] ring-1 ring-slate-900/[0.06] sm:p-7" data-calc>
            <div class="text-[13px] text-slate-500">If the team you refer chooses</div>
            <div class="mt-3 inline-flex rounded-full bg-slate-100 p-1 ring-1 ring-slate-200/70">
              {plans.map((p, i) => (
                <button type="button" data-plan={p.id} data-earn={p.price} data-save={save(p.price)} aria-pressed={i === 1 ? 'true' : 'false'} class="h-9 rounded-full px-4 text-[14px] text-slate-500 transition-colors aria-pressed:bg-white aria-pressed:font-medium aria-pressed:text-slate-900 aria-pressed:shadow-sm">{p.name}</button>
              ))}
            </div>
            <div class="mt-8 grid grid-cols-2 gap-6">
              <div>
                <div class="text-[13px] text-slate-400">You earn</div>
                <div class="mt-1 text-[44px] font-medium tracking-[-0.05em] leading-none text-slate-900">$<span data-out="earn">{plans[1].price}</span></div>
                <div class="mt-2 text-[13px] text-slate-400">in account credit</div>
              </div>
              <div>
                <div class="text-[13px] text-slate-400">They save</div>
                <div class="mt-1 text-[44px] font-medium tracking-[-0.05em] leading-none text-slate-900">$<span data-out="save">{save(plans[1].price)}</span></div>
                <div class="mt-2 text-[13px] text-slate-400">over three months</div>
              </div>
            </div>
            <div class="mt-7 flex items-center justify-between rounded-md bg-slate-50 px-4 py-3 ring-1 ring-slate-200">
              <span class="truncate font-mono text-[13px] text-slate-600">app.warmbly.com/auth/register?ref=YOURCODE</span>
              <Icon name="link" size={14} class="shrink-0 text-slate-400" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- THE PAGE: Settings > Refer & earn, as the owner sees it. -->
  <section class="container-page pb-20 md:pb-28">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-20">
      <h2 class="text-[30px] md:text-[44px] font-medium tracking-[-0.04em] leading-[1.08]"><span class="text-slate-400">Your link.</span> <span class="text-slate-900">One page in Settings.</span></h2>
      <p class="max-w-xl text-[16px] md:text-[18px] leading-[1.6] text-slate-500">Settings, Refer &amp; earn holds your link and code, the credit you have waiting, and every team you referred with where it is: pending, qualified or rewarded.</p>
    </div>
    <div class="mt-12 md:mt-16"><SettingsScene /></div>
  </section>

  <!-- STEPS: three scenes, one per step. -->
  <Rule />
  <section class="container-page py-20 md:py-28">
    <h2 class="text-[30px] md:text-[44px] font-medium tracking-[-0.04em] leading-[1.08] text-slate-900"><span class="text-slate-400">How it works.</span> Three steps, nothing to claim.</h2>
    <ol class="mt-12 md:mt-16 grid gap-x-3 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
      {steps.map((s, i) => (
        <li class={i === 2 ? 'md:col-span-2 lg:col-span-1' : ''}>
          {i === 0 && <ShareStep />}
          {i === 1 && <CheckoutStep />}
          {i === 2 && <CreditStep />}
          <div class="mt-6 flex items-baseline gap-3">
            <span class="font-mono text-[13px] text-slate-400">0{i + 1}</span>
            <h3 class="text-[21px] md:text-[23px] tracking-[-0.02em] text-slate-900">{s.t}</h3>
          </div>
          <p class="mt-2 max-w-md text-[16px] leading-[1.55] text-slate-500">{s.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- TERMS: the rules beside the window they describe. -->
  <Rule />
  <section class="container-page py-20 md:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1fr)] lg:gap-16">
      <div>
        <h2 class="text-[30px] md:text-[44px] font-medium tracking-[-0.04em] leading-[1.08] text-slate-900"><span class="text-slate-400">The fine print.</span> Kept short.</h2>
        <dl class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
          {terms.map((t) => (
            <div class="py-5">
              <dt class="text-[17px] font-medium text-slate-900">{t.t}</dt>
              <dd class="mt-1.5 text-[15px] leading-[1.6] text-slate-500">{t.d}</dd>
            </div>
          ))}
        </dl>
      </div>
      <SettleScene />
    </div>
  </section>

  <Rule />
  <Faq items={faq} title="Referrals, answered." />

  <CTA photo="sheer-peach" title="Share Warmbly with a team you know." description="Your link is waiting under Settings, Refer & earn." primaryLabel="Get your link" primaryHref={referralHref} secondaryLabel="Start free" secondaryHref="https://app.warmbly.com/auth/register" />
</Layout>

<script>
  const calc = document.querySelector<HTMLElement>('[data-calc]');
  const buttons = [...(calc?.querySelectorAll<HTMLButtonElement>('[data-plan]') ?? [])];
  buttons.forEach((b) => b.addEventListener('click', () => {
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const earn = calc?.querySelector('[data-out="earn"]');
    const save = calc?.querySelector('[data-out="save"]');
    if (earn) earn.textContent = b.dataset.earn ?? '';
    if (save) save.textContent = b.dataset.save ?? '';
  }));
</script>
