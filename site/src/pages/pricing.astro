<script>
  import { calc, CLIENTS_MAX, CLIENTS_MIN, type Billing, type CalcPlan, type RegularPlan } from '../lib/agencyCalc';

  // Monthly and yearly prices, the notes under them, and the switch itself.
  const root = document.querySelector<HTMLElement>('[data-billing-toggle]');
  const buttons = [...(root?.querySelectorAll<HTMLButtonElement>('[data-billing]') ?? [])];
  let mode: Billing = 'annual';

  // Cost per client: the count control and every figure under it.
  const calcRoot = document.querySelector<HTMLElement>('[data-client-calc]');
  const calcPlans: CalcPlan[] = JSON.parse(calcRoot?.dataset.plans ?? '[]');
  const regularPlans: RegularPlan[] = JSON.parse(calcRoot?.dataset.regular ?? '[]');
  const input = calcRoot?.querySelector<HTMLInputElement>('[data-calc-input]');
  const steps = [...(calcRoot?.querySelectorAll<HTMLButtonElement>('[data-calc-step]') ?? [])];
  const renderCalc = (announce: boolean) => {
    if (!calcRoot || !input) return;
    const n = Math.min(CLIENTS_MAX, Math.max(CLIENTS_MIN, Number(input.value) || CLIENTS_MIN));
    const noun = n === 1 ? 'client' : 'clients';
    input.value = String(n);
    input.setAttribute('aria-valuetext', `${n} ${noun}`);
    calcRoot.querySelector('[data-calc-count]')!.textContent = String(n);
    calcRoot.querySelector('[data-calc-count-label]')!.textContent = noun;
    calcRoot.querySelector('[data-calc-rate]')!.textContent = mode === 'annual' ? 'at the yearly rate' : 'billed monthly';
    steps.forEach((b) => { b.disabled = Number(b.dataset.calcStep) < 0 ? n <= CLIENTS_MIN : n >= CLIENTS_MAX; });
    const results = calcPlans.map((p, i) => {
      const r = calc(p, regularPlans, n, mode);
      const field = (k: string) => calcRoot.querySelector<HTMLElement>(`[data-calc-plan="${i}"][data-calc="${k}"]`);
      (['perClient', 'poolEach', 'regularLabel', 'regularTotal', 'agencyTotal', 'verdict'] as const).forEach((k) => {
        const el = field(k);
        if (el) el.textContent = r[k];
      });
      const row = field('verdict-row');
      row?.classList.toggle('text-emerald-700', r.saving);
      row?.classList.toggle('text-slate-500', !r.saving);
      row?.querySelector('svg')?.classList.toggle('hidden', !r.saving);
      field('regularTotal')?.classList.toggle('line-through', r.saving);
      return `${p.name} ${r.perClient} per client`;
    });
    if (announce) calcRoot.querySelector('[data-calc-live]')!.textContent = `${n} ${noun}: ${results.join(', ')} a month.`;
  };
  input?.addEventListener('input', () => renderCalc(true));
  steps.forEach((b) => b.addEventListener('click', () => {
    if (!input) return;
    input.value = String(Number(input.value) + Number(b.dataset.calcStep));
    renderCalc(true);
  }));

  const apply = (next: Billing) => {
    mode = next;
    buttons.forEach((b) => {
      const on = b.dataset.billing === mode;
      b.classList.toggle('bg-white', on);
      b.classList.toggle('shadow-sm', on);
      b.classList.toggle('font-medium', on);
      b.classList.toggle('text-slate-900', on);
      b.classList.toggle('text-slate-500', !on);
      b.setAttribute('aria-pressed', String(on));
    });
    document.querySelectorAll<HTMLElement>('.plan-price, .plan-note').forEach((el) => {
      const v = el.dataset[mode];
      if (v != null) el.textContent = v;
    });
    renderCalc(false);
  };
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.billing as Billing)));
  // A restored form value (back navigation) can differ from the rendered default.
  renderCalc(false);
</script>
