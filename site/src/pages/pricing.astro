---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import Rule from '../components/page/Rule.astro';
import Faq from '../components/page/Faq.astro';
import WarmupScene from '../components/scenes/WarmupScene.astro';
import InboxScene from '../components/scenes/InboxScene.astro';
import InstallScene from '../components/scenes/InstallScene.astro';
import BillingScene from '../components/scenes/pricing/BillingScene.astro';
import CloudPoolScene from '../components/scenes/pricing/CloudPoolScene.astro';
import MailboxLimitScene from '../components/scenes/pricing/MailboxLimitScene.astro';
import PlacementScene from '../components/scenes/pricing/PlacementScene.astro';
import SuppressionScene from '../components/scenes/pricing/SuppressionScene.astro';
import { calc, CLIENTS_DEFAULT, CLIENTS_MAX, CLIENTS_MIN, DAYS_A_MONTH, type CalcPlan, type RegularPlan } from '../lib/agencyCalc';

// Prices and volumes mirror web/src/lib/plans.ts.
const plans = [
  { name: 'Starter', price: 29, annual: 23, perDay: 150, sends: '150', href: 'https://app.warmbly.com/auth/register?plan=starter', summary: 'For small teams starting cold outreach.' },
  { name: 'Grow', price: 89, annual: 71, perDay: 3_000, sends: '3,000', href: 'https://app.warmbly.com/auth/register?plan=grow', summary: 'For teams sending from many mailboxes.' },
  { name: 'Business', price: 329, annual: 263, perDay: 15_000, sends: '15,000', href: 'https://app.warmbly.com/auth/register?plan=business', summary: 'For established teams at real volume.', featured: true },
  { name: 'Enterprise', price: null, annual: null, perDay: null, sends: '15,000+', href: '/contact/?topic=sales', summary: 'Custom volume, contract and support.' },
];

// Agency plans: one plan for every client workspace, sending from a shared monthly pool.
const agencyPlans = [
  { name: 'Agency', price: 249, annual: 199, pool: 150_000, poolLabel: '150,000', href: 'https://app.warmbly.com/auth/register?plan=agency', summary: 'For agencies running outreach for a handful of clients or dozens.', features: ['Unlimited clients, no per-client fee', 'The CRM, the API and signed webhooks in every client workspace', 'Staff added to every client', 'Your logo, colour and portal domain on client pages', '$10 of shared AI each month', 'Top-up packs: 50,000 sends for $85'] },
  { name: 'Agency Pro', price: 599, annual: 479, pool: 500_000, poolLabel: '500,000', href: 'https://app.warmbly.com/auth/register?plan=agency-pro', summary: 'For agencies that sell outreach under their own brand.', featured: true, features: ['Everything in Agency', 'Team roles and the audit log in every client workspace', 'No “Powered by Warmbly” on client pages', 'Sending kept apart from other customers', '$30 of shared AI each month', 'Top-up packs: 50,000 sends for $60'] },
  { name: 'Agency Scale', price: null, annual: null, pool: null, poolLabel: '1,000,000+', href: '/contact/?topic=sales', summary: 'For agencies sending at the largest volumes.', features: ['Everything in Agency Pro', 'Pool sized to your volume', 'Contract and support'] },
];
const calcPlans: CalcPlan[] = agencyPlans.flatMap((p) =>
  p.price !== null && p.annual !== null && p.pool !== null ? [{ name: p.name, price: p.price, annual: p.annual, pool: p.pool }] : [],
);
// What a client would otherwise buy: the self-serve plans with a daily cap.
const regularPlans: RegularPlan[] = plans.flatMap((p) =>
  p.price !== null && p.annual !== null && p.perDay !== null ? [{ name: p.name, price: p.price, annual: p.annual, perDay: p.perDay }] : [],
);

// What every agency plan carries, each line from docs/content/docs/guides/agencies.mdx.
const agencyIncluded = [
  { icon: 'users', t: 'Unlimited client workspaces', d: 'No limit on clients and no fee per client. Each keeps its own mailboxes, contacts, campaigns and inbox.' },
  { icon: 'contact', t: 'Staff in every client', d: 'Your team is added to each client as it joins, with a role that follows their agency role.' },
  { icon: 'layers', t: 'One shared monthly pool', d: 'Every client sends from the same pool, so a quiet week for one is volume another can use.' },
  { icon: 'filter', t: 'Caps per client', d: 'Hold any client to a monthly share of the pool or of the AI balance, or pause it with a cap of 0.' },
  { icon: 'spark', t: 'Shared AI balance', d: 'Clients spend their own balance first, then the agency’s, and you can move balance to a client.' },
  { icon: 'flame', t: 'Warmup in the premium pool', d: 'Every mailbox warms on the same ramp and health rules, and warmup never draws on the send pool.' },
  { icon: 'link', t: 'Client connect links', d: 'Clients connect their own mailboxes from a link, so their passwords never reach you.' },
  { icon: 'chart', t: 'Shareable client reports', d: 'Branded report links and embeds, or a summary emailed to the client every week or month.' },
  { icon: 'inbox', t: 'A cross-client inbox', d: 'Conversations from every client in one list, filtered by client, unread, needs reply or positive.' },
  { icon: 'shuffle', t: 'Copy campaigns between clients', d: 'Build a campaign once and copy it, with its steps, settings and templates, to up to 10 clients at a time.' },
  { icon: 'globe', t: 'A portal in your own look', d: 'Your colours, font, logo and sign-in page on a client dashboard at your own domain, on connect links and reports, and in embeds for your site.' },
  { icon: 'key', t: 'Agency API keys', d: 'One key reaches every client, so one integration serves them all without a key per workspace.' },
];

const Y = '✓', N = '–';
const matrix = [
  {
    group: 'Sending',
    rows: [
      ['Cold emails a day', '150', '3,000', '15,000', '15,000+'],
      ['Mailboxes', 'Unlimited', 'Unlimited', 'Unlimited', 'Unlimited'],
      ['Limit per mailbox', '50 a day, adjustable', '50 a day, adjustable', '50 a day, adjustable', '50 a day, adjustable'],
      ['A sign-in address no other customer uses', N, N, Y, Y],
    ],
  },
  {
    group: 'Deliverability',
    rows: [
      ['Warmup in the premium pool', 'Unlimited', 'Unlimited', 'Unlimited', 'Unlimited'],
      ['Inbox placement tests', Y, Y, Y, Y],
      ['Suppression and one-click unsubscribe', Y, Y, Y, Y],
    ],
  },
  {
    group: 'Outreach',
    rows: [
      ['Sequences with branching', Y, Y, Y, Y],
      ['Unified inbox with reply labels', Y, Y, Y, Y],
      ['Automations', Y, Y, Y, Y],
    ],
  },
  {
    group: 'Team and platform',
    rows: [
      ['CRM with pipelines, deals and tasks', N, Y, Y, Y],
      ['API and signed webhooks', N, Y, Y, Y],
      ['Team roles and audit log', N, N, Y, Y],
      ['Single sign-on', N, N, N, Y],
      ['Support', 'Community', 'Email', 'Priority', 'Dedicated'],
    ],
  },
];

const billingFacts: [string, string][] = [
  ['Switching', 'Moving to another plan is prorated and takes effect straight away.'],
  ['Cancelling', 'The plan stays active to the end of the period you paid for. Mailboxes, warmup and settings are kept.'],
  ['One limit', 'Need more of one thing without changing plan? Ask from Settings > Limits.'],
  ['Invoices', 'Your legal name and tax ID go on every invoice, and PDF receipts are in the billing portal.'],
];

const h2 = 'text-[32px] md:text-[48px] font-medium tracking-[-0.045em] leading-[1.04] text-slate-900';
const lead = 'text-[17px] md:text-[19px] leading-[1.55] text-slate-500';
const title = 'mt-6 text-[21px] md:text-[23px] tracking-[-0.02em] text-slate-900';
const body = 'mt-2 max-w-xl text-[16px] md:text-[17px] leading-[1.55] text-slate-500';
const link = 'group mt-4 inline-flex items-center gap-2 text-[16px] text-[color:var(--brand)] hover:text-[color:var(--brand-strong)]';

const faq: [string, string][] = [
  ['Do you charge per email sent?', 'No. Each plan includes a daily send budget. Unused volume doesn’t carry over to the next day.'],
  ['Is warmup charged separately?', 'No. Warmup is unlimited on every paid plan and runs in the premium pool.'],
  ['Is there really no mailbox limit?', 'Mailboxes are unlimited on every paid plan under fair use: one mailbox for every email a day your plan includes, so Grow holds 3,000 and Business 15,000. If you need more, ask from the connect dialog and we usually answer within a business day.'],
  ['Is there a free trial?', 'Yes. A new workspace gets 14 days free with no card: two mailboxes warming in the free pool, 20 cold emails a day, the unified inbox and campaigns. Each owner gets one trial, on their first workspace. After it, connecting and warming mailboxes needs a paid plan, from $29 a month, and nothing you set up is deleted. Workspaces that already had the free plan keep it.'],
  ['Can I pay for warmup only?', 'Not any more. The Warmup plan is no longer sold, and workspaces already on it keep it while they stay subscribed. Every paid plan includes unlimited warmup in the premium pool.'],
  ['What does self-hosting cost?', 'Nothing. Warmbly is Apache 2.0, free to run on your own servers and fully functional on its own. Its warmup only pairs the mailboxes on your own instance, with no shared pool, and self-hosted instances do not link to the Warmbly Cloud pool. If deliverability is what you need, Warmbly Cloud is the better choice. Self-hosting suits experienced operators who want to own the whole stack: Warmbly does not support self-hosted instances, and help comes from the community on Discord.'],
  ['Is there a charge per seat?', 'No. Add as many teammates as you like. Roles and the audit log come with Business.'],
  ['Do you charge per client for agencies?', 'No. An agency plan covers every client workspace, with no limit on clients. Clients share one monthly send pool instead of a daily cap each, and you can add 50,000-send top-up packs when it runs low.'],
  ['Can I pay yearly?', 'Yes, with 20% off. Use the switch at the top of this page.'],
  ['Can I buy as a business?', 'Yes. Add your legal name and tax ID at checkout. They appear on your invoices, and reverse charge is applied where the rules allow it. Taxes are calculated from your billing address and shown before you pay.'],
  ['What is your refund policy?', 'A full refund within 14 days of a paid purchase if Warmbly didn’t work for you.'],
  ['Do you have startup pricing?', '50% off Grow for a year for pre-seed and seed companies from YC, Antler, EF, Techstars and similar programmes.'],
];
---
<Layout
  title="Pricing: Unlimited Mailboxes and Warmup | Warmbly"
  description="Warmbly pricing from $29 a month with unlimited mailboxes and unlimited warmup on every paid plan. Free to self-host, and 20% off yearly."
>
  <!-- HEADER: the promise and the billing switch. -->
  <section class="container-page pt-14 md:pt-24">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <div class="max-w-3xl">
        <div class="text-[14px] text-slate-500">Pricing</div>
        <h1 class="mt-4 text-[40px] sm:text-[52px] md:text-[64px] font-medium tracking-[-0.05em] leading-[1.02] text-slate-900">
          Pay for the email you send.
        </h1>
        <p class="mt-6 max-w-2xl text-[17px] md:text-[19px] leading-[1.55] text-slate-500">
          Start with a 14-day free trial, no card needed. Every paid plan has unlimited mailboxes and unlimited warmup, and plans differ in how much cold email you can send a day and in what your team needs around it.
        </p>
      </div>
      <div class="inline-flex items-center gap-3" data-billing-toggle>
        <div class="relative inline-flex rounded-full bg-slate-100 p-1 text-[14px] ring-1 ring-slate-200/70">
          <button type="button" data-billing="monthly" class="h-9 rounded-full px-5 text-slate-500 transition-colors">Monthly</button>
          <button type="button" data-billing="annual" class="h-9 rounded-full bg-white px-5 font-medium text-slate-900 shadow-sm transition-colors">Yearly</button>
        </div>
        <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[12px] font-medium text-emerald-700 ring-1 ring-emerald-100">Save 20%</span>
      </div>
    </div>
  </section>

  <!-- THE TABLE: plans across the top, everything they include below. -->
  <section class="container-page pt-12 md:pt-16 pb-20 md:pb-28">
    <!-- On a phone the plans stack as cards, and the table below only compares. -->
    <div class="grid gap-3 sm:grid-cols-2 md:hidden">
      {plans.map((p) => (
        <div class={`rounded-[6px] bg-white p-5 ring-1 ${p.featured ? 'ring-slate-900' : 'ring-slate-200'}`}>
          <div class="flex items-center gap-2">
            <span class="text-[17px] font-medium text-slate-900">{p.name}</span>
            {p.featured && <span class="rounded-full bg-slate-900 px-2 py-0.5 text-[11px] font-medium text-white">Most popular</span>}
          </div>
          <p class="mt-1 text-[13.5px] text-slate-500">{p.summary}</p>
          <div class="mt-4 flex items-baseline gap-1.5">
            {p.price !== null ? (
              <>
                <span class="text-[34px] font-medium tracking-[-0.04em] leading-none text-slate-900">$<span class="plan-price" data-monthly={p.price} data-annual={p.annual}>{p.annual}</span></span>
                <span class="text-[13px] text-slate-400">/ month, <span class="plan-note" data-monthly="billed monthly" data-annual="billed yearly">billed yearly</span></span>
              </>
            ) : (
              <span class="text-[34px] font-medium tracking-[-0.04em] leading-none text-slate-900">Custom</span>
            )}
          </div>
          <div class="mt-2 text-[14px] text-slate-600"><span class="font-medium text-slate-900">{p.sends}</span> cold emails a day{p.perDay !== null && <span class="text-slate-400">, up to {(p.perDay * DAYS_A_MONTH).toLocaleString('en-US')} a month</span>}</div>
          <a href={p.href} class={`mt-5 inline-flex h-10 w-full items-center justify-center rounded-full text-[14px] font-medium transition-colors ${p.featured ? 'bg-slate-900 text-white hover:bg-slate-800' : 'bg-white text-slate-900 ring-1 ring-slate-200 hover:bg-slate-50'}`}>
            {p.price !== null ? 'Get started' : 'Talk to sales'}
          </a>
        </div>
      ))}
    </div>
    <div class="mt-10 mb-3 flex items-baseline justify-between text-[13px] text-slate-400 md:hidden"><span class="text-[15px] font-medium text-slate-900">Compare plans</span>Swipe for every plan</div>
    <div class="overflow-x-auto overscroll-x-contain rounded-[6px] bg-white ring-1 ring-slate-200">
      <table class="w-full min-w-[640px] md:min-w-[880px] border-collapse text-left">
        <thead>
          <tr class="align-top">
            <th class="sticky left-0 z-[1] w-[30%] bg-white p-4 md:p-6 text-[13px] font-normal text-slate-400 md:static"><span class="hidden md:inline">Compare plans</span></th>
            {plans.map((p) => (
              <th class={`p-4 md:p-6 font-normal ${p.featured ? 'bg-slate-50 shadow-[inset_0_3px_0_#0f172a]' : ''}`}>
                <div class="flex items-center gap-2">
                  <span class="text-[17px] font-medium text-slate-900">{p.name}</span>
                  {p.featured && <span class="rounded-full bg-slate-900 px-2 py-0.5 text-[11px] font-medium text-white">Most popular</span>}
                </div>
                <div class="hidden md:block">
                <p class="mt-1 min-h-[40px] text-[13px] leading-snug text-slate-500">{p.summary}</p>
                <div class="mt-4 flex items-baseline gap-1 whitespace-nowrap">
                  {p.price !== null ? (
                    <>
                      <span class="text-[36px] font-medium tracking-[-0.04em] leading-none text-slate-900">$<span class="plan-price" data-monthly={p.price} data-annual={p.annual}>{p.annual}</span></span>
                      <span class="text-[13px] text-slate-400">/ month</span>
                    </>
                  ) : (
                    <span class="text-[36px] font-medium tracking-[-0.04em] leading-none text-slate-900">Custom</span>
                  )}
                </div>
                <div class="mt-1 h-5 text-[12.5px] text-slate-400">
                  {p.price !== null ? <span class="plan-note" data-monthly="billed monthly" data-annual="billed yearly">billed yearly</span> : 'volume-based'}
                </div>
                <a href={p.href} class={`mt-4 inline-flex h-10 w-full items-center justify-center rounded-full text-[14px] font-medium transition-colors ${p.featured ? 'bg-slate-900 text-white hover:bg-slate-800' : 'bg-white text-slate-900 ring-1 ring-slate-200 hover:bg-slate-50'}`}>
                  {p.price !== null ? 'Get started' : 'Talk to sales'}
                </a>
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {matrix.map((section) => (
            <>
              <tr>
                <td colspan="5" class="border-t border-slate-200 px-4 md:px-6 pb-2 pt-7 text-[13px] text-slate-400"><span class="sticky left-4">{section.group}</span></td>
              </tr>
              {section.rows.map((row) => (
                <tr class="transition-colors hover:bg-slate-50/60">
                  <td class="sticky left-0 z-[1] border-t border-slate-100 bg-white px-4 md:px-6 py-3.5 text-[14px] md:text-[14.5px] text-slate-700 md:static">{row[0]}</td>
                  {row.slice(1).map((cell, i) => (
                    <td class={`border-t border-slate-100 px-4 md:px-6 py-3.5 text-[14.5px] ${plans[i].featured ? 'bg-slate-50' : ''}`}>
                      {cell === Y ? <Icon name="check" size={15} class="text-slate-900" /> : cell === N ? <span class="text-slate-300">–</span> : <span class="text-slate-900">{cell}</span>}
                    </td>
                  ))}
                </tr>
              ))}
            </>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-[13.5px] text-slate-400">Prices in US dollars. Taxes are calculated from your billing address and shown before you pay.</p>
  </section>

  <!-- AGENCIES: one plan for every client, sending from a shared monthly pool. -->
  <Rule />
  <section id="agencies" class="container-page py-20 md:py-28 scroll-mt-24">
    <div class="grid gap-6 lg:grid-cols-[1.15fr_1fr] lg:items-end lg:gap-16">
      <h2 class={h2}><span class="text-slate-400">For agencies.</span> Every client on one plan.</h2>
      <p class={lead}>No per-client fees and no limit on clients. Instead of a daily cap per workspace, every client sends from one monthly pool, so a quiet week for one client is volume another can use. Each mailbox still keeps its own daily cap, spacing and warmup ramp.</p>
    </div>
    <div class="mt-12 md:mt-16 grid gap-3 md:grid-cols-3">
      {agencyPlans.map((p) => (
        <div class={`flex flex-col rounded-[6px] bg-white p-6 ring-1 ${p.featured ? 'ring-slate-900' : 'ring-slate-200'}`}>
          <div class="flex items-center gap-2">
            <span class="text-[17px] font-medium text-slate-900">{p.name}</span>
            {p.featured && <span class="rounded-full bg-slate-900 px-2 py-0.5 text-[11px] font-medium text-white">Full white-label</span>}
          </div>
          <p class="mt-1 min-h-[40px] text-[13.5px] leading-snug text-slate-500">{p.summary}</p>
          <div class="mt-4 flex items-baseline gap-1.5">
            {p.price !== null ? (
              <>
                <span class="text-[36px] font-medium tracking-[-0.04em] leading-none text-slate-900">$<span class="plan-price" data-monthly={p.price} data-annual={p.annual}>{p.annual}</span></span>
                <span class="text-[13px] text-slate-400">/ month, <span class="plan-note" data-monthly="billed monthly" data-annual="billed yearly">billed yearly</span></span>
              </>
            ) : (
              <span class="text-[36px] font-medium tracking-[-0.04em] leading-none text-slate-900">Custom</span>
            )}
          </div>
          <div class="mt-2 text-[14px] text-slate-600"><span class="font-medium text-slate-900">{p.poolLabel}</span> sends a month, shared by every client</div>
          <ul class="mt-5 flex-1 space-y-2">
            {p.features.map((f) => (
              <li class="flex gap-2 text-[14px] leading-snug text-slate-600"><Icon name="check" size={15} class="mt-0.5 shrink-0 text-slate-900" />{f}</li>
            ))}
          </ul>
          <a href={p.href} class={`mt-6 inline-flex h-10 w-full items-center justify-center rounded-full text-[14px] font-medium transition-colors ${p.featured ? 'bg-slate-900 text-white hover:bg-slate-800' : 'bg-white text-slate-900 ring-1 ring-slate-200 hover:bg-slate-50'}`}>
            {p.price !== null ? 'Get started' : 'Talk to sales'}
          </a>
        </div>
      ))}
    </div>
    <p class="mt-4 text-[13.5px] text-slate-400">Top-up packs are one-off and count for the current billing period. <a href="/use-cases/agencies/" class="text-slate-600 underline decoration-slate-300 underline-offset-4 hover:decoration-slate-900">How agencies use Warmbly</a>.</p>

    <!-- COST PER CLIENT: the plan price spread over the client count, beside a regular plan per client. -->
    <div class="mt-16 md:mt-20 rounded-[6px] bg-white ring-1 ring-slate-200" data-client-calc data-plans={JSON.stringify(calcPlans)} data-regular={JSON.stringify(regularPlans)}>
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6 border-b border-slate-200 p-5 md:p-8">
        <div class="max-w-md">
          <h3 class="text-[21px] md:text-[23px] tracking-[-0.02em] text-slate-900">Cost per client</h3>
          <p class="mt-1.5 text-[15px] leading-[1.55] text-slate-500">The more clients you run, the less each one costs. Prices follow the monthly and yearly switch at the top of the page.</p>
        </div>
        <div class="w-full sm:w-auto">
          <label for="client-count" class="flex items-baseline justify-between gap-4 text-[13px] text-slate-500">
            <span>Clients</span>
            <span class="text-[15px] text-slate-900"><span class="font-medium tabular-nums" data-calc-count>{CLIENTS_DEFAULT}</span> <span data-calc-count-label>clients</span></span>
          </label>
          <div class="calc-controls mt-2 flex items-center gap-2">
            <button type="button" data-calc-step="-1" aria-label="One client fewer" class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-white text-[18px] leading-none text-slate-700 ring-1 ring-slate-200 transition-colors hover:bg-slate-50 disabled:text-slate-300 disabled:hover:bg-white">−</button>
            <input id="client-count" type="range" min={CLIENTS_MIN} max={CLIENTS_MAX} step="1" value={CLIENTS_DEFAULT} aria-valuetext={`${CLIENTS_DEFAULT} clients`} data-calc-input class="h-9 min-w-0 flex-1 cursor-pointer accent-slate-900 sm:w-64 sm:flex-none" />
            <button type="button" data-calc-step="1" aria-label="One client more" class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-white text-[18px] leading-none text-slate-700 ring-1 ring-slate-200 transition-colors hover:bg-slate-50 disabled:text-slate-300 disabled:hover:bg-white">+</button>
          </div>
          <noscript><style is:inline>.calc-controls{display:none}</style></noscript>
          <p class="sr-only" aria-live="polite" data-calc-live></p>
        </div>
      </div>
      <div class="grid divide-y divide-slate-200 md:grid-cols-2 md:divide-x md:divide-y-0">
        {calcPlans.map((p, i) => {
          const r = calc(p, regularPlans, CLIENTS_DEFAULT, 'annual');
          return (
            <div class="p-5 md:p-8">
              <div class="text-[15px] font-medium text-slate-900">{p.name}</div>
              <div class="mt-3 flex flex-wrap items-baseline gap-x-2 gap-y-1">
                <span class="text-[40px] md:text-[48px] font-medium tracking-[-0.045em] leading-none tabular-nums text-slate-900" data-calc-plan={i} data-calc="perClient">{r.perClient}</span>
                <span class="text-[14px] text-slate-500">per client a month</span>
              </div>
              <div class="mt-2 text-[14px] text-slate-500"><span class="font-medium tabular-nums text-slate-900" data-calc-plan={i} data-calc="poolEach">{r.poolEach}</span> shared sends a month per client, on average</div>
              <dl class="mt-6 divide-y divide-slate-100 border-y border-slate-100 text-[14.5px]">
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-slate-500" data-calc-plan={i} data-calc="regularLabel">{r.regularLabel}</dt>
                  <dd class={`tabular-nums text-slate-400 decoration-slate-300 ${r.saving ? 'line-through' : ''}`} data-calc-plan={i} data-calc="regularTotal">{r.regularTotal}</dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 py-2.5">
                  <dt class="text-slate-900">{p.name} for every client</dt>
