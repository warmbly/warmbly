---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import SectionIntro from '../components/page/SectionIntro.astro';
import Rule from '../components/page/Rule.astro';
import Faq from '../components/page/Faq.astro';
import BrandMark from '../components/page/BrandMark.astro';
import HeroScene from '../components/scenes/crm/HeroScene.astro';
import ContactScene from '../components/scenes/crm/ContactScene.astro';
import TasksScene from '../components/scenes/crm/TasksScene.astro';
import MeetingsScene from '../components/scenes/crm/MeetingsScene.astro';
import ImportScene from '../components/scenes/crm/ImportScene.astro';
import CrmModeScene from '../components/scenes/crm/CrmModeScene.astro';

// Behaviour from docs/content/docs/guides/contacts-crm.mdx, meetings.mdx,
// hubspot.mdx and pipedrive.mdx.

const steps = [
  { t: 'Upload', d: 'CSV, TSV or Excel, up to 50,000 rows. Or a Google Sheet you sync when you choose.' },
  { t: 'Map columns', d: 'How full each column is and what is in it. Headers you used before map themselves.' },
  { t: 'Review', d: 'One line: what is added, updated, merged, and what cannot be imported and why.' },
  { t: 'Import', d: 'Runs on the server with live progress. Failed rows come back as a file to fix.' },
];

const faq: [string, string][] = [
  ['Do I need a separate CRM?', 'Not to start. Warmbly has contacts, deals, pipelines, tasks and meetings built in. If your team already lives in HubSpot or Pipedrive, switch to that mode and Warmbly reads and writes your CRM’s own records instead.'],
  ['Can a reply create a deal by itself?', 'Yes. Campaigns can create and move deals with Create deal and Move deal stage actions, so a positive reply can open a deal without anyone typing it in.'],
  ['What creates a follow-up task?', 'A reply from a person: interested, a question, an unclear answer or a decline each open a task by default, due in 24 hours and assigned to the owner of the mailbox that received it. Out-of-office and other automated replies don’t, unless you ask for them.'],
  ['How do meetings get in?', 'Connect Calendly or Cal.com with a webhook URL and every booking, reschedule and cancellation appears on the Meetings page. You can also log a call by hand.'],
  ['Where did a contact come from?', 'Every contact keeps its first-touch source, whether a campaign, an import, a form, a sheet sync, the API or an automation, and that never changes however the contact is edited later.'],
];

const cardTitle = 'mt-6 text-[21px] md:text-[23px] tracking-[-0.02em] text-slate-900';
const cardBody = 'mt-2 max-w-xl text-[16px] md:text-[17px] leading-[1.55] text-slate-500';
const link = 'group mt-6 inline-flex items-center gap-2 text-[17px] md:text-[18px] text-[color:var(--brand)] hover:text-[color:var(--brand-strong)]';
---
<Layout
  title="CRM for Cold Email: Deals, Tasks and Meetings | Warmbly"
  description="A CRM built into your cold email: every send, open, click and reply on one contact timeline, deals opened from positive replies, follow-up tasks, meetings from Calendly and Cal.com, and HubSpot or Pipedrive sync."
>
  <!-- HERO: headline and lead side by side, then the pipeline in the app. -->
  <section class="container-page pt-14 md:pt-24">
    <div class="grid gap-8 lg:grid-cols-[1.15fr_1fr] lg:items-end lg:gap-16">
      <div>
        <div class="text-[14px] text-slate-500">CRM</div>
        <h1 class="mt-4 text-[40px] sm:text-[56px] md:text-[68px] font-medium tracking-[-0.05em] leading-[1.0] text-slate-900">
          From the first email to a booked meeting, in one place.
        </h1>
      </div>
      <div class="lg:pb-2">
        <p class="text-[17px] md:text-[19px] leading-[1.55] text-slate-500">
          Every send, open, click and reply lands on the contact’s timeline. A positive reply can open the deal and a follow-up task on its own, and bookings from Calendly or Cal.com arrive by themselves.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="https://app.warmbly.com/auth/register" class="inline-flex h-11 items-center gap-2 rounded-full bg-slate-900 px-5 text-[15px] font-medium text-white transition-colors hover:bg-slate-800">
            Start free <Icon name="arrowRight" size={14} />
          </a>
          <a href="https://docs.warmbly.com/guides/contacts-crm/" class="inline-flex h-11 items-center rounded-full border border-slate-200 px-5 text-[15px] text-slate-800 transition-colors hover:border-slate-300 hover:bg-slate-50">
            Read the guide
          </a>
        </div>
      </div>
    </div>
    <div class="mt-14 md:mt-20">
      <HeroScene />
    </div>
    <div class="mt-5 grid gap-3 text-[14px] text-slate-400 md:grid-cols-3">
      <p>Name your stages and drag deals between them, or let campaigns create and move them.</p>
      <p>Totals are real sums over every deal, not just the ones loaded on screen.</p>
      <p>The board is live: a deal a teammate is moving carries a coloured ring for everyone.</p>
    </div>
  </section>

  <!-- CONTACT: copy left, the drawer's timeline right. -->
  <section class="container-page py-20 md:py-32">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.25fr] lg:gap-16">
      <SectionIntro lead="Contacts." title="One timeline for everything a person did." text="The Activity tab lists every email sent, opened, clicked and replied to, with the campaign, step and mailbox, plus meetings, notes and how the contact entered the workspace. Opens name the device and mail app they were read in, and a click names the link and the UTM values it carried.">
        <p class="mt-4 max-w-2xl text-[15px] leading-[1.6] text-slate-400">Opens and clicks made by a privacy proxy or a security scanner carry an auto badge, so you can tell a reader from a machine.</p>
        <a href="https://docs.warmbly.com/guides/contacts-crm/#activity-timeline" class={link}>About the activity timeline<Icon name="arrowRight" size={14} class="transition-transform group-hover:translate-x-0.5" /></a>
      </SectionIntro>
      <ContactScene />
    </div>
  </section>

  <!-- TASKS + MEETINGS: two scenes. -->
  <Rule />
  <section class="container-page py-20 md:py-28">
    <SectionIntro lead="Follow-ups." title="Nothing answered waits in an inbox nobody checks." />
    <div class="mt-12 md:mt-16 grid gap-x-3 gap-y-12 md:grid-cols-2">
      <article>
        <TasksScene />
        <h3 class={cardTitle}>Every real reply becomes a task</h3>
        <p class={cardBody}>The owner of the mailbox that got the reply gets a high-priority task, due in 24 hours. Out-of-office notices are left out unless you want them.</p>
      </article>
      <article>
        <MeetingsScene />
        <h3 class={cardTitle}>Bookings arrive on their own</h3>
        <p class={cardBody}>Connect Calendly or Cal.com with a webhook URL and every booking, reschedule and cancellation lands here and on the contact. Log a call by hand too.</p>
      </article>
    </div>
  </section>

  <!-- IMPORT: wide scene, the four steps under it. -->
  <Rule />
  <section class="container-page py-20 md:py-28">
    <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end lg:gap-16">
      <SectionIntro lead="Importing." title="Bring a messy spreadsheet. Get clean contacts." />
      <p class="max-w-xl text-[16px] md:text-[18px] leading-[1.6] text-slate-500 lg:pb-1">The file is read on the server before anything is written, so you see every column at once and the whole file is checked before you press import. A blank cell never erases a value you already have.</p>
    </div>
    <div class="mt-12 md:mt-16"><ImportScene /></div>
    <ol class="mt-8 grid gap-6 md:grid-cols-4">
      {steps.map((s, i) => (
        <li class="md:border-l md:border-slate-200 md:pl-5 md:first:border-l-0 md:first:pl-0">
          <div class="flex items-center gap-2">
            <span class="flex size-6 items-center justify-center rounded-full bg-slate-900 text-[12px] font-medium text-white">{i + 1}</span>
            <h3 class="text-[16px] font-medium text-slate-900">{s.t}</h3>
          </div>
          <p class="mt-2 text-[14.5px] leading-[1.6] text-slate-500">{s.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- YOUR CRM: scene left, copy right. -->
  <Rule />
  <section class="container-page py-20 md:py-32">
    <div class="grid items-center gap-10 lg:grid-cols-[1.25fr_1fr] lg:gap-16">
      <div class="lg:order-2">
        <SectionIntro lead="Already have a CRM?" title="Use HubSpot or Pipedrive as the source of truth." text="Switch to HubSpot or Pipedrive mode and the deals, pipelines, tasks and notes in Warmbly are your CRM’s own records. Changes are written there first, and anything your CRM refuses is not saved. Your outreach lands on each contact’s timeline there." />
        <div class="mt-8 grid max-w-xl grid-cols-2 gap-3">
          {[
            { name: 'hubspot', label: 'HubSpot', note: 'Deals, pipelines, tasks and notes', href: 'https://docs.warmbly.com/guides/hubspot/' },
            { name: 'pipedrive', label: 'Pipedrive', note: 'Deals, activities and people', href: 'https://docs.warmbly.com/guides/pipedrive/' },
          ].map((c) => (
            <a href={c.href} class="group flex items-center gap-3 rounded-[6px] bg-white p-4 ring-1 ring-slate-200 transition-colors hover:ring-slate-300">
              <BrandMark name={c.name} size={36} />
              <span class="min-w-0">
                <span class="block text-[15px] font-medium text-slate-900">{c.label}</span>
                <span class="block truncate text-[13px] text-slate-500">{c.note}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
      <div class="lg:order-1"><CrmModeScene /></div>
    </div>
  </section>

  <Rule />
  <Faq items={faq} title="The CRM, answered." />

  <CTA photo="frost-blue" title="Turn replies into pipeline." description="Connect a mailbox, send your first campaign, and watch the deals open themselves." />
</Layout>
