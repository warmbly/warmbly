---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import EncryptionFigure from '../components/scenes/trust/EncryptionFigure.astro';
import SecurityScene from '../components/scenes/trust/SecurityScene.astro';
import WorkerFigure from '../components/scenes/trust/WorkerFigure.astro';
import AuditScene from '../components/scenes/trust/AuditScene.astro';

// Technical facts from CLAUDE.md (encryption model, worker networking,
// security invariants, fraud and abuse detection). Posture, subprocessors and
// disclosure commitments are the company's own statements.

const toc = [
  { id: 'posture', t: 'At a glance' },
  { id: 'encryption', t: 'Encryption' },
  { id: 'accounts', t: 'Accounts and sign-in' },
  { id: 'data', t: 'What we store' },
  { id: 'workers', t: 'The worker boundary' },
  { id: 'abuse', t: 'Abuse controls' },
  { id: 'subprocessors', t: 'Subprocessors' },
  { id: 'disclosure', t: 'Reporting a vulnerability' },
];

const posture = [
  { label: 'Open source and auditable', note: 'The backend, workers and dashboard are public.', state: 'shipped' },
  { label: 'TLS 1.2 or later in transit', note: 'Every connection is encrypted on the way.', state: 'shipped' },
  { label: 'Encryption at rest', note: 'A data key per workspace, AES-256-GCM.', state: 'shipped' },
  { label: 'GDPR-aligned handling', note: 'Plain-English privacy policy, data processing terms on request.', state: 'shipped' },
  { label: 'SOC 2 Type II', note: 'Controls in place. The audit window opens with our auditor.', state: 'planned' },
  { label: 'ISO 27001', note: 'Under evaluation. No certification claimed today.', state: 'planned' },
];

const flow = [
  { t: 'Key management service', d: 'The root key never leaves it. It creates a 32-byte data key for each workspace.' },
  { t: 'A key per workspace', d: 'Only the encrypted copy of that key is stored. The plain key is used briefly and cached for a short time.' },
  { t: 'Sealed fields', d: 'Message content and integration tokens are sealed with AES-256-GCM under that key before they are written.' },
];

const signin = [
  'Passwords are hashed with Argon2id and checked against a list of known breached passwords.',
  'Sign-in, sign-up and password reset are protected by a CAPTCHA.',
  'Two-factor codes can only be used once.',
  'Changing your password or signing out other sessions ends those sessions everywhere, including live connections.',
  'Every API response carries strict security headers, including HSTS and a default-deny content policy.',
];

const collect = [
  'Your account: email, name and workspace.',
  'Mailbox credentials, encrypted at rest.',
  'Messages from connected mailboxes, encrypted at rest.',
  'The contacts you upload or sync.',
  'Sending signals: bounces, complaints, replies, opens and clicks.',
  'Billing details, through Stripe.',
];
const never = [
  'Passwords in a form that can be reversed.',
  'Card numbers. Stripe holds the payment details.',
  'What your recipients do outside your own emails.',
  'Message content inside error reports.',
  'Anything shared between workspaces. Every query is scoped to yours.',
];

const boundary = [
  { k: 'Database', v: 'Never connects to it' },
  { k: 'Commands and results', v: 'Over the event bus' },
  { k: 'Decryption', v: 'Asks the control plane, holds no cloud key' },
  { k: 'File storage', v: 'One signed operation at a time' },
];

const abuse = [
  { t: 'Verified warmup', d: 'Every warmup email carries a single-use token tied to its recipient, so warmup can’t be faked, replayed or redirected.' },
  { t: 'Strict pool rules', d: 'High complaint or bounce rates take a mailbox out of the shared pool, well before providers would act.' },
  { t: 'Suppression at send time', d: 'Bounces, complaints and unsubscribes are checked before every send, across the whole workspace.' },
  { t: 'Rate limits', d: 'API and live connections are limited per user, with budgets by plan.' },
  { t: 'Duplicate protection', d: 'Tracking, deliverability and billing events are de-duplicated, so nothing is counted or charged twice.' },
  { t: 'Admin oversight', d: 'Accounts that abuse the platform can be banned, and every enforcement action is recorded.' },
];

const subs = [
  { name: 'AWS', use: 'Compute, key management, storage, databases', region: 'us-east-1, eu-west-1' },
  { name: 'Cloudflare', use: 'Edge network, DDoS protection, CAPTCHA', region: 'Global' },
  { name: 'Stripe', use: 'Billing and tax', region: 'United States' },
  { name: 'Postmark', use: 'Account email', region: 'United States' },
  { name: 'PostHog', use: 'Product analytics and error reporting', region: 'United States' },
  { name: 'Sentry', use: 'Error reporting, content scrubbed', region: 'United States' },
];

const disclosure = [
  { k: 'We acknowledge your report', v: 'within 1 business day' },
  { k: 'We triage it', v: 'within 3 business days' },
  { k: 'We update you', v: 'every 7 days until it’s fixed' },
  { k: 'We credit you publicly', v: 'on request, once the fix ships' },
];

const h2 = 'scroll-mt-28 text-[28px] md:text-[34px] font-medium tracking-[-0.035em] leading-[1.15] text-slate-900';
const lead = 'mt-4 max-w-2xl text-[16.5px] leading-[1.7] text-slate-600';
const cap = 'mt-3 max-w-2xl text-[13.5px] leading-[1.55] text-slate-500';
---
<Layout
  title="Security and Trust | Warmbly"
  description="How Warmbly protects your mailboxes and data: per-workspace encryption, Argon2id passwords, workers with no database access, abuse controls, subprocessors and how to report a vulnerability."
>
  <!-- HEADER: a document title, not a banner. -->
  <section class="container-page pt-14 md:pt-24 pb-14 md:pb-16">
    <div class="text-[14px] text-slate-500">Trust</div>
    <h1 class="mt-4 max-w-4xl text-[40px] sm:text-[52px] md:text-[64px] font-medium tracking-[-0.05em] leading-[1.02] text-slate-900">
      How Warmbly protects your mailboxes and your data.
    </h1>
    <p class="mt-6 max-w-2xl text-[17px] md:text-[19px] leading-[1.55] text-slate-500">
      We hold mailbox credentials, messages and contact lists. This page describes how they are encrypted, who can reach them, and how to tell us if you find a problem.
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a href="mailto:team@warmbly.com" class="inline-flex h-11 items-center gap-2 rounded-full bg-slate-900 px-5 text-[15px] font-medium text-white transition-colors hover:bg-slate-800">
        Report a vulnerability <Icon name="arrowRight" size={14} />
      </a>
      <a href="https://github.com/warmbly/warmbly" target="_blank" rel="noopener noreferrer" class="inline-flex h-11 items-center rounded-full border border-slate-200 px-5 text-[15px] text-slate-800 transition-colors hover:border-slate-300 hover:bg-slate-50">
        Audit the code
      </a>
    </div>
  </section>

  <!-- DOCUMENT: a sticky contents list beside the sections. -->
  <div class="container-page border-t border-slate-900/[0.06] pb-20 md:pb-28">
    <div class="grid gap-12 pt-14 lg:grid-cols-[220px_1fr] lg:gap-20">
      <nav class="hidden lg:block" aria-label="On this page">
        <ol class="sticky top-28 space-y-1 border-l border-slate-200" data-toc>
          {toc.map((t) => (
            <li><a href={`#${t.id}`} data-toc-link={t.id} class="-ml-px block border-l border-transparent py-1.5 pl-4 text-[14px] text-slate-500 transition-colors hover:text-slate-900">{t.t}</a></li>
          ))}
        </ol>
      </nav>

      <div class="min-w-0 space-y-20">
        <section id="posture" class="scroll-mt-28">
          <h2 class={h2}>At a glance</h2>
          <ul class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
            {posture.map((p) => (
              <li class="grid gap-1 py-4 sm:grid-cols-[1fr_1.4fr_auto] sm:items-baseline sm:gap-6">
                <span class="text-[16px] font-medium text-slate-900">{p.label}</span>
                <span class="text-[15px] text-slate-500">{p.note}</span>
                <span class={`inline-flex items-center gap-1.5 text-[13px] ${p.state === 'shipped' ? 'text-emerald-600' : 'text-slate-400'}`}>
                  <span class={`size-1.5 rounded-full ${p.state === 'shipped' ? 'bg-emerald-500' : 'bg-slate-300'}`}></span>
                  {p.state === 'shipped' ? 'In place' : 'Planned'}
                </span>
              </li>
            ))}
          </ul>
        </section>

        <section id="encryption" class="scroll-mt-28">
          <h2 class={h2}>Encryption</h2>
          <p class={lead}>Warmbly uses envelope encryption. A key management service holds the root key, every workspace gets its own data key, and sensitive fields are sealed with that key before they reach the database. Mailbox credentials are sealed separately, with a dedicated credentials key.</p>
          <div class="mt-8">
            <EncryptionFigure n={1} caption="Envelope encryption. The root key stays inside the key management service, each workspace has its own data key, and only that key's encrypted copy is ever stored." />
          </div>
          <ol class="mt-8 grid gap-6 md:grid-cols-3 md:gap-8">
            {flow.map((f, i) => (
              <li class="border-t border-slate-200 pt-4">
                <div class="font-mono text-[12px] text-slate-400">{String(i + 1).padStart(2, '0')}</div>
                <h3 class="mt-2 text-[16px] font-medium text-slate-900">{f.t}</h3>
                <p class="mt-2 text-[14.5px] leading-[1.6] text-slate-500">{f.d}</p>
              </li>
            ))}
          </ol>
        </section>

        <section id="accounts" class="scroll-mt-28">
          <h2 class={h2}>Accounts and sign-in</h2>
          <figure class="m-0 mt-8">
            <SecurityScene />
            <figcaption class={cap}><span class="font-medium text-slate-700">Figure 2.</span> Settings &gt; Security. Two-factor status and every device signed in to your account. Signing out the other sessions ends them everywhere at once.</figcaption>
          </figure>
          <ul class="mt-8 space-y-4">
            {signin.map((s) => (
              <li class="flex items-start gap-3 text-[16px] leading-[1.6] text-slate-600"><Icon name="check" size={16} class="mt-1 shrink-0 text-slate-900" />{s}</li>
            ))}
          </ul>
        </section>


        <section id="data" class="scroll-mt-28">
          <h2 class={h2}>What we store, and what we never store</h2>
          <div class="mt-8 grid gap-3 md:grid-cols-2">
            <div class="rounded-[6px] bg-white p-6 ring-1 ring-slate-200">
              <h3 class="text-[16px] font-medium text-slate-900">We store</h3>
              <ul class="mt-4 divide-y divide-slate-100 text-[15px] leading-[1.55] text-slate-600">{collect.map((c) => (
                <li class="flex items-start gap-3 py-2.5"><Icon name={c.includes('encrypted') ? 'lock' : 'check'} size={15} class={`mt-1 shrink-0 ${c.includes('encrypted') ? 'text-sky-600' : 'text-slate-400'}`} /><span>{c}</span></li>
              ))}</ul>
            </div>
            <div class="rounded-[6px] bg-white p-6 ring-1 ring-slate-200">
              <h3 class="text-[16px] font-medium text-slate-900">We never store</h3>
              <ul class="mt-4 divide-y divide-slate-100 text-[15px] leading-[1.55] text-slate-600">{never.map((c) => (
                <li class="flex items-start gap-3 py-2.5"><span class="mt-[5px] inline-flex size-[15px] shrink-0 items-center justify-center rounded-full bg-rose-50 text-rose-500 ring-1 ring-rose-100"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></span><span>{c}</span></li>
              ))}</ul>
            </div>
          </div>
        </section>

        <section id="workers" class="scroll-mt-28">
          <h2 class={h2}>The worker boundary</h2>
          <p class={lead}>Workers are the machines that sign in to your mailboxes. They are kept deliberately small: no database connection and no cloud credentials. Anything privileged goes through the control plane, one request at a time.</p>
          <div class="mt-8">
            <WorkerFigure n={3} caption="The worker boundary. A worker talks to the control plane only through the event bus and single requests, and otherwise only to your mailbox provider. It never connects to the database." />
          </div>
          <dl class="mt-8 grid gap-px overflow-hidden rounded-[6px] bg-slate-200 ring-1 ring-slate-200 sm:grid-cols-2">
            {boundary.map((b) => (
              <div class="bg-white p-5">
                <dt class="text-[13px] text-slate-400">{b.k}</dt>
                <dd class="mt-1 text-[16px] font-medium text-slate-900">{b.v}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section id="abuse" class="scroll-mt-28">
          <h2 class={h2}>Abuse controls</h2>
          <p class={lead}>A shared warmup pool and shared infrastructure only work if nobody can abuse them, so the controls are layered rather than one gate.</p>
          <figure class="m-0 mt-8">
            <AuditScene />
            <figcaption class={cap}><span class="font-medium text-slate-700">Figure 4.</span> The audit log. Owners and admins see every change made in the workspace, who made it and the address it came from, as it happens.</figcaption>
          </figure>
          <div class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-2">
            {abuse.map((a) => (
              <div>
                <h3 class="text-[16px] font-medium text-slate-900">{a.t}</h3>
                <p class="mt-1.5 text-[15px] leading-[1.6] text-slate-500">{a.d}</p>
              </div>
            ))}
          </div>
        </section>


        <section id="subprocessors" class="scroll-mt-28">
          <h2 class={h2}>Subprocessors</h2>
          <p class={lead}>The services Warmbly Cloud relies on to run. New subprocessors are announced 30 days before they start. A self-hosted instance uses none of them unless you choose to.</p>
          <div class="mt-8 overflow-x-auto">
            <table class="w-full min-w-[560px] text-left text-[15px]">
              <thead><tr class="border-b border-slate-200 text-[13px] text-slate-400"><th class="py-3 pr-6 font-normal">Service</th><th class="py-3 pr-6 font-normal">Used for</th><th class="py-3 font-normal">Region</th></tr></thead>
              <tbody class="divide-y divide-slate-100">
                {subs.map((s) => <tr><td class="py-3.5 pr-6 font-medium text-slate-900">{s.name}</td><td class="py-3.5 pr-6 text-slate-600">{s.use}</td><td class="py-3.5 text-slate-500">{s.region}</td></tr>)}
              </tbody>
            </table>
          </div>
        </section>

        <section id="disclosure" class="scroll-mt-28">
          <h2 class={h2}>Reporting a vulnerability</h2>
          <p class={lead}>We welcome reports from researchers and from people running Warmbly themselves. Send a description, a proof of concept and any logs to <a class="font-medium text-slate-900 underline decoration-slate-300 underline-offset-4 hover:decoration-slate-900" href="mailto:team@warmbly.com">team@warmbly.com</a>.</p>
          <ol class="relative mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
            <span class="absolute left-0 right-0 top-[7px] hidden h-px bg-slate-200 lg:block" aria-hidden="true"></span>
            {disclosure.map((d, i) => (
              <li class="relative">
                <span class={`relative z-10 block size-[15px] rounded-full ring-4 ring-white ${i === disclosure.length - 1 ? 'bg-emerald-500' : 'bg-slate-900'}`}></span>
                <div class="mt-4 text-[15px] font-medium text-slate-900">{d.k}</div>
                <div class="mt-1 text-[15px] text-slate-500">{d.v}</div>
              </li>
            ))}
          </ol>
        </section>
      </div>
    </div>
  </div>

  <CTA photo="frost-blue" title="Need the full security package?" description="Data processing terms, a security questionnaire and an architecture walkthrough, on request. A person replies within one business day." primaryLabel="Email us" primaryHref="mailto:team@warmbly.com" secondaryLabel="Read the code" secondaryHref="https://github.com/warmbly/warmbly" />
</Layout>

<style>
  .toc-on { color: #0f172a; border-color: #0f172a; }
</style>

<script>
  // Highlight the section being read in the contents list.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((a) => [a.dataset.tocLink!, a]));
  if (links.size && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => a.classList.remove('toc-on'));
        links.get(e.target.id)?.classList.add('toc-on');
      });
    }, { rootMargin: '-30% 0px -60% 0px' });
    links.forEach((_, id) => { const s = document.getElementById(id); if (s) io.observe(s); });
  }
</script>
