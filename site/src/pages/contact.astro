---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

// Every link here is one that already exists elsewhere on the site
// (header, footer, trust, terms). Nothing on this page is invented.
const channels = [
  {
    icon: 'mail',
    title: 'Email',
    label: 'team@warmbly.com',
    href: 'mailto:team@warmbly.com',
    body: 'Sales, billing, account questions, self-host help, partnerships, security reports.',
    external: false,
  },
  {
    icon: 'discord',
    title: 'Discord',
    label: 'dc.warmbly.com',
    href: 'https://dc.warmbly.com',
    body: 'Ask questions, share what you are building, talk to other people running Warmbly.',
    external: true,
  },
  {
    icon: 'warning',
    title: 'Bug reports',
    label: 'github.com/warmbly/warmbly/issues',
    href: 'https://github.com/warmbly/warmbly/issues',
    body: 'Something broken in the app, the CLI or the self-host installer.',
    external: true,
  },
  {
    icon: 'users',
    title: 'Feature requests',
    label: 'github.com/warmbly/warmbly/discussions',
    href: 'https://github.com/warmbly/warmbly/discussions',
    body: 'Ideas, feedback and questions about where the product is going.',
    external: true,
  },
  {
    icon: 'code',
    title: 'Documentation',
    label: 'docs.warmbly.com',
    href: 'https://docs.warmbly.com',
    body: 'Product guides, API reference, self-hosting and deliverability fundamentals.',
    external: true,
  },
  {
    icon: 'check',
    title: 'Status',
    label: 'status.warmbly.com',
    href: 'https://status.warmbly.com',
    body: 'Uptime and incident history for the hosted service.',
    external: true,
  },
];
---
<Layout
  title="Contact | Warmbly"
  description="Email the team, join the Discord, or open an issue on GitHub."
>
  <section class="border-b border-[color:var(--border)]">
    <div class="container-page pt-16 md:pt-24 pb-12 md:pb-16">
      <div class="text-[11px] uppercase tracking-[0.18em] text-muted-foreground font-mono mb-3">
        Contact
      </div>
      <h1 class="text-[34px] md:text-[48px] font-semibold tracking-[-0.03em] leading-[1.05] text-heading max-w-2xl">
        Get in touch.
      </h1>
      <p class="mt-5 text-[15.5px] md:text-[16.5px] text-foreground/75 leading-relaxed max-w-xl">
        Warmbly is a small team. Email reaches us directly, and everything else happens in public on Discord and GitHub.
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="container-page">
      <ul class="divide-y divide-[color:var(--border)] border-y border-[color:var(--border)]">
        {channels.map((c) => (
          <li>
            <a
              href={c.href}
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener noreferrer' : undefined}
              class="group grid sm:grid-cols-[180px_1fr_auto] gap-x-8 gap-y-1.5 items-baseline py-5 md:py-6 hover:bg-[color:var(--surface-2)] -mx-4 px-4 rounded-[8px] transition-colors"
            >
              <span class="inline-flex items-center gap-2 text-[14.5px] font-semibold text-heading">
                <Icon name={c.icon} size={15} class="text-[color:var(--brand)]" />
                {c.title}
              </span>
              <span class="text-[14px] text-foreground/75 leading-relaxed">
                {c.body}
              </span>
              <span class="inline-flex items-center gap-1.5 font-mono text-[13px] text-[color:var(--brand)] group-hover:text-[color:var(--brand-strong)] break-all sm:justify-self-end">
                {c.label}
                <Icon name={c.external ? 'arrowUpRight' : 'arrowRight'} size={12} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pb-16 md:pb-24">
    <div class="container-page">
      <div class="text-[11px] uppercase tracking-[0.18em] text-muted-foreground font-mono mb-3">
        Company
      </div>
      <p class="text-[14px] text-foreground/75 leading-relaxed max-w-xl">
        Warmbly is operated by Mindroot Ltd, registered in England and Wales, company number 16543299.
      </p>
      <address class="mt-3 not-italic font-mono text-[13.5px] text-foreground/85 leading-relaxed">
        Mindroot Ltd<br/>
        71-75 Shelton Street<br/>
        London WC2H 9JQ<br/>
        United Kingdom
      </address>
      <p class="mt-4 text-[13px] text-muted-foreground">
        Legal notices and data requests: <a href="mailto:team@warmbly.com" class="font-mono text-[color:var(--brand)] hover:text-[color:var(--brand-strong)]">team@warmbly.com</a>. See the <a href="/terms/" class="underline underline-offset-2 hover:text-heading">terms</a> and <a href="/privacy/" class="underline underline-offset-2 hover:text-heading">privacy policy</a>.
      </p>
    </div>
  </section>
</Layout>
