---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import SectionIntro from '../../components/page/SectionIntro.astro';
import Rule from '../../components/page/Rule.astro';
import Faq from '../../components/page/Faq.astro';
import WarmupCountdown from '../../components/scenes/use-cases/fundraising/WarmupCountdown.astro';
import InvestorCampaign from '../../components/scenes/use-cases/fundraising/InvestorCampaign.astro';
import NewMailbox from '../../components/scenes/use-cases/fundraising/NewMailbox.astro';
import OneToOne from '../../components/scenes/use-cases/fundraising/OneToOne.astro';
import SpreadSends from '../../components/scenes/use-cases/fundraising/SpreadSends.astro';
import TwoEmails from '../../components/scenes/use-cases/fundraising/TwoEmails.astro';
import SendTimePanel from '../../components/scenes/use-cases/fundraising/SendTimePanel.astro';
import PartnerReply from '../../components/scenes/use-cases/fundraising/PartnerReply.astro';

// Warmup ramp and health policy from CLAUDE.md; recipient-timezone sending
// from docs/content/docs/guides/sending-behavior.mdx.

const countdown = [
  { when: '6 weeks out', t: 'Connect and warm', d: 'Warmup starts at 10 a day and climbs by one a day.', on: true },
  { when: '4 weeks out', t: 'Write the sequence', d: 'Two emails, plain text, one ask.', on: true },
  { when: '2 weeks out', t: 'Build the list', d: 'Partners who actually lead rounds like yours.', on: true },
  { when: 'Launch week', t: 'Send', d: 'Inside each partner’s working hours, spaced out.', now: true },
  { when: 'After', t: 'Reply fast', d: 'Every reply lands in one inbox, ready for the deck.' },
];

const traps = [
  { t: 'Setting up the mailbox the week of the raise', d: 'A brand-new mailbox whose first act is emailing strangers looks exactly like a spammer. Connect it four to six weeks out and let warmup give it a history.', href: '/warmup/', link: 'How warmup works', scene: 'new' },
  { t: 'Copying your co-founders on every email', d: 'A cold email with a wall of names reads as bulk mail. Write one to one, and bring the team in once a partner replies.', href: '/inbox/', link: 'How the inbox works', scene: 'cc' },
  { t: 'Sending to the whole list at 9am Tuesday', d: 'Dozens of near-identical emails in one minute is the loudest spam signal there is. Spread them across each partner’s own working day.', href: '/sending/', link: 'How sending is paced', scene: 'spread' },
];

const watch = [
  { v: '10%', k: 'Spam placement', d: 'The point where warmup slows down to protect the mailbox.' },
  { v: '0.10%', k: 'Complaints', d: 'The point where the mailbox is paused and pulled from the pool.' },
  { v: '0', k: 'Follow-ups after a reply', d: 'A partner who answers is out of the sequence at once.' },
];

const faq: [string, string][] = [
  ['How long before the raise should I connect the mailbox?', 'Four to six weeks. Warmup reaches 40 emails a day after about a month, and while a mailbox is still warming it sends at most 5 cold emails a day.'],
  ['How short should an investor sequence be?', 'Shorter than you think. Partners get hundreds of these a week, so one strong first email and a single follow-up in the same thread do most of the work. A reply stops the sequence for that partner.'],
  ['Should I attach the deck to the first email?', 'No. A cold attachment hurts deliverability, and it takes away their reason to reply. Send a few sentences and an ask, then the deck once they answer.'],
  ['Should I send from my main domain?', 'Use a sending sub-domain, so a complaint on cold mail never touches the inbox you run the company from. The founder setup walks through it.'],
  ['What if a partner marks it as spam?', 'Complaints are tracked per mailbox. A spam complaint suppresses that address, and if complaints climb, the mailbox is slowed down or paused before it can damage your domain.'],
];
---
<Layout
  title="Cold Email for Fundraising: Investor Outreach That Lands | Warmbly"
  description="Plan investor outreach that reaches the inbox: warm the mailbox weeks before the raise, send a short two-email sequence in each partner’s working hours, and stop the moment a partner replies."
>
  <!-- HERO: the countdown as two screens, six weeks out and launch week. -->
  <section class="container-page pt-14 md:pt-24">
    <div class="max-w-4xl">
      <a href="/use-cases/" class="text-[14px] text-slate-500 hover:text-slate-900">Use cases · Fundraising</a>
      <h1 class="mt-4 text-[40px] sm:text-[52px] md:text-[64px] font-medium tracking-[-0.05em] leading-[1.02] text-slate-900">Warm up now. Send when the deck is ready.</h1>
      <p class="mt-6 max-w-2xl text-[17px] md:text-[19px] leading-[1.55] text-slate-500">Investor outreach fails for one boring reason: the mailbox was set up the week of the raise. Start six weeks out, and on launch day your email lands in the inbox, not the promotions tab.</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="https://app.warmbly.com/auth/register" class="inline-flex h-11 items-center gap-2 rounded-full bg-slate-900 px-5 text-[15px] font-medium text-white transition-colors hover:bg-slate-800">Start warming today <Icon name="arrowRight" size={14} /></a>
        <a href="/use-cases/founders/" class="inline-flex h-11 items-center rounded-full border border-slate-200 px-5 text-[15px] text-slate-800 transition-colors hover:border-slate-300 hover:bg-slate-50">The founder setup</a>
      </div>
    </div>

    <div class="mt-14 md:mt-16 grid gap-3 md:grid-cols-2">
      <figure>
        <WarmupCountdown />
        <figcaption class="mt-4 flex items-baseline gap-3 text-[15px]"><span class="font-mono text-[13px] text-slate-400">Week 5</span><span class="text-slate-900">The mailbox is nearly at 40 a day and lands in the inbox.</span></figcaption>
      </figure>
      <figure>
        <InvestorCampaign />
        <figcaption class="mt-4 flex items-baseline gap-3 text-[15px]"><span class="font-mono text-[13px] text-sky-600">Launch week</span><span class="text-slate-900">Partners reply, and each reply ends their sequence.</span></figcaption>
      </figure>
    </div>

    <ol class="relative mt-14 grid min-w-0 gap-8 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6">
      <span aria-hidden="true" class="absolute left-0 right-0 top-[7px] hidden h-px bg-slate-200 lg:block"></span>
      {countdown.map((c) => (
        <li class="relative">
          <span class={`relative z-[1] block size-[15px] rounded-full border-2 border-white ring-1 ${c.now ? 'bg-sky-500 ring-sky-300' : c.on ? 'bg-slate-900 ring-slate-300' : 'bg-white ring-slate-300'}`}></span>
          <div class={`mt-5 text-[13px] ${c.now ? 'font-medium text-sky-600' : 'text-slate-400'}`}>{c.when}</div>
          <div class="mt-1 text-[16px] font-medium text-slate-900">{c.t}</div>
          <p class="mt-1 text-[14px] leading-[1.55] text-slate-500">{c.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- TRAPS: three mistakes, each with the screen that avoids it. -->
  <Rule class="mt-20" />
  <section class="container-page py-20 md:py-28">
    <SectionIntro lead="Three mistakes." title="How founders burn their domain mid-raise." />
    <div class="mt-12 md:mt-16 grid gap-x-3 gap-y-12 md:grid-cols-3">
      {traps.map((t, i) => (
        <article>
          {t.scene === 'new' && <NewMailbox />}
          {t.scene === 'cc' && <OneToOne />}
          {t.scene === 'spread' && <SpreadSends />}
          <div class="mt-6 font-mono text-[13px] text-slate-400">{String(i + 1).padStart(2, '0')}</div>
          <h3 class="mt-1.5 text-[20px] md:text-[21px] tracking-[-0.02em] text-slate-900">{t.t}</h3>
          <p class="mt-2 text-[15.5px] leading-[1.6] text-slate-500">{t.d}</p>
          <a href={t.href} class="group mt-3 inline-flex items-center gap-1.5 text-[15px] text-[color:var(--brand)] hover:text-[color:var(--brand-strong)]">{t.link}<Icon name="arrowRight" size={13} class="transition-transform group-hover:translate-x-0.5" /></a>
        </article>
      ))}
    </div>
  </section>

  <!-- SEQUENCE: the two emails, in the editor. -->
  <Rule />
  <section class="container-page py-20 md:py-28">
    <div class="grid items-end gap-8 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
      <SectionIntro lead="The sequence." title="Two emails. The second is a reply to the first." />
      <p class="text-[16px] md:text-[18px] leading-[1.6] text-slate-500 lg:pb-2">A partner who answers either one is taken out of the sequence straight away, so nobody gets a follow-up after saying yes or no.</p>
    </div>
    <div class="mt-12 md:mt-14">
      <TwoEmails />
    </div>
  </section>

  <!-- HOURS: sending inside each partner's own day. -->
  <Rule />
  <section class="container-page py-20 md:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <SectionIntro lead="Their working hours." title="Land in each partner’s morning, wherever they are." text="Turn on send-time optimization and each email waits until the partner’s own clock reaches the hours you pick. Warmbly reads the contact’s timezone field first, then the country their email domain points at, then your fallback." />
        <ul class="mt-9 space-y-4 text-[15.5px] text-slate-600">
          <li class="flex gap-3"><Icon name="check" size={16} class="mt-1 shrink-0 text-emerald-600" />It only ever delays a send, never brings one forward.</li>
          <li class="flex gap-3"><Icon name="check" size={16} class="mt-1 shrink-0 text-emerald-600" />The campaign window, the daily cap and the gap between sends still apply.</li>
          <li class="flex gap-3"><Icon name="check" size={16} class="mt-1 shrink-0 text-emerald-600" />Weekends can roll over to Monday.</li>
        </ul>
      </div>
      <SendTimePanel />
    </div>
  </section>

  <!-- REPLIES: a partner answers, the sequence ends, the deck goes back. -->
  <Rule />
  <section class="container-page py-20 md:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div class="lg:order-2">
        <SectionIntro lead="When they reply." title="The sequence stops, and the thread is yours." text="A reply lands in one inbox, labelled by what the partner wants, and their place in the campaign ends there. Meanwhile Warmbly keeps watching the mailbox for you." />
        <dl class="mt-10 grid gap-5 sm:grid-cols-3">
          {watch.map((c) => (
            <div class="border-t border-slate-200 pt-4">
              <dt class="text-[28px] md:text-[32px] font-medium tracking-[-0.05em] leading-none text-slate-900">{c.v}</dt>
              <dd class="mt-2 text-[14px] font-medium text-slate-900">{c.k}</dd>
              <dd class="mt-1 text-[13.5px] leading-[1.5] text-slate-500">{c.d}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="lg:order-1">
        <PartnerReply />
      </div>
    </div>
  </section>

  <Rule />
  <Faq items={faq} title="Fundraising, answered." />

  <CTA photo="reeded-glass" title="Start warming six weeks before the raise." description="Connect the mailbox today and it will be ready by the time the deck is." />
</Layout>
