---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import SectionIntro from '../../components/page/SectionIntro.astro';
import Rule from '../../components/page/Rule.astro';
import Faq from '../../components/page/Faq.astro';
import HeroAccounts from '../../components/scenes/use-cases/founders/HeroAccounts.astro';
import SortedInbox from '../../components/scenes/use-cases/founders/SortedInbox.astro';
import ConnectDialog from '../../components/scenes/use-cases/founders/ConnectDialog.astro';
import WarmupRamp from '../../components/scenes/use-cases/founders/WarmupRamp.astro';
import CampaignSenders from '../../components/scenes/use-cases/founders/CampaignSenders.astro';
import WeekGrid from '../../components/scenes/use-cases/founders/WeekGrid.astro';

// Defaults from internal/config/constants.go and the campaigns guide
// (a mailbox still warming sends at most 5 cold emails a day).

const risks = [
  { t: 'One inbox carries everything', b: 'Your investor threads, your data room links and your fiftieth cold pitch of the day share one reputation. One complaint costs you the inbox you run the company from.' },
  { t: 'Replies wait for you', b: 'A warm reply that sits for a day is a deal cooling off. With every mailbox in one inbox, sorted by what each reply wants, the good ones stop slipping past.' },
  { t: 'One mailbox hits a ceiling', b: 'A mailbox sends around 50 cold emails a day safely. Push everything through one and you run into the provider’s limits long before your goals.' },
];

// The six steps, grouped by the screen each one happens on.
const groups = [
  {
    when: 'One afternoon',
    scene: 'connect',
    steps: [
      { n: 1, t: 'Send cold from a sub-domain', k: 'out.acme.com', b: 'Reputation follows the sub-domain, so a complaint on cold mail never touches founder@ on your main domain.' },
      { n: 2, t: 'Open three cold mailboxes', k: 'hello@ · intro@ · team@', b: 'Three senders share the volume and the risk. founder@ stays on the main domain for real mail.' },
    ],
  },
  {
    when: 'Then three to six weeks',
    scene: 'warmup',
    steps: [
      { n: 3, t: 'Publish SPF and DMARC', k: 'v=DMARC1; p=quarantine; …', b: 'Warmbly checks both on the sub-domain and spells out the record to add if one is missing.' },
      { n: 4, t: 'Warm all four mailboxes', k: '10 a day, +1 a day, up to 40', b: 'Expect three to six weeks. While a mailbox is still warming it sends at most 5 cold emails a day.' },
    ],
  },
  {
    when: 'While it warms',
    scene: 'campaign',
    steps: [
      { n: 5, t: 'Write in plain text', k: 'no HTML, no tracking image', b: 'A founder writing by hand doesn’t send a designed newsletter. Plain text reads as a person.' },
      { n: 6, t: 'Judge by replies, not opens', k: 'reply rate per mailbox', b: 'Opens are muddied by privacy proxies. Replies, and each mailbox’s health, tell you what is working.' },
    ],
  },
];

const faq: [string, string][] = [
  ['Why a sub-domain instead of more mailboxes on my main domain?', 'A sub-domain like out.acme.com builds its own reputation at Gmail and Outlook. If cold mail draws a complaint, your main domain and the founder@ inbox are untouched. The setup is the same records, just on the sub-domain.'],
  ['Can I use founder@ for cold email if I’m careful?', 'We wouldn’t. Once founder@ takes a reputation hit, your contracts, data room links and investor threads start landing in tabs or spam. Keep it for real mail.'],
  ['How soon can I send a real campaign?', 'Plan on three to six weeks of warmup. Warmup reaches 40 a day after about a month, and until a mailbox is warmed it sends at most 5 cold emails a day, so starting early matters more than anything else.'],
  ['How many emails a day will this setup send?', 'About 150 a weekday once all three cold mailboxes are warmed, at the default of 50 each. That fits the Starter plan.'],
];
---
<Layout
  title="Cold Email for Founders: The Founder-Led Outreach Setup | Warmbly"
  description="Run founder-led cold outreach without risking the inbox you run your company from: a sending sub-domain, three warmed mailboxes, plain text and about 150 emails a weekday."
>
  <!-- HERO: the pitch beside the founder's own Accounts page. -->
  <section class="container-page pt-14 md:pt-24 pb-20 md:pb-28">
    <div class="grid items-center gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
      <div>
        <a href="/use-cases/" class="text-[14px] text-slate-500 hover:text-slate-900">Use cases · Founders</a>
        <h1 class="mt-4 text-[40px] sm:text-[52px] md:text-[60px] font-medium tracking-[-0.05em] leading-[1.02] text-slate-900">Cold email for founders, without risking founder@.</h1>
        <p class="mt-6 max-w-xl text-[17px] md:text-[19px] leading-[1.55] text-slate-500">You are the best person to sell what you’re building, but your own inbox is too valuable to burn. This is the setup that keeps it safe and still sends about 150 emails a weekday.</p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="https://app.warmbly.com/auth/register" class="inline-flex h-11 items-center gap-2 rounded-full bg-slate-900 px-5 text-[15px] font-medium text-white transition-colors hover:bg-slate-800">Start free <Icon name="arrowRight" size={14} /></a>
          <a href="#setup" class="inline-flex h-11 items-center rounded-full border border-slate-200 px-5 text-[15px] text-slate-800 transition-colors hover:border-slate-300 hover:bg-slate-50">See the setup</a>
        </div>
        <dl class="mt-10 grid max-w-md grid-cols-3 gap-4 border-t border-slate-200 pt-6">
          <div><dt class="text-[13px] text-slate-400">Mailboxes</dt><dd class="mt-1 text-[22px] font-medium tracking-[-0.03em] text-slate-900">3 + 1</dd></div>
          <div><dt class="text-[13px] text-slate-400">Ready in</dt><dd class="mt-1 text-[22px] font-medium tracking-[-0.03em] text-slate-900">~a month</dd></div>
          <div><dt class="text-[13px] text-slate-400">A weekday</dt><dd class="mt-1 text-[22px] font-medium tracking-[-0.03em] text-slate-900">~150</dd></div>
        </dl>
      </div>
      <HeroAccounts />
    </div>
  </section>

  <!-- RISKS: the three ways one inbox fails, beside the inbox that fixes them. -->
  <Rule />
  <section class="container-page py-20 md:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
      <div>
        <SectionIntro lead="Why not just use your inbox?" title="Three ways one inbox lets a founder down." />
        <ol class="mt-10 space-y-7">
          {risks.map((r, i) => (
            <li class="grid grid-cols-[40px_1fr] gap-3">
              <span class="pt-0.5 font-mono text-[13px] text-slate-400">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-[18px] font-medium text-slate-900">{r.t}</h3>
                <p class="mt-1.5 text-[15.5px] leading-[1.6] text-slate-500">{r.b}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <SortedInbox />
    </div>
  </section>

  <!-- SETUP: the six steps as a checklist, each pair beside the screen it happens on. -->
  <Rule />
  <section id="setup" class="container-page scroll-mt-28 py-20 md:py-28">
    <div class="grid items-end gap-10 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <SectionIntro lead="The setup." title="Six steps, most of them done once." text="Do the first four in an afternoon, then let warmup run while you write the sequence." />
      <div class="rounded-[6px] bg-slate-50 p-5 ring-1 ring-slate-200">
        <div class="flex items-center justify-between text-[13px] text-slate-500"><span>Today</span><span>Week 3 to 6</span></div>
        <div class="mt-3 flex h-9 overflow-hidden rounded-md text-[12.5px] font-medium">
          <span class="flex w-[16%] items-center justify-center bg-slate-900 text-white">1 to 3</span>
          <span class="flex flex-1 items-center gap-2 bg-orange-100 px-3 text-orange-800"><Icon name="flame" size={13} />4 · warmup runs on its own</span>
          <span class="flex w-[22%] items-center justify-center bg-sky-100 text-sky-800">first send</span>
        </div>
        <div class="mt-3 flex items-center gap-2 text-[13px] text-slate-500"><span class="h-px w-6 bg-sky-400"></span>Steps 5 and 6 happen while the mailboxes warm.</div>
      </div>
    </div>

    <div class="mt-16 space-y-20 md:mt-20 md:space-y-28">
      {groups.map((g, gi) => (
        <div class="grid items-center gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
          <div class={gi % 2 ? 'lg:order-2' : ''}>
            <div class="text-[13px] font-medium uppercase tracking-[0.14em] text-slate-400">{g.when}</div>
            <ol class="mt-6 space-y-8">
              {g.steps.map((s) => (
                <li class="grid grid-cols-[36px_1fr] gap-4">
                  <span class="flex size-8 items-center justify-center rounded-full bg-slate-900 text-[13px] font-medium text-white">{s.n}</span>
                  <div>
                    <h3 class="text-[22px] md:text-[26px] font-medium tracking-[-0.03em] leading-[1.15] text-slate-900">{s.t}</h3>
                    <code class="mt-3 inline-block rounded bg-slate-50 px-2 py-1 font-mono text-[12.5px] text-slate-600 ring-1 ring-slate-200">{s.k}</code>
                    <p class="mt-3 max-w-lg text-[16px] leading-[1.6] text-slate-500">{s.b}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <div class={gi % 2 ? 'lg:order-1' : ''}>
            {g.scene === 'connect' && <ConnectDialog />}
            {g.scene === 'warmup' && <WarmupRamp />}
            {g.scene === 'campaign' && <CampaignSenders />}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- WEEK: what a warmed week looks like, read off Analytics. -->
  <Rule />
  <section class="container-page py-20 md:py-28">
    <div class="grid items-end gap-8 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
      <SectionIntro lead="A week, once warmed." title="750 cold emails, and founder@ sends none of them." />
      <p class="text-[16px] md:text-[18px] leading-[1.6] text-slate-500 lg:pb-2">Three mailboxes at the default of 50 a day, Monday to Friday. founder@ keeps warming in the background and carries only the mail you write yourself.</p>
    </div>
    <div class="mt-12 md:mt-14">
      <WeekGrid />
    </div>
  </section>

  <Rule />
  <Faq items={faq} title="Founders, answered." />

  <CTA photo="sheer-blue" title="Start the founder setup today." description="Connect your sub-domain, add the mailboxes and have warmup running before the day ends." />
</Layout>
