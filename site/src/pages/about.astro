---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import SectionIntro from '../components/page/SectionIntro.astro';
import Rule from '../components/page/Rule.astro';
import RepoScene from '../components/scenes/about/RepoScene.astro';
import StoryScene from '../components/scenes/about/StoryScene.astro';
import MergedScene from '../components/scenes/about/MergedScene.astro';
import LimitsScene from '../components/scenes/about/LimitsScene.astro';
import CipherScene from '../components/scenes/about/CipherScene.astro';
import ArchitectureScene from '../components/scenes/about/ArchitectureScene.astro';
import { GITHUB_PATH } from '../lib/marks';
import { getChangelog } from '../lib/changelog';

// Facts from the repository: README.md and CLAUDE.md (system shape, worker
// topology, encryption model). No invented metrics, people or customers.
const entries = await getChangelog();

const groups = [
  {
    scene: 'merged',
    label: 'In the open',
    items: [
      { t: 'Open by default', b: 'The whole platform is on GitHub under Apache 2.0: sending, warmup pools, health thresholds and abuse checks. If you want to know why a mailbox was paused, you can read the code that paused it.' },
      { t: 'Built in public', b: 'The changelog is public and dated, and every entry maps to a merged change. We don’t invent metrics or pretend to be bigger than we are.' },
    ],
  },
  {
    scene: 'limits',
    label: 'Safe by default',
    items: [
      { t: 'Safety is per mailbox', b: 'A safe day of sending is the sum of what each mailbox can safely send. We will not ship a feature that pushes a mailbox past its own limits to make a chart look better.' },
      { t: 'Act before the providers do', b: 'Our thresholds for the shared warmup pool are stricter than the points where Google or Amazon SES start penalising a sender. By the time a provider would act, the mailbox has already been slowed down.' },
    ],
  },
  {
    scene: 'cipher',
    label: 'Nothing hidden from you',
    items: [
      { t: 'Encrypted by design', b: 'Mailbox credentials are encrypted with a dedicated credentials key, and message content with a data key that belongs to your workspace alone.' },
      { t: 'No black boxes', b: 'Every health state, suppression and pool block comes with a reason you can read in the dashboard, and the rules behind them are documented.' },
    ],
  },
];

const planes = [
  { t: 'The control plane decides', b: 'The backend and consumer hold your data, decide which mailbox sends what and when, and assign each mailbox to a worker.' },
  { t: 'The bus carries the work', b: 'Commands go out on a topic per worker and results come back on one shared stream, over NATS or Kafka.' },
  { t: 'Workers send and sync', b: 'They sign in to your mailboxes, send, sync and report back. They hold no database connection, so one that goes away is simply replaced.' },
];

const compare = [
  ['Source code', 'Apache 2.0 on GitHub. Read it, fork it, run it.', 'Closed. You see the dashboard, not the engine.'],
  ['Where it runs', 'Our cloud, or your own servers with one command.', 'Their cloud only.'],
  ['Health rules', 'Documented, and stricter than provider enforcement.', 'Undocumented until something goes wrong.'],
  ['Changelog', 'Public and dated, one entry per merged change.', 'Announcements on a marketing schedule.'],
  ['Pricing', 'Per workspace, with unlimited mailboxes and warmup.', 'Often per mailbox or per seat.'],
];

const repo = [
  ['cmd/backend', 'The API and the business logic. Owns the database.'],
  ['cmd/consumer', 'Folds results from the workers back into the platform.'],
  ['cmd/worker', 'Sends and syncs mail. Holds no database connection.'],
  ['cmd/cli', 'The warmbly command-line tool.'],
  ['tracking/', 'The open and click tracking service, in Rust.'],
  ['realtime/', 'The live websocket layer for the dashboard, in Elixir.'],
  ['web/', 'The dashboard.'],
  ['site/', 'This website.'],
  ['docs/', 'The documentation at docs.warmbly.com.'],
];
let n = 0;
---
<Layout
  title="About Warmbly: The Open-Source Cold Email Platform"
  description="Warmbly is an open-source email warmup and cold outreach platform under Apache 2.0. Why it exists, the principles it is built on, and how the platform is put together."
>
  <!-- HERO: the statement, then the repository and the dashboard it builds. -->
  <section class="container-page pt-14 md:pt-24">
    <div class="text-[14px] text-slate-500">About</div>
    <h1 class="mt-5 max-w-5xl text-[40px] sm:text-[56px] md:text-[76px] font-medium tracking-[-0.05em] leading-[1.0] text-slate-900">
      Cold email you can read, run and trust.
    </h1>
    <div class="mt-8 md:mt-10 grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
      <p class="max-w-2xl text-[18px] md:text-[21px] leading-[1.5] text-slate-500">
        Warmbly is the open-source platform for email warmup and cold outreach. Everything that decides whether your email lands in the inbox is in a public repository, and you can run all of it yourself.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="https://github.com/warmbly/warmbly" target="_blank" rel="noopener noreferrer" class="inline-flex h-11 items-center gap-2 rounded-full bg-slate-900 px-5 text-[15px] font-medium text-white transition-colors hover:bg-slate-800">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={GITHUB_PATH} /></svg>
          Read the code
        </a>
        <a href="#story" class="inline-flex h-11 items-center rounded-full border border-slate-200 px-5 text-[15px] text-slate-800 transition-colors hover:border-slate-300 hover:bg-slate-50">Read the story</a>
      </div>
    </div>
  </section>
  <div class="container-page mt-12 md:mt-16">
    <RepoScene />
  </div>

  <!-- STORY: the essay, with the pull quote and what it means in the product beside it. -->
  <section id="story" class="container-page scroll-mt-24 py-20 md:py-28">
    <div class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.92fr)] lg:gap-20">
      <div class="max-w-[640px]">
        <h2 class="text-[30px] md:text-[40px] font-medium tracking-[-0.04em] leading-[1.1] text-slate-900">Why Warmbly exists</h2>
        <div class="mt-8 space-y-6 text-[18px] leading-[1.75] text-slate-600">
          <p>For years the main tools for cold email have charged by the mailbox while keeping their warmup logic, sending rules and abuse thresholds closed. You paid for volume. You never got to see how decisions about your reputation were made.</p>
          <p>We started Warmbly to take that away. The workers that send your mail, the warmup pools, the encryption and the health rules all live in a public repository under Apache 2.0.</p>
          <p>So when Warmbly slows a mailbox down, the dashboard says why in a full sentence, and the sentence is written by code you can open. The figure beside this is a real one: the reason a throttled mailbox shows, and the lines of <code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-[15px] text-slate-800">service.go</code> that wrote it.</p>
          <p>Founders, agencies, sales teams, recruiters and fundraisers can read the engine, run it on their own servers if they want, and stop paying a tax on every mailbox they add.</p>
          <p>We are a small team building in public. We say what we are working on, we don’t invent numbers, and the product gets better where everyone can see it.</p>
        </div>
      </div>
      <figure class="lg:sticky lg:top-24 lg:self-start">
        <blockquote class="border-l-2 border-slate-900 pl-6 text-[22px] md:text-[24px] leading-[1.45] font-medium tracking-[-0.015em] text-slate-900">
          When deliverability breaks on a closed platform, you can’t read the code that broke it. You can only write to support and wait.
        </blockquote>
        <div class="mt-8"><StoryScene /></div>
        <figcaption class="mt-3 text-[13.5px] text-slate-400">A mailbox slowed for spam placement, and the rule that slowed it.</figcaption>
      </figure>
    </div>
  </section>

  <!-- PRINCIPLES: six rules in three pairs, each pair beside its proof. -->
  <Rule />
  <section class="container-page py-20 md:py-28">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-20">
      <h2 class="text-[30px] md:text-[44px] font-medium tracking-[-0.04em] leading-[1.08]"><span class="text-slate-400">What we believe.</span> <span class="text-slate-900">Six rules the code is held to.</span></h2>
      <p class="max-w-xl text-[16px] md:text-[18px] leading-[1.6] text-slate-500">These aren’t values for a slide. They are written into the codebase, and a feature that breaks one doesn’t ship. Each pair below sits next to the code or the record that proves it.</p>
    </div>
    <div class="mt-12 md:mt-16 grid gap-x-3 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
      {groups.map((g, gi) => (
        <article class={gi === 2 ? 'md:col-span-2 lg:col-span-1' : ''}>
          {g.scene === 'merged' && <MergedScene entries={entries} />}
          {g.scene === 'limits' && <LimitsScene />}
          {g.scene === 'cipher' && <CipherScene />}
          <div class="mt-6 text-[13px] text-slate-400">{g.label}</div>
          <ol class="mt-3 space-y-6">
            {g.items.map((p) => (
              <li class="grid grid-cols-[36px_1fr] gap-1">
                <span class="font-mono text-[13px] leading-[28px] text-slate-400">{String(++n).padStart(2, '0')}</span>
                <div>
                  <h3 class="text-[19px] font-medium tracking-[-0.02em] text-slate-900">{p.t}</h3>
                  <p class="mt-1.5 text-[15.5px] leading-[1.6] text-slate-500">{p.b}</p>
                </div>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <!-- SHAPE: the whole instance, drawn as it runs. -->
  <Rule />
  <section class="container-page py-20 md:py-28">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-20">
      <h2 class="text-[30px] md:text-[44px] font-medium tracking-[-0.04em] leading-[1.08]"><span class="text-slate-400">How it’s built.</span> <span class="text-slate-900">One part decides, the other part sends.</span></h2>
      <p class="max-w-xl text-[16px] md:text-[18px] leading-[1.6] text-slate-500">Adding capacity means adding small workers, not growing one giant server. Your mailbox provider delivers the mail, so a worker is only where your mailbox signs in from, and Warmbly keeps that stable.</p>
    </div>
    <div class="mt-12 md:mt-16"><ArchitectureScene /></div>
    <div class="mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
      {planes.map((p) => (
        <div>
          <h3 class="text-[18px] font-medium tracking-[-0.02em] text-slate-900">{p.t}</h3>
          <p class="mt-2 text-[15.5px] leading-[1.6] text-slate-500">{p.b}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- COMPARE + REPO: what is different, and where to look. -->
  <Rule />
  <section class="container-page py-20 md:py-28">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-14">
      <div>
        <SectionIntro lead="What’s different." title="An open engine, in a category of closed ones." />
        <div class="mt-10 overflow-x-auto rounded-[6px] bg-white ring-1 ring-slate-200">
          <table class="w-full min-w-[560px] text-left text-[14.5px]">
            <thead>
              <tr class="border-b border-slate-200 text-[13px]">
                <th class="w-[24%] px-5 py-3.5 font-normal text-slate-400"></th>
                <th class="px-5 py-3.5 font-medium text-slate-900">
                  <span class="inline-flex items-center gap-2"><svg viewBox="0 0 746 764" class="w-4 text-slate-900" fill="currentColor" aria-hidden="true"><path d="M222.805 644.772L186.274 108.881L704.5 451.158L484.5 451.158L245.5 196.158L444 463.5L222.805 644.772Z"/></svg>Warmbly</span>
                </th>
                <th class="px-5 py-3.5 font-normal text-slate-400">Closed-source tools</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {compare.map(([k, a, b]) => (
                <tr>
                  <td class="px-5 py-4 align-top text-slate-500">{k}</td>
                  <td class="px-5 py-4 align-top text-slate-900"><span class="flex gap-2"><Icon name="check" size={15} class="mt-[3px] shrink-0 text-emerald-600" />{a}</span></td>
                  <td class="px-5 py-4 align-top text-slate-500">{b}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-[13.5px] text-slate-400">This describes how Warmbly is built. We don’t speak for any other company’s plans or pricing.</p>
      </div>

      <div>
        <SectionIntro lead="The repository." title="What you’ll find when you open it." />
        <div class="mt-10 overflow-hidden rounded-[10px] bg-[#0b1020] ring-1 ring-slate-900/20">
          <div class="flex items-center gap-2 border-b border-white/10 px-5 py-3 font-mono text-[12.5px] text-white/60">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={GITHUB_PATH} /></svg>
            warmbly/warmbly
            <span class="ml-auto text-white/40">main</span>
          </div>
          <ul class="divide-y divide-white/5">
            {repo.map(([path, d]) => (
              <li class="grid grid-cols-[124px_1fr] gap-4 px-5 py-3 text-[13.5px] sm:grid-cols-[140px_1fr]">
                <span class="font-mono text-sky-300">{path}</span>
                <span class="text-white/60">{d}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="mt-6 flex flex-wrap gap-x-7 gap-y-3 text-[15px]">
          <a href="https://docs.warmbly.com" class="inline-flex items-center gap-1.5 font-medium text-slate-900 hover:text-slate-600">Documentation <Icon name="arrowUpRight" size={13} /></a>
          <a href="/changelog/" class="inline-flex items-center gap-1.5 font-medium text-slate-900 hover:text-slate-600">Changelog <Icon name="arrowRight" size={13} /></a>
          <a href="/trust/" class="inline-flex items-center gap-1.5 font-medium text-slate-900 hover:text-slate-600">Security and trust <Icon name="arrowRight" size={13} /></a>
          <a href="https://dc.warmbly.com" class="inline-flex items-center gap-1.5 font-medium text-slate-900 hover:text-slate-600">Discord <Icon name="arrowUpRight" size={13} /></a>
        </div>
      </div>
    </div>
  </section>

  <CTA photo="sheer-sky" title="Read it, run it, or let us run it." description="Start free on Warmbly Cloud, or install the whole platform on your own server with one command." secondaryLabel="Self-host it" secondaryHref="https://github.com/warmbly/warmbly" />
</Layout>
