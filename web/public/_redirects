# Client-side routing on a static host. Without this, every route below the
# root 404s on a refresh or a shared link: the file genuinely does not exist,
# and only the app knows the route. nginx does the same thing with try_files.
#
# 200, not 301: the URL has to stay what the user asked for, or the router
# lands on the wrong route. Pages only serves index.html through "/"; with a
# 404.html present a rewrite to /index.html is not followed and every route 404s.
/auth  /  200
/auth/*  /  200
/app  /  200
/app/*  /  200
/onboarding  /  200
/onboarding/*  /  200
/oauth  /  200
/oauth/*  /  200
/select-org  /  200
/invite  /  200
/connect  /  200
/cli  /  200
/cloud-oauth/done  /  200
/oauth-return  /  200
/reauth/complete  /  200
/portal/sign-in  /  200
/portal/return  /  200
/slack/link  /  200
/setup  /  200
